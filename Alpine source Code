    function filterPostsByProfileTab(list, tab, authorName, authorUsername) {
      const meName = authorName || (profile && profile.name) || '';
      const meUser = String(authorUsername || (profile && profile.username) || '').replace(/^@/, '').toLowerCase();
      const isAuthor = (p) => {
        const u = String(p.authorUsername || p.authorId || '').replace(/^@/, '').toLowerCase();
        return (meName && p.authorName === meName) || (meUser && u === meUser);
      };
      const hasMedia = (p) => !!(p.image || (p.images && p.images.length) || p.video);
      const isRepost = (p) => !!(p.repostedFrom || p.isRepost || p.reposted);
      const isReply = (p) => !!(p.replyTo || p.isReply || p.parentId);
      const authorCommented = (p) => Array.isArray(p.comments) && p.comments.some(c => {
        const u = String(c.authorUsername || '').replace(/^@/, '').toLowerCase();
        return (meName && c.authorName === meName) || (meUser && u === meUser);
      });
      tab = tab || 'threads';
      if (tab === 'replies') {
        // Posts that are replies by author OR posts where author left a comment
        return list.filter(p => (isAuthor(p) && isReply(p)) || authorCommented(p));
      }
      if (tab === 'media') return list.filter(p => isAuthor(p) && hasMedia(p));
      if (tab === 'reposts') return list.filter(p => isAuthor(p) && isRepost(p));
      // threads = own original posts (not pure replies-only; include posts by author)
      return list.filter(p => isAuthor(p) && !isRepost(p));
    }

