  }

  // ---------- Network indicator ----------
  function networkLabel() {
    const conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    if (!navigator.onLine) return { text: '', cls: 'offline', bars: 0, title: 'Offline' };
    if (!conn) return { text: '', cls: 'good', bars: 3, title: 'Online' };
    const type = (conn.effectiveType || '').toLowerCase();
    const downlink = conn.downlink;
    let gen = 'Online';
    let bars = 3;
    let cls = 'good';
    if (type === 'slow-2g' || type === '2g') { gen = '2G'; bars = 1; cls = 'bad'; }
    else if (type === '3g') { gen = '3G'; bars = 2; cls = 'ok'; }
    else if (type === '4g') {
      if (typeof downlink === 'number' && downlink >= 50) { gen = '5G'; bars = 4; cls = 'good'; }
      else { gen = '4G'; bars = 3; cls = 'good'; }
    } else if (type) {
      gen = type.toUpperCase();
      bars = 2;
      cls = 'ok';
    }
    if (typeof downlink === 'number' && downlink > 0) {
      // refine bars by speed when type missing/generic
      if (!type) {
        if (downlink < 1) { bars = 1; cls = 'bad'; }
        else if (downlink < 5) { bars = 2; cls = 'ok'; }
        else if (downlink < 50) { bars = 3; cls = 'good'; }
        else { bars = 4; cls = 'good'; }
      }
    }
    let meta = gen;
    if (typeof downlink === 'number' && downlink > 0) {
      meta = gen + ' · ' + (downlink >= 10 ? downlink.toFixed(0) : downlink.toFixed(1)) + 'M';
    }
    return { text: meta, cls, bars, title: meta };
  }
  function updateNetIndicator() {
    const el = document.getElementById('netIndicator');
    const lab = document.getElementById('netIndicatorLabel');
    if (!el) return;
    const info = networkLabel();
    el.classList.remove('good', 'ok', 'bad', 'offline');
    el.classList.add(info.cls);
    const bars = el.querySelectorAll('.net-bar');
    bars.forEach((bar, i) => {
      bar.classList.toggle('on', i < (info.bars || 0));
    });
    if (lab) lab.textContent = info.text || '';
    el.title = info.title || 'Network';
    const wrap = el.closest('.net-indicator-wrap');
    if (wrap) wrap.title = info.title || 'Network';
  }

  // ---------- Swiss encryption banner in settings if missing ----------
  function ensureSwissCryptoNote() { /* privacy cards removed from settings UI */ }

  function boot() {
    try { patchRenderGlobalWall(); } catch (_) {}
    try { patchOfflinePublish(); } catch (_) {}
    try { patch2FA(); } catch (_) {}
    try { patchVaultCrypto(); } catch (_) {}
    try { patchSaveLoadIDB(); } catch (_) {}
    try { updateNetIndicator(); } catch (_) {}
    try { ensureSwissCryptoNote(); } catch (_) {}
    try { flushQueue(); } catch (_) {}
    window.addEventListener('online', () => { updateNetIndicator(); flushQueue(); });
    window.addEventListener('offline', updateNetIndicator);
    const conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    if (conn && conn.addEventListener) conn.addEventListener('change', updateNetIndicator);
    setInterval(updateNetIndicator, 15000);
    // late patches after app init
    setTimeout(() => {
      try { patchRenderGlobalWall(); patch2FA(); patchVaultCrypto(); patchSaveLoadIDB(); patchOfflinePublish(); updateNetIndicator(); } catch (_) {}
    }, 2000);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>


