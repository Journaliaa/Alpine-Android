    // Show in personal chats (not service/bookmarks/notes)
    const ok = chat && chat.type !== 'service' && chat.type !== 'bookmarks' && chat.type !== 'notes' && chat.id !== 'service_nivada';
    el.classList.toggle('show', !!ok);
  }

  function bind() {
    document.getElementById('e2eBannerClose')?.addEventListener('click', e => {
      e.preventDefault();
      e.stopPropagation();
      hideForever();
    });
    if (typeof openChat === 'function' && !openChat.__e2eHook) {
      const orig = openChat;
      const wrapped = function () {
        const r = orig.apply(this, arguments);
        setTimeout(updateE2EBanner, 20);
        setTimeout(updateE2EBanner, 100);
        return r;
      };
      wrapped.__e2eHook = true;
      try { openChat = wrapped; window.openChat = wrapped; } catch (_) {}
    }
    updateE2EBanner();
  }
  window.updateE2EBanner = updateE2EBanner;
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
  else bind();
  setTimeout(bind, 500);
  setTimeout(bind, 1500);
})();
