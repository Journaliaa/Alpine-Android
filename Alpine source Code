    // ==================== WALL / POSTS ====================
    function formatPostTime(ts) {
      const d = new Date(ts);
      const now = new Date();
      const diff = now - d;
      if (diff < 60000) return 'now';
      if (diff < 3600000) return Math.floor(diff / 60000) + 'm';
      if (diff < 86400000) return Math.floor(diff / 3600000) + 'h';
      if (diff < 86400000 * 7) return Math.floor(diff / 86400000) + 'd';
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
    }
    function createPost(text, imageData, quoteOf, mediaExtra) {
      if (ghostMode) { toast('Ghost mode: read-only'); return null; }
      let t = (text || '').trim();
      if (t.length > 500) t = t.slice(0, 500);
      const images = [];
      let video = '';
      if (mediaExtra && Array.isArray(mediaExtra.images)) {
        mediaExtra.images.slice(0, 5).forEach(x => { if (x) images.push(x); });
      }
      if (mediaExtra && mediaExtra.video) video = mediaExtra.video;
      if (imageData && !images.length) images.push(imageData);
      if (!t && !images.length && !video && !quoteOf) { toast('Write something or add a photo/video'); return null; }
      const post = {
        id: postIdCounter++,
        authorId: (currentUser && currentUser.username) || profile.username || 'local',
        authorName: profile.name || 'You',
        authorUsername: (profile.username || (currentUser && currentUser.username) || 'user').replace(/^@/, ''),
        authorColor: profile.color || '#DA291C',
        authorPhoto: profile.photo || '',
        text: t,
        image: images[0] || '',
        images: images,
        video: video || '',
        time: Date.now(),
        likes: 0,
        liked: false,
        reposts: 0,
        reposted: false,
        bookmarked: false,
        bookmarks: 0,
        comments: [],
        quoteOf: quoteOf || null,
        visibility: (mediaExtra && mediaExtra.visibility) || (typeof window !== 'undefined' && window._postVisibility) || 'everyone',
        circleOnly: false
      };
      if (post.visibility === 'circle') post.circleOnly = true;
      posts.unshift(post);
      try { cloudPublishPost(post); } catch (e) {}
      saveData();
      return post;
    }
    function renderPostMediaHtml(p) {
      if (p.video) {
        return `<video class="wall-short-video" src="${p.video}" controls playsinline preload="metadata"></video>`;
      }
      const imgs = (Array.isArray(p.images) && p.images.length) ? p.images.slice(0, 5) : (p.image ? [p.image] : []);
      if (!imgs.length) return '';
      if (imgs.length === 1) {
        return `<img class="wall-post-image" src="${imgs[0]}" alt="">`;
      }
      const cls = 'c' + Math.min(5, imgs.length);
      return `<div class="wall-collage ${cls}">` + imgs.map(src =>
        `<div class="wall-collage-item"><img src="${src}" alt=""></div>`
      ).join('') + `</div>`;
    }
    function renderCommentsHtml(p) {
      if (!p.comments) p.comments = [];
      const byId = {};
      p.comments.forEach(c => { byId[c.id] = c; });
      const childrenOf = (pid) => p.comments
        .filter(c => c.replyTo != null && String(c.replyTo) === String(pid))
        .sort((a, b) => (a.time || 0) - (b.time || 0));
      const renderTree = (c, depth) => {
        const avStyle = c.authorPhoto
          ? `background:url(${c.authorPhoto}) center/cover no-repeat`
          : `background:${c.authorColor || '#006a6a'}`;
        const avText = c.authorPhoto ? '' : escapeHtml(initials(c.authorName || 'Я'));
        const parent = c.replyTo ? byId[c.replyTo] : null;
        const replyLabel = parent
          ? `<div class="wall-comment-reply-to">↪ ${escapeHtml(parent.authorName || '')}</div>`
          : '';
        const likes = c.likes || 0;
        const canDel = (c.authorName === (profile.name || 'Мой профиль')) ||
          (p.authorName === (profile.name || 'Мой профиль'));
        const pad = Math.min(depth, 5) * 16;
        let h = `<div class="wall-comment${depth ? ' reply nested' : ''}" data-comment-id="${c.id}" style="${depth ? 'margin-left:' + pad + 'px' : ''}">
          <div class="wall-comment-av" style="${avStyle}">${avText}</div>
          <div class="wall-comment-body">
            <strong>${escapeHtml(c.authorName || 'Аноним')}</strong>
            <small>${formatPostTime(c.time)}</small>
            ${replyLabel}
            <div class="wall-comment-text">${escapeHtml(c.text)}</div>
            <div class="wall-comment-actions">
              <button type="button" class="${c.liked ? 'liked' : ''}" data-like-comment="${c.id}" data-post-id="${p.id}">${c.liked ? '❤ Нравится' : '♡ Нравится'}${likes ? ' · ' + likes : ''}</button>
              <button type="button" data-reply-comment="${c.id}" data-post-id="${p.id}" data-reply-name="${escapeHtml(c.authorName || '')}">Ответить</button>
            </div>
          </div>
          ${canDel ? `<button type="button" class="wall-comment-delete" data-delete-comment="${c.id}" data-post-id="${p.id}" title="Удалить">
            <span class="material-icons-round" style="font-size:16px">close</span>
          </button>` : ''}
        </div>`;
        childrenOf(c.id).forEach(ch => { h += renderTree(ch, depth + 1); });
        return h;
      };
      let list = '';
      if (!p.comments.length) {
        list = '<div style="font-size:12.5px;color:#818c99;padding:4px 0 8px">Нет комментариев</div>';
      } else {
        const tops = p.comments.filter(c => !c.replyTo || !byId[c.replyTo])
          .sort((a, b) => (a.time || 0) - (b.time || 0));
        tops.forEach(c => { list += renderTree(c, 0); });
      }
      return `<div class="wall-comments" data-comments-for="${p.id}">
        ${list}
        <div class="wall-comment-form" data-comment-form="${p.id}">
          <div class="reply-hint" data-reply-hint="${p.id}"></div>
          <input type="text" placeholder="Напишите комментарий..." maxlength="300" data-comment-input="${p.id}">
          <button type="button" data-send-comment="${p.id}">Отправить</button>
          <button type="button" data-cancel-reply="${p.id}" style="display:none;font-size:12px;border:none;background:transparent;color:#818c99;cursor:pointer">Отмена</button>
        </div>
      </div>`;
    }

    function renderPostHtml(p) {
