        if (typeof ghostMode !== 'undefined' && ghostMode) { toast('Ghost mode: read-only'); return; }
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
          toast('Camera is not supported in this browser');
          return;
        }
        wallMediaTarget = target === 'profile' ? 'profile' : 'global';
        try { closeWallMediaSheet(); } catch (_) {}
        const ov = document.getElementById('wallCameraOverlay');
        const err = document.getElementById('wallCameraError');
        const video = document.getElementById('wallCameraVideo');
        const frame = document.getElementById('wallCameraFrame');
        if (!ov || !video) return;

        // Full cleanup before reopen (prevents freeze)
        try {
          video.pause();
          video.srcObject = null;
        } catch (_) {}
        try {
          const old = wallCameraStream || window.wallCameraStream;
          if (old) old.getTracks().forEach(t => { try { t.stop(); } catch (_) {} });
        } catch (_) {}
        wallCameraStream = null;
        window.wallCameraStream = null;
        await new Promise(r => setTimeout(r, 120));

        ov.classList.add('show');
        ov.setAttribute('aria-hidden', 'false');
        if (err) err.classList.remove('show');

        if (typeof wallCameraFacing === 'undefined' || !wallCameraFacing) {
          wallCameraFacing = 'user';
        }

        wallCameraStream = await requestWallCameraStream(wallCameraFacing);
        window.wallCameraStream = wallCameraStream;
        video.setAttribute('playsinline', 'true');
        video.muted = true;
        video.srcObject = wallCameraStream;
        try {
          await wallCamWithTimeout(video.play(), 5000);
        } catch (_) {
          // autoplay quirks — still show frame
        }
        wallCameraActive = true;
        if (frame) frame.classList.toggle('mirror', wallCameraFacing === 'user');
        if (err) err.classList.remove('show');
      } catch (e) {
        console.warn('camera', e);
        const err = document.getElementById('wallCameraError');
        if (err) err.classList.add('show');
        toast((e && e.message === 'camera timeout') ? 'Camera timed out — try again' : 'Cannot access camera');
        try { await stopWallCamera(); } catch (_) {}
      } finally {
        window.__wallCamBusy = false;
      }
    }

    async function flipWallCamera() {
      if (window.__wallCamBusy) return;
      window.__wallCamBusy = true;
      const video = document.getElementById('wallCameraVideo');
      const frame = document.getElementById('wallCameraFrame');
      const err = document.getElementById('wallCameraError');
      try {
        wallCameraFacing = wallCameraFacing === 'user' ? 'environment' : 'user';
        try {
          if (video) { video.pause(); video.srcObject = null; }
        } catch (_) {}
        try {
          const old = wallCameraStream || window.wallCameraStream;
          if (old) old.getTracks().forEach(t => { try { t.stop(); } catch (_) {} });
        } catch (_) {}
        wallCameraStream = null;
        window.wallCameraStream = null;
        await new Promise(r => setTimeout(r, 150));

        wallCameraStream = await requestWallCameraStream(wallCameraFacing);
        window.wallCameraStream = wallCameraStream;
        if (video) {
          video.srcObject = wallCameraStream;
