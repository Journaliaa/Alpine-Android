</script>


<script>
/* Guarantee chat header actions: call, search, more */
(function () {
  function ensureHeaderActions() {
    const header = document.getElementById('chatHeader');
    if (!header) return;
    const more = document.getElementById('moreBtn');
    const search = document.getElementById('searchInChatBtn');

    function makeBtn(id, icon, title) {
      let b = document.getElementById(id);
      if (b) return b;
      b = document.createElement('button');
      b.type = 'button';
      b.id = id;
      b.className = 'icon-btn';
      b.title = title;
      b.innerHTML = '<span class="material-icons-round">' + icon + '</span>';
      return b;
    }
    let voice = makeBtn('voiceCallBtn', 'call', 'Голосовой звонок');
    let searchBtn = search || makeBtn('searchInChatBtn', 'search', 'Поиск в чате');
    let moreBtn = more || makeBtn('moreBtn', 'more_vert', 'Ещё');

    // Order: back, avatar, info, voice, search, more
    const info = header.querySelector('.chat-header-info');
    // Append in order if not in place
    [voice, searchBtn, moreBtn].forEach(b => {
      if (!b.parentElement || b.parentElement !== header) {
        header.appendChild(b);
      }
    });
    // Reorder: move voice before search before more
    if (moreBtn.parentElement === header) {
      header.appendChild(voice);
      header.appendChild(searchBtn);
      header.appendChild(moreBtn);
    }

    // Bind call
    if (!voice.__boundV2) {
      voice.__boundV2 = true;
      voice.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        try {
          if (typeof window.startCall === 'function') window.startCall('voice');
          else if (typeof startCall === 'function') startCall('voice');
          else toast('Звонок недоступен');
        } catch (err) { console.error(err); toast('Ошибка звонка'); }
      }, true);
    }
    if (moreBtn && !moreBtn.__boundV2) {
      moreBtn.__boundV2 = true;
      moreBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const chat = (chats || []).find(c => String(c.id) === String(activeChatId));
        if (!chat) return;
        if (typeof showChatCtx === 'function') {
          const r = moreBtn.getBoundingClientRect();
          showChatCtx({ clientX: Math.min(r.left, window.innerWidth - 220), clientY: r.bottom + 6 }, chat.id);
        } else if (typeof showInfo === 'function') showInfo();
      }, true);
    }
  }

  function boot() {
    ensureHeaderActions();
    try {
      if (typeof updateE2EBanner === 'function') updateE2EBanner();
      else {
        const b = document.getElementById('e2eBanner');
        if (b && activeChatId != null) b.classList.add('show');
      }
    } catch (_) {}
  }
  document.addEventListener('DOMContentLoaded', boot);
  setInterval(boot, 2000);
  setTimeout(boot, 200);
  setTimeout(boot, 800);

  // Hook openChat
  function hook() {
    if (typeof openChat !== 'function' || openChat.__hdrAct) return;
    const o = openChat;
    openChat = function () {
      const r = o.apply(this, arguments);
      setTimeout(boot, 20);
      setTimeout(boot, 100);
      return r;
    };
    openChat.__hdrAct = true;
    window.openChat = openChat;
  }
  hook();
  setTimeout(hook, 500);
})();
</script>


<script>
/* Special chats: no call / profile / block; desktop header sync */
(function () {
  function isSpecialChat(chat) {
    if (!chat) return true;
    const id = String(chat.id || '');
    const t = String(chat.type || '');
    if (t === 'service' || t === 'bookmarks' || t === 'notes') return true;
    if (id === 'service_nivada' || id === 'bookmarks_saved' || id === 'notes_self') return true;
    if (chat.name === 'Alpine Service' || chat.name === 'Избранное' || chat.name === 'Заметки себе') return true;
    return false;
  }
  function syncSpecialHeader() {
    try {
      const chat = (chats || []).find(c => String(c.id) === String(activeChatId));
      const ac = document.getElementById('activeChat');
      if (ac) ac.setAttribute('data-special', isSpecialChat(chat) ? '1' : '0');
      const special = isSpecialChat(chat);
      ['voiceCallBtn', 'searchInChatBtn', 'moreBtn'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.display = special ? 'none' : '';
      });
      const e2e = document.getElementById('e2eBanner');
      if (e2e && special) e2e.classList.remove('show');
    } catch (_) {}
  }
  function guardStartCall() {
    if (typeof startCall !== 'function' || startCall.__specialGuard) return;
    const orig = startCall;
    const wrapped = function (type) {
      try {
        const chat = (chats || []).find(c => String(c.id) === String(activeChatId));
        if (isSpecialChat(chat)) {
          if (typeof toast === 'function') toast('Звонок недоступен в служебном чате');
          return;
        }
      } catch (_) {}
      return orig.apply(this, arguments);
    };
    wrapped.__specialGuard = true;
    try { startCall = wrapped; window.startCall = wrapped; } catch (_) {}
  }
  function hookOpen() {
    if (typeof openChat === 'function' && !openChat.__specialHdr) {
      const o = openChat;
      const w = function () {
        const r = o.apply(this, arguments);
        setTimeout(syncSpecialHeader, 30);
        setTimeout(syncSpecialHeader, 120);
        return r;
      };
      w.__specialHdr = true;
      // preserve alpineDm flag if any
      if (o.__alpineDm) w.__alpineDm = true;
      try { openChat = w; window.openChat = w; } catch (_) {}
    }
  }
  function boot() {
    guardStartCall();
    hookOpen();
    syncSpecialHeader();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(boot, 400);
  setTimeout(boot, 1500);
})();
</script>


<script>
/* Desktop chat open — reliable two-pane conversation */
(function () {
  function isMobile() {
    try { return window.matchMedia('(max-width: 900px)').matches; } catch (_) { return false; }
  }
  function forceDesktopChat(id) {
    const chat = (typeof chats !== 'undefined' ? chats : []).find(c => String(c.id) === String(id));
    if (!chat) return false;
    try { activeChatId = chat.id; window.activeChatId = chat.id; } catch (_) {}
    chat.unread = 0;
    if (!Array.isArray(chat.messages)) chat.messages = [];

    document.body.classList.add('chat-conversation-open');
    document.body.classList.remove('wall-mode');
    document.documentElement.classList.remove('wall-mode');
    document.querySelector('.app')?.classList.remove('wall-mode');
    ['wallPage','musicPage','communityPage','pluginsPage'].forEach(id => {
      document.getElementById(id)?.classList.remove('show');
    });

    const side = document.getElementById('sidebar');
    if (side) {
      side.classList.remove('hidden');
      side.style.cssText = 'display:flex!important;visibility:visible!important;opacity:1!important;transform:none!important;width:360px;min-width:300px;height:100%;position:relative;z-index:2;';
    }

    const es = document.getElementById('emptyState');
    if (es) es.style.cssText = 'display:none!important';

    const ac = document.getElementById('activeChat');
    if (ac) {
      ac.classList.add('is-chat-open');
      ac.style.cssText = 'display:flex!important;flex-direction:column!important;visibility:visible!important;opacity:1!important;height:100%!important;width:100%!important;min-height:0!important;background:var(--md-sys-color-surface,#f5f6f8)!important;z-index:3!important;';
    }

    const hn = document.getElementById('headerName');
    if (hn) hn.textContent = chat.name || 'Chat';
    const hs = document.getElementById('headerStatus');
    if (hs) {
      if (chat.type === 'service' || chat.id === 'service_nivada') hs.textContent = 'служебный чат';
      else if (chat.type === 'bookmarks' || chat.id === 'bookmarks_saved') hs.textContent = 'сохранённые';
      else if (chat.type === 'notes') hs.textContent = 'заметки';
      else hs.textContent = chat.online ? 'в сети' : (chat.lastSeen ? 'был(а) недавно' : '');
    }
    const av = document.getElementById('headerAvatar');
    if (av) {
      try {
        if (typeof setAvatarEl === 'function') setAvatarEl(av, chat.avatar || (chat.name||'?')[0], chat.color || '#888', chat.photo || '');
        else {
          av.textContent = chat.avatar || (chat.name || '?').slice(0, 1);
          av.style.background = chat.color || '#888';
        }
      } catch (_) {}
    }

    // Special: hide call/more
    const special = chat.type === 'service' || chat.type === 'bookmarks' || chat.type === 'notes'
      || chat.id === 'service_nivada' || chat.id === 'bookmarks_saved';
    ac && ac.setAttribute('data-special', special ? '1' : '0');
    ['voiceCallBtn','searchInChatBtn','moreBtn'].forEach(bid => {
      const el = document.getElementById(bid);
      if (el) el.style.display = special ? 'none' : '';
    });

    const msgs = document.getElementById('messages');
    if (msgs) {
      msgs.style.cssText = 'display:flex!important;flex-direction:column!important;flex:1!important;overflow-y:auto!important;min-height:120px!important;visibility:visible!important;padding:12px!important;';
      try {
        if (typeof renderMessages === 'function') renderMessages(chat);
        else if (typeof simpleRenderMessages === 'function') simpleRenderMessages(chat);
      } catch (e) { console.warn(e); }
      if (!msgs.innerHTML || msgs.innerHTML.trim().length < 5) {
        const list = chat.messages || [];
        if (!list.length) {
          msgs.innerHTML = '<div style="margin:auto;text-align:center;color:#8b98a5;padding:40px 16px">Нет сообщений<br><span style="font-size:13px">Напишите первое сообщение</span></div>';
        } else {
          msgs.innerHTML = list.map(m => {
            if (m.system) return '<div style="text-align:center;color:#8b98a5;font-size:12px;margin:8px 0">'+(m.text||'')+'</div>';
            const out = m.outgoing;
            return '<div style="display:flex;justify-content:'+(out?'flex-end':'flex-start')+';margin:4px 0"><div style="max-width:75%;padding:8px 12px;border-radius:14px;background:'+(out?'var(--md-sys-color-primary,#1a73e8)':'#e8eaed')+';color:'+(out?'#fff':'#111')+';font-size:15px">'+(m.text||'·')+'</div></div>';
          }).join('');
        }
      }
      try { msgs.scrollTop = msgs.scrollHeight; } catch (_) {}
    }

    const input = document.getElementById('messageInput');
    if (input) {
      try {
        const draft = (typeof drafts !== 'undefined' && drafts) ? (drafts[chat.id] || '') : '';
        input.value = draft || '';
      } catch (_) {}
    }

    try { if (typeof renderChatList === 'function') renderChatList(document.getElementById('searchInput')?.value || ''); } catch (_) {}
    try { if (typeof saveData === 'function') saveData(); } catch (_) {}
    return true;
  }

  function openChatDesktopSafe(id) {
    if (isMobile()) return false;
    // Call original chain first for full logic
    try {
      if (typeof window.__origOpenChatCore === 'function') {
        window.__origOpenChatCore(id);
      }
    } catch (e) { console.warn(e); }
    return forceDesktopChat(id);
  }

  // Capture list clicks on desktop
  function bind() {
    if (document.__deskChatBound) return;
    document.__deskChatBound = true;
    document.addEventListener('click', function (e) {
      if (isMobile()) return;
      const item = e.target.closest && e.target.closest('#chatList .chat-item, .chat-list .chat-item');
      if (!item) return;
      if (e.target.closest('#archiveOpenRow, #archiveBackRow, button, a, input')) return;
      const id = item.getAttribute('data-id');
      if (id == null || id === '') return;
      e.preventDefault();
      e.stopPropagation();
      // Try full openChat, then force paint
      try {
        if (typeof openChat === 'function') openChat(id);
      } catch (err) { console.warn(err); }
      setTimeout(() => forceDesktopChat(id), 20);
      setTimeout(() => forceDesktopChat(id), 100);
    }, true);
  }

  // Keep a reference to deepest original if possible
  function captureCore() {
    // no-op: forceDesktopChat is enough
  }

  bind();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
  setTimeout(bind, 500);

  window.__forceDesktopChat = forceDesktopChat;
})();
</script>


