<style id="m3-expressive-system">
/* ========== Material 3 Expressive system layer ========== */
:root {
  --m3-radius-xs: 8px;
  --m3-radius-sm: 12px;
  --m3-radius-md: 16px;
  --m3-radius-lg: 24px;
  --m3-radius-xl: 28px;
  --m3-radius-full: 9999px;
  --m3-ease: cubic-bezier(0.2, 0, 0, 1);
  --m3-spring: cubic-bezier(0.34, 1.2, 0.64, 1);
  --avatar-radius: 50%;
  --avatar-clip: none;
}
html[data-avatar-shape="circle"] { --avatar-radius: 50%; --avatar-clip: none; }
html[data-avatar-shape="squircle"] { --avatar-radius: 28%; --avatar-clip: none; }
html[data-avatar-shape="rounded"] { --avatar-radius: 18%; --avatar-clip: none; }
html[data-avatar-shape="diamond"] {
  --avatar-radius: 12%;
  --avatar-clip: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
}

body {
  font-family: 'Google Sans', 'Roboto', system-ui, -apple-system, sans-serif !important;
  letter-spacing: 0.01em;
}

/* Soft surfaces + expressive radii */
.sidebar, .tg-drawer, .side-panel, .wall-page, .chat-list-pane,
.music-page, .saved-page, .modal-card, .bottom-sheet-card,
.auth-card, .music-app, .md3-player {
