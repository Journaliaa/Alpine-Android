<script>
/* ===== Power features: migrate backup, offline queue, status, collab playlists, verify, safe country, M3 live ===== */
(function () {
  const QKEY = 'alpine_offline_queue_v1';
  const VKEY = 'alpine_device_verify_v1';
  const CKEY = 'alpine_collab_playlists_v1';
  const SKEY = 'alpine_safe_country_v1';

  function toast(msg) {
    try { if (typeof window.toast === 'function') window.toast(msg); else console.log(msg); } catch (_) {}
  }

  // ---------- Offline queue ----------
  function loadQueue() {
    try { return JSON.parse(localStorage.getItem(QKEY) || '[]'); } catch (_) { return []; }
  }
  function saveQueue(q) {
    try { localStorage.setItem(QKEY, JSON.stringify(q)); } catch (_) {}
    updateQueueUI(q);
  }
  function updateQueueUI(q) {
    q = q || loadQueue();
    const badge = document.getElementById('offlineQueueBadge');
    const st = document.getElementById('offlineQueueStatus');
    if (st) st.textContent = q.length ? ('Офлайн-очередь: ' + q.length + ' шт. · уйдёт при сети') : 'Офлайн-очередь: пусто';
    if (badge) {
      if (q.length) {
        badge.textContent = 'Офлайн: ' + q.length + ' — отправим при сети';
        badge.classList.add('show');
      } else badge.classList.remove('show');
    }
  }
  function enqueue(item) {
    const q = loadQueue();
    q.push(Object.assign({ id: 'q_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6), ts: Date.now() }, item));
    saveQueue(q);
    toast('Нет сети — в очереди, уйдёт позже');
  }
  function flushQueue() {
    if (!navigator.onLine) return;
    let q = loadQueue();
    if (!q.length) return;
    const left = [];
    q.forEach(item => {
      try {
        if (item.type === 'chat') {
          const chat = (chats || []).find(c => String(c.id) === String(item.chatId));
          if (!chat) return;
          if (!Array.isArray(chat.messages)) chat.messages = [];
          // avoid dup
          if (chat.messages.some(m => String(m.id) === String(item.msg && item.msg.id))) return;
          chat.messages.push(item.msg);
          if (String(activeChatId) === String(chat.id)) {
            try { if (typeof renderMessages === 'function') renderMessages(chat); } catch (_) {}
            try { if (typeof paintMsgs === 'function') paintMsgs(chat); } catch (_) {}
            try { if (window.alpineOpenDm) { /* refresh dm if open */ } } catch (_) {}
          }
        } else if (item.type === 'wall') {
          if (typeof posts !== 'undefined' && Array.isArray(posts) && item.post) {
            if (!posts.some(p => String(p.id) === String(item.post.id))) {
              posts.unshift(item.post);
            }
          }
        }
      } catch (e) {
        left.push(item);
      }
    });
    saveQueue(left);
    try { if (typeof saveData === 'function') saveData(); } catch (_) {}
    try { if (typeof renderChatList === 'function') renderChatList(); } catch (_) {}
    try { if (typeof renderGlobalWall === 'function') renderGlobalWall(); } catch (_) {}
    if (q.length && !left.length) toast('Офлайн-очередь отправлена');
  }
  window.addEventListener('online', flushQueue);
  window.__alpineEnqueue = enqueue;
  window.__alpineFlushQueue = flushQueue;

  // Hook sendMessage for offline
  function hookSend() {
    if (typeof sendMessage !== 'function' || sendMessage.__offlineHook) return;
    const orig = sendMessage;
    const wrapped = function () {
      if (!navigator.onLine) {
        const input = document.getElementById('messageInput') || document.getElementById('alpineDmInput');
        const text = (input && input.value || '').trim();
        if (!text || activeChatId == null) return;
        const chat = (chats || []).find(c => String(c.id) === String(activeChatId));
        if (!chat) return;
        const msg = {
          id: (typeof msgIdCounter !== 'undefined' ? (++msgIdCounter) : Date.now()),
          text,
          outgoing: true,
          time: Date.now(),
          reactions: [],
          read: false,
          pendingOffline: true
        };
        if (!Array.isArray(chat.messages)) chat.messages = [];
        chat.messages.push(msg);
        enqueue({ type: 'chat', chatId: chat.id, msg: Object.assign({}, msg) });
        if (input) input.value = '';
        try { if (typeof renderMessages === 'function') renderMessages(chat); } catch (_) {}
        try { if (typeof saveData === 'function') saveData(); } catch (_) {}
        return;
      }
      return orig.apply(this, arguments);
    };
    wrapped.__offlineHook = true;
    try { sendMessage = wrapped; window.sendMessage = wrapped; } catch (_) {}
  }

  // Hook DM send
  function hookDmSend() {
    if (typeof window.alpineOpenDm !== 'function') return;
    // patch send via event on alpineDmSend is hard; intercept online in sendDm if exposed
  }

  // ---------- Migrate backup (one button) ----------
  function buildMigratePack() {
    const pack = {
      v: 2,
      kind: 'alpine-migrate-e2e',
      exportedAt: new Date().toISOString(),
      app: 'Alpine',
      materialChat: null,
      appearance: null,
      offlineQueue: loadQueue(),
      collab: null,
      verifySalt: null
    };
    try { pack.materialChat = JSON.parse(localStorage.getItem('materialChat_v2') || 'null'); } catch (_) {}
    try { pack.appearance = JSON.parse(localStorage.getItem('alpine_m3_appearance_v1') || 'null'); } catch (_) {}
    try { pack.collab = JSON.parse(localStorage.getItem(CKEY) || 'null'); } catch (_) {}
    try { pack.community = JSON.parse(localStorage.getItem('alpine_community_links_v1') || 'null'); } catch (_) {}
    // lightweight "E2E": base64 + checksum (not crypto-grade without password; labeled local integrity)
    const raw = JSON.stringify(pack);
    let sum = 0;
    for (let i = 0; i < raw.length; i++) sum = (sum + raw.charCodeAt(i) * (i % 7 + 1)) % 1000003;
    pack.checksum = sum;
    return pack;
  }
  function downloadMigrate() {
    const pack = buildMigratePack();
    const blob = new Blob([JSON.stringify(pack, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'alpine-backup-' + new Date().toISOString().slice(0, 10) + '.json';
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    toast('Бэкап скачан — перенеси файл на новый телефон');
  }
  function importMigrateFile(file) {
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const pack = JSON.parse(reader.result);
        if (!pack || pack.kind !== 'alpine-migrate-e2e') {
          toast('Это не бэкап Alpine');
          return;
        }
        if (!confirm('Импорт заменит данные на этом устройстве. Продолжить?')) return;
        if (pack.materialChat) {
          localStorage.setItem('materialChat_v2', JSON.stringify(pack.materialChat));
        }
        if (pack.appearance) {
          localStorage.setItem('alpine_m3_appearance_v1', JSON.stringify(pack.appearance));
        }
        if (pack.collab) localStorage.setItem(CKEY, JSON.stringify(pack.collab));
        if (pack.community) localStorage.setItem('alpine_community_links_v1', JSON.stringify(pack.community));
        if (Array.isArray(pack.offlineQueue)) saveQueue(pack.offlineQueue);
        toast('Импорт готов — перезагрузка…');
        setTimeout(() => location.reload(), 600);
      } catch (e) {
        console.error(e);
        toast('Не удалось прочитать файл');
      }
    };
    reader.readAsText(file);
  }

  // ---------- Live status «сейчас…» ----------
  function computeLiveStatus() {
    try {
      if (typeof ghostMode !== 'undefined' && ghostMode) return { icon: 'visibility_off', text: 'режим призрака' };
      // music
      const audio = document.querySelector('audio#musicAudio, audio.music-audio, #playerAudio');
      const titleEl = document.getElementById('playerTitle') || document.querySelector('.player-title, #nowPlayingTitle');
      if (audio && !audio.paused && titleEl && titleEl.textContent && titleEl.textContent.trim()) {
        return { icon: 'music_note', text: 'слушает «' + titleEl.textContent.trim().slice(0, 40) + '»' };
      }
      if (window.__musicPlayingTitle) {
        return { icon: 'music_note', text: 'слушает «' + String(window.__musicPlayingTitle).slice(0, 40) + '»' };
      }
      if (activeChatId != null) {
        const chat = (chats || []).find(c => String(c.id) === String(activeChatId));
        if (chat && chat.name) return { icon: 'chat', text: 'в чате с ' + chat.name };
      }
      if (document.body.classList.contains('wall-mode')) return { icon: 'dynamic_feed', text: 'в ленте' };
      return { icon: 'circle', text: (typeof profile !== 'undefined' && profile.status) ? profile.status : 'в сети' };
    } catch (_) {
      return { icon: 'circle', text: 'в сети' };
    }
  }
  function paintLiveStatus() {
    const st = computeLiveStatus();
    const targets = [
      document.getElementById('drawerStatus'),
      document.getElementById('sidebarProfileStatus'),
      document.getElementById('settingsProfileStatus'),
      document.getElementById('profilePreviewStatus')
    ].filter(Boolean);
    targets.forEach(el => {
      el.innerHTML = '<span class="live-status-pill"><span class="material-icons-round mat">' + st.icon + '</span> ' +
        String(st.text).replace(/</g, '&lt;') + '</span>';
    });
    // also store for others
    try { window.__alpineLiveStatus = st; } catch (_) {}
  }

  // ---------- Collab playlists ----------
  function loadCollab() {
    try { return JSON.parse(localStorage.getItem(CKEY) || '{}'); } catch (_) { return {}; }
  }
  function saveCollab(o) {
    try { localStorage.setItem(CKEY, JSON.stringify(o)); } catch (_) {}
  }
  function createCollabPlaylist() {
    const code = Math.random().toString(36).slice(2, 8).toUpperCase();
    const name = prompt('Название совместного плейлиста', 'Shared mix') || 'Shared mix';
    const store = loadCollab();
    const tracks = (typeof musicTracks !== 'undefined' && Array.isArray(musicTracks)) ? musicTracks.slice(0, 30).map(t => ({
      id: t.id, title: t.title, artist: t.artist, url: t.url || t.src || ''
    })) : [];
    store[code] = { code, name, tracks, updated: Date.now(), host: (profile && profile.name) || 'me' };
    saveCollab(store);
    // also into musicPlaylists if exists
    try {
      if (typeof musicPlaylists !== 'undefined' && Array.isArray(musicPlaylists)) {
        musicPlaylists.push({ id: 'collab_' + code, name: name + ' · ' + code, trackIds: tracks.map(t => t.id), collabCode: code });
        if (typeof saveData === 'function') saveData();
        if (typeof renderMusic === 'function') renderMusic();
      }
    } catch (_) {}
    const input = document.getElementById('collabPlaylistCode');
    if (input) input.value = code;
    try { navigator.clipboard && navigator.clipboard.writeText(code); } catch (_) {}
    toast('Код плейлиста: ' + code + ' (скопирован)');
  }
  function joinCollabPlaylist() {
    const input = document.getElementById('collabPlaylistCode');
    const code = (input && input.value || '').trim().toUpperCase();
    if (!code) { toast('Введите код'); return; }
    const store = loadCollab();
    const pl = store[code];
    if (!pl) {
      // create empty join stub — user can share files later
      store[code] = { code, name: 'Joined ' + code, tracks: [], updated: Date.now(), host: 'remote' };
      saveCollab(store);
      toast('Плейлист ' + code + ' добавлен локально. Обменяйтесь бэкапом для треков.');
    } else {
      toast('Подключено: ' + (pl.name || code));
    }
    try {
      if (typeof musicPlaylists !== 'undefined' && Array.isArray(musicPlaylists)) {
        if (!musicPlaylists.some(p => p.collabCode === code)) {
          musicPlaylists.push({ id: 'collab_' + code, name: (pl && pl.name) || code, trackIds: (pl.tracks || []).map(t => t.id), collabCode: code });
          if (typeof saveData === 'function') saveData();
        }
      }
    } catch (_) {}
  }

  // ---------- Device verify code ----------
  function getOrCreateVerifySecret() {
    try {
      let s = localStorage.getItem(VKEY);
      if (!s) {
        s = String(Math.floor(100000 + Math.random() * 900000));
        localStorage.setItem(VKEY, s);
      }
      return s;
    } catch (_) { return '000000'; }
  }
  function showVerifyCode() {
    // rotating code based on secret + time window 2 min
    const secret = getOrCreateVerifySecret();
    const slot = Math.floor(Date.now() / 120000);
    let mix = 0;
    const base = secret + ':' + slot;
    for (let i = 0; i < base.length; i++) mix = (mix * 31 + base.charCodeAt(i)) % 1000000;
    const code = String(mix).padStart(6, '0');
    const el = document.getElementById('deviceVerifyCodeDisplay');
    if (el) el.textContent = code;
    try { navigator.clipboard && navigator.clipboard.writeText(code); } catch (_) {}
    toast('Код: ' + code + ' (≈2 мин)');
    return code;
  }
  function checkVerifyCode() {
    const entered = prompt('Введите 6-значный код с другого устройства');
    if (!entered) return;
    const ok = showVerifyCode() === String(entered).trim() ||
      (function () {
        const secret = getOrCreateVerifySecret();
        for (let d = 0; d <= 1; d++) {
          const slot = Math.floor(Date.now() / 120000) - d;
          let mix = 0;
          const base = secret + ':' + slot;
          for (let i = 0; i < base.length; i++) mix = (mix * 31 + base.charCodeAt(i)) % 1000000;
          if (String(mix).padStart(6, '0') === String(entered).trim()) return true;
        }
        return false;
      })();
    toast(ok ? 'Да, это вы ✓' : 'Код не совпал');
  }

  // ---------- Safe country mode ----------
  function setSafeCountry(on) {
    try { localStorage.setItem(SKEY, on ? '1' : '0'); } catch (_) {}
    document.body.classList.toggle('safe-country-on', !!on);
    const sw = document.getElementById('safeCountrySwitch');
    if (sw) {
      sw.classList.toggle('on', !!on);
      sw.setAttribute('aria-checked', on ? 'true' : 'false');
    }
    try {
      if (on) {
        // enable experimental + circumvention always
        if (typeof testNewFeatures !== 'undefined') testNewFeatures = true;
        if (typeof circumventionMode !== 'undefined') circumventionMode = 'always';
        if (typeof circumventionActive !== 'undefined') circumventionActive = true;
        if (typeof proxyEnabled !== 'undefined') proxyEnabled = true;
        try { if (typeof updateExperimentalUI === 'function') updateExperimentalUI(); } catch (_) {}
        try { if (typeof connectProxy === 'function') connectProxy(); } catch (_) {}
        try { if (typeof saveData === 'function') saveData(); } catch (_) {}
        toast('Безопасный режим страны включён');
      } else {
        if (typeof circumventionMode !== 'undefined') circumventionMode = 'off';
        if (typeof circumventionActive !== 'undefined') circumventionActive = false;
        try { if (typeof disconnectProxy === 'function') disconnectProxy(); } catch (_) {}
        try { if (typeof saveData === 'function') saveData(); } catch (_) {}
        toast('Безопасный режим выключен');
      }
    } catch (e) { console.warn(e); }
  }

  // ---------- Material You live flag ----------
  function enableM3Live() {
    document.documentElement.setAttribute('data-m3-live', '1');
    try {
      if (typeof window.__m3ApplyAppearance === 'function') window.__m3ApplyAppearance();
    } catch (_) {}
  }

  // ---------- Quote helper polish ----------
  function ensureQuoteOnPost() {
    // if quote draft exists, show chip on composer
    const draft = window._quoteDraft;
    let chip = document.getElementById('quoteDraftChip');
    const composer = document.getElementById('globalWallComposer');
    if (!composer) return;
    if (!draft) {
      if (chip) chip.remove();
      return;
    }
    if (!chip) {
      chip = document.createElement('div');
      chip.id = 'quoteDraftChip';
      chip.className = 'wall-quote-card';
      composer.insertBefore(chip, composer.firstChild.nextSibling);
    }
    chip.innerHTML = '<div class="wq-author">Цитата · ' + String(draft.authorName || '').replace(/</g,'&lt;') +
      ' <button type="button" id="quoteDraftClear" class="btn btn-text" style="float:right;min-height:28px">×</button></div>' +
      '<div class="wq-text">' + String(draft.text || '').slice(0, 180).replace(/</g,'&lt;') + '</div>';
    chip.querySelector('#quoteDraftClear')?.addEventListener('click', () => {
      window._quoteDraft = null;
      chip.remove();
    });
  }

  function bind() {
    document.getElementById('migrateExportBtn')?.addEventListener('click', downloadMigrate);
    document.getElementById('migrateImportBtn')?.addEventListener('click', () => document.getElementById('migrateImportFile')?.click());
    document.getElementById('migrateImportFile')?.addEventListener('change', e => {
      const f = e.target.files && e.target.files[0];
      if (f) importMigrateFile(f);
      e.target.value = '';
    });
    document.getElementById('deviceVerifyShowBtn')?.addEventListener('click', showVerifyCode);
    document.getElementById('deviceVerifyCheckBtn')?.addEventListener('click', checkVerifyCode);
    document.getElementById('safeCountrySwitch')?.addEventListener('click', function () {
      const on = !this.classList.contains('on');
      setSafeCountry(on);
    });
    document.getElementById('collabCreateBtn')?.addEventListener('click', createCollabPlaylist);
    document.getElementById('collabJoinBtn')?.addEventListener('click', joinCollabPlaylist);

    const safeOn = localStorage.getItem(SKEY) === '1';
    if (safeOn) setSafeCountry(true);

    hookSend();
    updateQueueUI();
    enableM3Live();
    paintLiveStatus();
    setInterval(paintLiveStatus, 4000);
    setInterval(ensureQuoteOnPost, 1500);
    if (navigator.onLine) setTimeout(flushQueue, 800);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
  else bind();
  setTimeout(bind, 600);
  setTimeout(hookSend, 1200);
})();
</script>


<script>
/* Hold-to-record voice + closed profile + M3 accents */
(function () {
  function toast(m) {
    try { if (typeof window.toast === 'function') window.toast(m); } catch (_) {}
  }

  // ---------- Profile public / closed ----------
  function isOwnProfilePublic() {
    try {
      if (typeof profile === 'undefined' || !profile) return true;
      if (profile.profilePublic === false) return false;
      return true;
    } catch (_) { return true; }
  }
  function setOwnProfilePublic(on) {
    try {
      if (typeof profile === 'undefined') return;
      profile.profilePublic = !!on;
      if (typeof saveData === 'function') saveData();
      paintOwnLock();
      try { if (typeof cloudPublishProfile === 'function') cloudPublishProfile(); } catch (_) {}
      toast(on ? 'Профиль открыт — стена и музыка видны' : 'Профиль закрыт — посты скрыты');
    } catch (e) { console.warn(e); }
  }
  function paintOwnLock() {
    const pub = isOwnProfilePublic();
    const sw = document.getElementById('profilePublicSwitch');
    if (sw) {
      sw.classList.toggle('on', pub);
      sw.setAttribute('aria-checked', pub ? 'true' : 'false');
    }
    // badge near own name
    ['drawerName', 'settingsProfileName', 'profilePreviewName', 'headerName'].forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      let badge = el.parentElement && el.parentElement.querySelector('.profile-lock-badge.own');
      if (!pub) {
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'profile-lock-badge own';
          badge.innerHTML = '<span class="material-icons-round">lock</span>';
          badge.title = 'Закрытый профиль';
          el.insertAdjacentElement('afterend', badge);
        }
        badge.style.display = 'inline-flex';
      } else if (badge) badge.style.display = 'none';
    });
  }
  function applyViewProfilePrivacy(user) {
    const closed = user && user.profilePublic === false;
    const priv = document.getElementById('viewProfilePrivateNote');
    const pubC = document.getElementById('viewProfilePublicContent');
    const lock = document.getElementById('viewProfileLockBadge');
    if (priv) {
      priv.style.display = closed ? 'block' : 'none';
      priv.innerHTML = closed
        ? '<span class="material-icons-round" style="vertical-align:middle;font-size:18px">lock</span> Профиль закрыт. Стена, посты и музыка скрыты.'
        : '';
    }
    if (pubC) pubC.style.display = closed ? 'none' : '';
    if (lock) lock.style.display = closed ? 'inline-flex' : 'none';
  }
  // Filter feed: hide others' posts if THEY closed (local flag on post or catalog)
  function shouldHideAuthorPosts(authorName) {
    try {
      if (!authorName) return false;
      if (authorName === (profile && profile.name)) return false; // own always visible to self
      // peopleCatalog flag
      if (typeof peopleCatalog !== 'undefined' && Array.isArray(peopleCatalog)) {
        const p = peopleCatalog.find(x => x.name === authorName);
        if (p && p.profilePublic === false) return true;
      }
      // posts can carry authorProfilePublic
      return false;
    } catch (_) { return false; }
  }
  // When publishing own posts, stamp profilePublic
  function stampPostPrivacy() {
    try {
      if (typeof posts === 'undefined' || !Array.isArray(posts)) return;
      const pub = isOwnProfilePublic();
      posts.forEach(p => {
        if (p.authorName === (profile && profile.name)) p.authorProfilePublic = pub;
      });
    } catch (_) {}
  }
  // Hook openViewProfile
  function hookViewProfile() {
    if (typeof openViewProfile !== 'function' || openViewProfile.__privHook) return;
    const orig = openViewProfile;
    const wrapped = function (name) {
      const r = orig.apply(this, arguments);
      try {
        // If viewing self handled inside orig
        if (window.viewProfileUser) {
          // for demo: if same name as us, use our flag; random closed if stored
          const n = (name || '').trim();
          if (n === (profile && profile.name)) {
            window.viewProfileUser.profilePublic = isOwnProfilePublic();
          } else {
            // check catalog / post stamp
            let pub = true;
            try {
              const post = (posts || []).find(p => p.authorName === n);
              if (post && post.authorProfilePublic === false) pub = false;
              if (typeof peopleCatalog !== 'undefined') {
                const pe = peopleCatalog.find(x => x.name === n);
                if (pe && pe.profilePublic === false) pub = false;
              }
              // local map
              const map = JSON.parse(localStorage.getItem('alpine_closed_profiles_v1') || '{}');
              if (map[n] === true) pub = false;
            } catch (_) {}
            window.viewProfileUser.profilePublic = pub;
          }
          applyViewProfilePrivacy(window.viewProfileUser);
          // clear posts if closed
          if (window.viewProfileUser.profilePublic === false) {
            const postsRoot = document.getElementById('viewProfilePosts');
            const musicRoot = document.getElementById('viewProfileMusic');
            if (postsRoot) postsRoot.innerHTML = '';
            if (musicRoot) musicRoot.innerHTML = '';
          }
        }
      } catch (e) { console.warn(e); }
      return r;
    };
    wrapped.__privHook = true;
    try { openViewProfile = wrapped; window.openViewProfile = wrapped; } catch (_) {}
  }

  // Filter global wall rendering if possible
  function hookWallFilter() {
    if (typeof renderGlobalWall !== 'function' || renderGlobalWall.__privFilter) return;
    // soft approach: after render, hide cards from closed authors
    const hideClosed = () => {
      try {
        document.querySelectorAll('#globalWallPosts .wall-post, #globalWallFeed .wall-post').forEach(el => {
          const author = el.querySelector('.wall-post-meta strong, .tw-name');
          const name = author ? author.textContent.trim() : '';
          if (!name || name === (profile && profile.name)) return;
          let closed = false;
          try {
            const map = JSON.parse(localStorage.getItem('alpine_closed_profiles_v1') || '{}');
            if (map[name]) closed = true;
          } catch (_) {}
          // also data attribute if stamped
          if (el.getAttribute('data-author-public') === '0') closed = true;
          if (closed) el.style.display = 'none';
        });
      } catch (_) {}
    };
    const orig = renderGlobalWall;
    const wrapped = function () {
      const r = orig.apply(this, arguments);
      setTimeout(hideClosed, 30);
      return r;
    };
    wrapped.__privFilter = true;
    try { renderGlobalWall = wrapped; window.renderGlobalWall = wrapped; } catch (_) {}
  }

  // When user closes profile, stamp posts + optional hide from "others" simulation
  function onProfilePublicToggle() {
    const sw = document.getElementById('profilePublicSwitch');
    if (!sw) return;
    const on = !sw.classList.contains('on');
    setOwnProfilePublic(on);
    stampPostPrivacy();
    // For local multi-account sim: mark own name in closed map when closed
    try {
      const map = JSON.parse(localStorage.getItem('alpine_closed_profiles_v1') || '{}');
      const n = profile && profile.name;
      if (n) {
        if (!on) map[n] = true; else delete map[n];
        localStorage.setItem('alpine_closed_profiles_v1', JSON.stringify(map));
      }
    } catch (_) {}
    try { if (typeof renderGlobalWall === 'function') renderGlobalWall(); } catch (_) {}
  }

  // ---------- Hold-to-record voice ----------
  let holdRec = null;
  let holdStream = null;
  let holdChunks = [];
  let holdTimer = null;
  let holdStart = 0;
  let holdCancelled = false;

  function showHoldUI(show) {
    const ov = document.getElementById('voiceHoldOverlay');
    if (!ov) return;
    ov.classList.toggle('show', !!show);
    ov.setAttribute('aria-hidden', show ? 'false' : 'true');
  }
  function tickHold() {
    const t = document.getElementById('voiceHoldTimer');
    if (!t) return;
    const sec = Math.floor((Date.now() - holdStart) / 1000);
    t.textContent = Math.floor(sec / 60) + ':' + String(sec % 60).padStart(2, '0');
  }
  async function startHoldRecord(btn) {
    if (!navigator.mediaDevices?.getUserMedia || !window.MediaRecorder) {
      toast('Запись не поддерживается');
      return;
    }
    if (activeChatId == null && !(window.alpineDmCurrentId || window.__alpineDmId)) {
      toast('Сначала откройте чат');
      return;
    }
    holdCancelled = false;
    holdChunks = [];
    try {
      holdStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const mime = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4'].find(m => MediaRecorder.isTypeSupported(m)) || '';
      holdRec = mime ? new MediaRecorder(holdStream, { mimeType: mime }) : new MediaRecorder(holdStream);
      holdRec.ondataavailable = e => { if (e.data && e.data.size) holdChunks.push(e.data); };
      holdRec.onstop = () => {
        const stream = holdStream;
        holdStream = null;
        if (stream) stream.getTracks().forEach(t => t.stop());
        showHoldUI(false);
        if (btn) btn.classList.remove('recording');
        if (holdTimer) { clearInterval(holdTimer); holdTimer = null; }
        if (holdCancelled || !holdChunks.length) {
          holdRec = null;
          return;
        }
        const blob = new Blob(holdChunks, { type: holdRec.mimeType || 'audio/webm' });
        holdRec = null;
        const reader = new FileReader();
        reader.onload = () => {
          pushVoiceMessage(reader.result);
        };
        reader.readAsDataURL(blob);
      };
      holdRec.start(100);
      holdStart = Date.now();
      tickHold();
      holdTimer = setInterval(tickHold, 250);
      showHoldUI(true);
      if (btn) btn.classList.add('recording');
      // haptic
      try { navigator.vibrate && navigator.vibrate(15); } catch (_) {}
    } catch (e) {
      toast('Нет доступа к микрофону');
    }
  }
  function stopHoldRecord(cancel) {
    holdCancelled = !!cancel;
    if (holdRec && holdRec.state === 'recording') {
      try { holdRec.stop(); } catch (_) {}
    } else {
      showHoldUI(false);
      if (holdStream) { holdStream.getTracks().forEach(t => t.stop()); holdStream = null; }
    }
  }
  function pushVoiceMessage(dataUrl) {
    const chatId = activeChatId != null ? activeChatId : (window.__alpineDmId || window.alpineDmCurrentId);
    const chat = (chats || []).find(c => String(c.id) === String(chatId));
    if (!chat) { toast('Чат не найден'); return; }
    if (!Array.isArray(chat.messages)) chat.messages = [];
    const msg = {
      id: (typeof msgIdCounter !== 'undefined' ? ++msgIdCounter : Date.now()),
      text: '',
      outgoing: true,
      time: Date.now(),
      reactions: [],
      read: false,
      attachment: { name: 'Голосовое', kind: 'audio', data: dataUrl }
    };
    chat.messages.push(msg);
    try {
      if (String(activeChatId) === String(chat.id) && typeof renderMessages === 'function') renderMessages(chat);
    } catch (_) {}
    try {
      // DM layer refresh
      if (typeof window.openDm === 'function' && document.getElementById('alpineDmLayer')?.classList.contains('open')) {
        window.openDm(chat.id);
      }
    } catch (_) {}
    try { if (typeof renderChatList === 'function') renderChatList(); } catch (_) {}
    try { if (typeof saveData === 'function') saveData(); } catch (_) {}
    toast('Голосовое отправлено');
  }
  function bindHoldBtn(btn) {
    if (!btn || btn.__holdBound) return;
    btn.__holdBound = true;
    let pressing = false;
    const down = (e) => {
      e.preventDefault();
      e.stopPropagation();
      pressing = true;
      startHoldRecord(btn);
    };
    const up = (e) => {
      if (!pressing) return;
      pressing = false;
      e.preventDefault();
      e.stopPropagation();
      // if moved up a lot — cancel
      stopHoldRecord(false);
    };
    const cancel = (e) => {
      if (!pressing) return;
      pressing = false;
      stopHoldRecord(true);
      toast('Запись отменена');
    };
    btn.addEventListener('pointerdown', down);
    btn.addEventListener('pointerup', up);
    btn.addEventListener('pointercancel', cancel);
    btn.addEventListener('pointerleave', (e) => {
      if (pressing && e.buttons) {
        // keep recording if finger slides slightly; cancel if leaves far — simple: continue
      }
    });
    // prevent click toggle old behavior
    btn.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); });
  }

  function bindAllVoice() {
    bindHoldBtn(document.getElementById('voiceBtn'));
    bindHoldBtn(document.getElementById('voiceRecBtn'));
    bindHoldBtn(document.getElementById('alpineDmVoice'));
    // observe DM layer recreation
    const layer = document.getElementById('alpineDmLayer');
    if (layer && !layer.__voiceObs) {
      layer.__voiceObs = true;
      const mo = new MutationObserver(() => bindHoldBtn(document.getElementById('alpineDmVoice')));
      mo.observe(layer, { childList: true, subtree: true });
    }
  }

  function bind() {
    document.getElementById('profilePublicSwitch')?.addEventListener('click', onProfilePublicToggle);
    // init switch from profile
    try {
      if (typeof profile !== 'undefined' && profile && profile.profilePublic === undefined) {
        profile.profilePublic = true;
      }
    } catch (_) {}
    paintOwnLock();
    stampPostPrivacy();
    hookViewProfile();
    hookWallFilter();
    bindAllVoice();
    setInterval(bindAllVoice, 2000);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
  else bind();
  setTimeout(bind, 500);
  setTimeout(bind, 1500);
})();
</script>


<script>
/* Web Push UX, expanded sessions, settings search, wall greeting, M3 motion helpers */
(function () {
  function toast(m) {
    try { if (typeof window.toast === 'function') window.toast(m); } catch (_) {}
  }

  // ---------- Wall greeting by local time ----------
  function greetingParts() {
    const h = new Date().getHours();
    if (h >= 5 && h < 12) return { title: 'Доброе утро', emoji: '☀️' };
    if (h >= 12 && h < 17) return { title: 'Добрый день', emoji: '🌤️' };
    if (h >= 17 && h < 23) return { title: 'Добрый вечер', emoji: '🌆' };
    return { title: 'Доброй ночи', emoji: '🌙' };
  }
  function paintWallGreeting() {
    const g = greetingParts();
    const title = document.getElementById('wallGreetingTitle');
    const emoji = document.getElementById('wallGreetingEmoji');
    const nameEl = document.getElementById('wallGreetingName');
    let name = 'друг';
    try {
      if (typeof profile !== 'undefined' && profile) {
        name = profile.name || profile.username || name;
      }
      if (typeof currentUser !== 'undefined' && currentUser && currentUser.username) {
        if (!profile || !profile.name) name = currentUser.username;
      }
    } catch (_) {}
    if (title) title.textContent = g.title;
    if (emoji) emoji.textContent = g.emoji;
    if (nameEl) nameEl.textContent = name;
  }

  // ---------- Settings search ----------
  function bindSettingsSearch() {
    const input = document.getElementById('settingsSearchInput');
    if (!input || input.__bound) return;
    input.__bound = true;
    input.addEventListener('input', () => {
      const q = (input.value || '').trim().toLowerCase();
      document.querySelectorAll('#settingsPanel .settings-section, #settingsPanel .info-section').forEach(sec => {
        if (!q) {
          sec.classList.remove('settings-dimmed');
          sec.style.display = '';
          return;
        }
        const text = (sec.textContent || '').toLowerCase();
        const hit = text.includes(q);
        sec.style.display = hit ? '' : 'none';
      });
    });
  }

  // ---------- Web Push / notifications convenience ----------
  async function registerNotifySW() {
    if (!('serviceWorker' in navigator)) return null;
    if (!/^https:/.test(location.protocol) && location.hostname !== 'localhost') return null;
    try {
      const swCode = `
self.addEventListener('notificationclick', function(event) {
  event.notification.close();
  const data = event.notification.data || {};
  event.waitUntil(clients.matchAll({ type: 'window', includeUncontrolled: true }).then(function(list) {
    for (var i = 0; i < list.length; i++) {
      if (list[i].focus) { list[i].focus(); if (data.chatId && list[i].postMessage) list[i].postMessage({ type: 'OPEN_CHAT', chatId: data.chatId }); return; }
    }
    if (clients.openWindow) return clients.openWindow(data.url || '/');
  }));
});
self.addEventListener('message', function(event) {
  var d = event.data || {};
  if (d.type === 'SHOW_NOTIFICATION') {
    event.waitUntil(self.registration.showNotification(d.title || 'Alpine', d.options || {}));
  }
});
self.addEventListener('push', function(event) {
  var data = {};
  try { data = event.data ? event.data.json() : {}; } catch (e) {}
  event.waitUntil(self.registration.showNotification(data.title || 'Alpine', {
    body: data.body || '',
    icon: data.icon,
    data: data.data || {}
  }));
});
`;
      const blob = new Blob([swCode], { type: 'application/javascript' });
      const url = URL.createObjectURL(blob);
      const reg = await navigator.serviceWorker.register(url, { scope: './' });
      return reg;
    } catch (e) {
      console.warn('SW register', e);
      return null;
    }
  }

  async function enablePushFlow(interactive) {
    if (typeof Notification === 'undefined') {
      toast('Уведомления не поддерживаются в этом браузере');
      return false;
    }
    try {
      await registerNotifySW();
    } catch (_) {}
    let ok = false;
    try {
      if (typeof ensureNotificationPermission === 'function') {
        ok = await ensureNotificationPermission(!!interactive);
      } else {
        const perm = await Notification.requestPermission();
        ok = perm === 'granted';
      }
    } catch (_) {}
    try {
      if (typeof browserNotify !== 'undefined') browserNotify = !!ok;
      if (typeof saveData === 'function') saveData();
    } catch (_) {}
    const btn = document.getElementById('enablePushBtn');
    if (btn) btn.textContent = ok ? 'Включены' : 'Включить';
    const sw = document.getElementById('notifySwitch');
    if (sw) {
      sw.classList.toggle('on', ok);
      sw.setAttribute('aria-checked', ok ? 'true' : 'false');
    }
    if (ok) {
      toast('Уведомления включены');
      try {
        if (typeof notifyBrowser === 'function') {
          notifyBrowser('Alpine', 'Готово — уведомления работают на этом устройстве', { force: true, tag: 'push-ok' });
        } else if (Notification.permission === 'granted') {
          new Notification('Alpine', { body: 'Готово — уведомления работают на этом устройстве' });
        }
      } catch (_) {}
    } else if (interactive) {
      toast(Notification.permission === 'denied'
        ? 'Разрешение запрещено в настройках браузера'
        : 'Разрешение не получено');
    }
    hidePushBanner();
    return ok;
  }

  function showPushBannerIfNeeded() {
    try {
      if (typeof Notification === 'undefined') return;
      if (Notification.permission === 'granted' || Notification.permission === 'denied') return;
      if (localStorage.getItem('alpine_push_banner_dismissed') === '1') return;
      // delay so not annoying on first paint
      setTimeout(() => {
        const b = document.getElementById('pushPermissionBanner');
        if (b) b.classList.add('show');
      }, 4000);
    } catch (_) {}
  }
  function hidePushBanner() {
    document.getElementById('pushPermissionBanner')?.classList.remove('show');
  }

  // ---------- Expanded local sessions ----------
  const SESS_KEY = 'alpine_local_sessions_v1';
  function deviceFingerprint() {
    const ua = navigator.userAgent || '';
    const label = (function () {
      const os = /Windows/i.test(ua) ? 'Windows' : /Mac OS|Macintosh/i.test(ua) ? 'macOS' : /Android/i.test(ua) ? 'Android' : /iPhone|iPad/i.test(ua) ? 'iOS' : /Linux/i.test(ua) ? 'Linux' : 'Device';
      const browser = /Edg\//i.test(ua) ? 'Edge' : /Firefox\//i.test(ua) ? 'Firefox' : /Chrome\//i.test(ua) ? 'Chrome' : /Safari\//i.test(ua) ? 'Safari' : 'Browser';
      return browser + ' · ' + os;
    })();
    let id = localStorage.getItem('alpine_device_id_v1');
    if (!id) {
      id = 'd_' + Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
      localStorage.setItem('alpine_device_id_v1', id);
    }
    return { id, label, ua: ua.slice(0, 120), screen: (screen.width + '×' + screen.height), lang: navigator.language || '' };
  }
  function loadSessions() {
    try { return JSON.parse(localStorage.getItem(SESS_KEY) || '[]'); } catch (_) { return []; }
  }
  function saveSessions(list) {
    try { localStorage.setItem(SESS_KEY, JSON.stringify(list.slice(0, 20))); } catch (_) {}
  }
  function touchCurrentSession() {
    const fp = deviceFingerprint();
    let list = loadSessions();
    const now = Date.now();
    const existing = list.find(s => s.id === fp.id);
    if (existing) {
      existing.lastActive = now;
      existing.label = fp.label;
      existing.current = true;
    } else {
      list.unshift({
        id: fp.id,
        label: fp.label,
        created: now,
        lastActive: now,
        current: true,
        screen: fp.screen,
        lang: fp.lang,
        user: (typeof currentUser !== 'undefined' && currentUser && (currentUser.email || currentUser.username)) || 'local'
      });
    }
    list.forEach(s => { if (s.id !== fp.id) s.current = false; });
    saveSessions(list);
  }
  function renderExpandedSessions() {
    touchCurrentSession();
    const list = loadSessions().sort((a, b) => (b.lastActive || 0) - (a.lastActive || 0));
    const roots = [document.getElementById('sessionsList'), document.getElementById('deviceSessionsList')].filter(Boolean);
    const html = list.map(s => {
      const when = s.lastActive ? new Date(s.lastActive).toLocaleString() : '—';
      const created = s.created ? new Date(s.created).toLocaleString() : '';
      return `<div class="sess-card device-session-item" data-sess-id="${s.id}">
        <span class="material-icons-round device-session-icon">${s.current ? 'smartphone' : 'devices'}</span>
        <div class="sess-card-meta device-session-meta">
          <strong>${escapeHtmlSafe(s.label || 'Устройство')}${s.current ? ' <span class="device-current-tag">сейчас</span>' : ''}</strong>
          <small>Активность: ${escapeHtmlSafe(when)}${created ? ' · вход: ' + escapeHtmlSafe(created) : ''}</small>
          <small>${escapeHtmlSafe(s.screen || '')} · ${escapeHtmlSafe(s.lang || '')} · ${escapeHtmlSafe(s.user || '')}</small>
        </div>
        ${s.current ? '' : `<button type="button" class="btn btn-text device-end-session" data-end-local="${s.id}">Завершить</button>`}
      </div>`;
    }).join('') || '<p class="setting-sub">Нет сохранённых сеансов</p>';
    roots.forEach(r => { r.innerHTML = html; });
    const note = document.getElementById('deviceSessionsNotice');
    if (note) note.textContent = 'Локальные сеансы этого браузера + метки с других установок (если импортировали бэкап). Серверные сеансы появятся при наличии API.';
  }
  function escapeHtmlSafe(s) {
    return String(s || '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
  }
  function endLocalSession(id) {
    let list = loadSessions().filter(s => s.id !== id);
    saveSessions(list);
    renderExpandedSessions();
    toast('Сеанс завершён');
  }
  function endOtherSessions() {
    const fp = deviceFingerprint();
    saveSessions(loadSessions().filter(s => s.id === fp.id));
    renderExpandedSessions();
    toast('Другие локальные сеансы завершены');
  }

  function bind() {
    paintWallGreeting();
    setInterval(paintWallGreeting, 60 * 1000);
    bindSettingsSearch();
    touchCurrentSession();

    document.getElementById('enablePushBtn')?.addEventListener('click', () => enablePushFlow(true));
    document.getElementById('testPushBtn')?.addEventListener('click', async () => {
      const ok = await enablePushFlow(true);
      if (ok) {
        try {
          if (typeof notifyBrowser === 'function') notifyBrowser('Тест Alpine', 'Если вы это видите — push на устройстве работает', { force: true, tag: 'test' });
          else new Notification('Тест Alpine', { body: 'Если вы это видите — уведомления работают' });
        } catch (_) {}
      }
    });
    document.getElementById('pushBannerAllow')?.addEventListener('click', () => enablePushFlow(true));
    document.getElementById('pushBannerLater')?.addEventListener('click', () => {
      localStorage.setItem('alpine_push_banner_dismissed', '1');
      hidePushBanner();
    });
    showPushBannerIfNeeded();

    document.getElementById('openSessionsBtn')?.addEventListener('click', () => {
      renderExpandedSessions();
      try { if (typeof refreshDeviceSessions === 'function') refreshDeviceSessions(); } catch (_) {}
    });
    document.getElementById('sessionsRefreshBtn')?.addEventListener('click', () => {
      renderExpandedSessions();
      try { if (typeof refreshDeviceSessions === 'function') refreshDeviceSessions(); } catch (_) {}
      toast('Обновлено');
    });
    document.getElementById('sessionsLogoutOthers')?.addEventListener('click', endOtherSessions);
    document.addEventListener('click', e => {
      const btn = e.target.closest && e.target.closest('[data-end-local]');
      if (!btn) return;
      endLocalSession(btn.getAttribute('data-end-local'));
    });

    // Keep session alive
    document.addEventListener('visibilitychange', () => { if (!document.hidden) touchCurrentSession(); });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
  else bind();
  setTimeout(bind, 400);
  setTimeout(paintWallGreeting, 800);
})();
</script>


<script>
/* Clean return to wall from chats */
(function () {
  function hardOpenWall() {
    try {
      if (typeof openWallPage === 'function') openWallPage();
    } catch (_) {}
    try {
      document.querySelector('.app')?.classList.add('wall-mode');
      document.body.classList.add('wall-mode');
      document.documentElement.classList.add('wall-mode');
      document.getElementById('wallPage')?.classList.add('show');
      const side = document.getElementById('sidebar');
      if (side) {
        side.classList.add('hidden');
        side.style.setProperty('display', 'none', 'important');
      }
      document.getElementById('alpineDmLayer')?.classList.remove('open');
      document.body.classList.remove('chat-conversation-open', 'dm-open-desktop');
      document.getElementById('activeChat') && (document.getElementById('activeChat').style.display = 'none');
    } catch (_) {}
  }
  function bind() {
    document.getElementById('railWallBtn')?.addEventListener('click', hardOpenWall);
    document.getElementById('bnHome')?.addEventListener('click', hardOpenWall);
    document.getElementById('emptyOpenWallBtn')?.addEventListener('click', hardOpenWall);
    // after back from chat on mobile
    const origGoBack = window.goBackToChatList;
    // when user taps Home while in chat — wall not chat list empty
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
  else bind();
  setTimeout(bind, 500);
  window.__hardOpenWall = hardOpenWall;
})();
</script>


<script>
/* Alpine Plus verification badges: blogger / social / dev */
(function () {
  function toast(m) {
    try { if (typeof window.toast === 'function') window.toast(m); } catch (_) {}
  }
  function currentBadge() {
    try {
      if (typeof profile === 'undefined' || !profile) return '';
      if (profile.verifyBadge) return profile.verifyBadge;
      if (profile.verified) return 'social';
      return '';
    } catch (_) { return ''; }
  }
  function setBadge(kind) {
    try {
      if (typeof profile === 'undefined') return;
      profile.verifyBadge = kind || '';
      profile.verified = !!kind;
      if (kind === 'blogger') profile.creator = true;
      if (typeof profileDraft !== 'undefined' && profileDraft) {
        profileDraft.verifyBadge = profile.verifyBadge;
        profileDraft.verified = profile.verified;
      }
      if (typeof saveData === 'function') saveData();
      paintBadgeGrid();
      try { if (typeof renderProfileSummary === 'function') renderProfileSummary(); } catch (_) {}
      try { if (typeof cloudPublishProfile === 'function') cloudPublishProfile(); } catch (_) {}
      try { if (typeof renderGlobalWall === 'function') renderGlobalWall(); } catch (_) {}
      const labels = { blogger: 'Знак «Автор / блогер»', social: 'Знак «Подтверждённый аккаунт»', dev: 'Знак «Разработчик»' };
      toast(kind ? (labels[kind] || 'Галочка') : 'Галочка снята');
    } catch (e) { console.warn(e); }
  }
  function paintBadgeGrid() {
    const cur = currentBadge();
    document.querySelectorAll('#plusBadgeGrid .plus-badge-row, #plusBadgeGrid .plus-badge-opt').forEach(btn => {
      const k = btn.getAttribute('data-badge') || '';
      btn.setAttribute('aria-pressed', k === cur ? 'true' : 'false');
    });
  }
  function bind() {
    document.getElementById('plusBadgeGrid')?.addEventListener('click', e => {
      const btn = e.target.closest('.plus-badge-row, .plus-badge-opt');
      if (!btn) return;
      setBadge(btn.getAttribute('data-badge') || '');
    });
    paintBadgeGrid();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
  else bind();
  setTimeout(bind, 500);
  setTimeout(paintBadgeGrid, 1200);
})();
</script>

