<script>
/* ===== Settings groups + Saved Music + Mini player + music UX ===== */
(function () {
  const MUSIC_TRACK_LIMIT = 40;

  function toastSafe(m) { try { if (typeof toast === 'function') toast(m); } catch (_) {} }

  // ---- Group settings into collapsible sections ----
  function groupSettings() {
    const body = document.querySelector('#settingsPanel .settings-body');
    if (!body || body.__grouped) return;
    body.__grouped = true;
    const sections = Array.from(body.querySelectorAll(':scope > .settings-section, :scope > .info-section.settings-section'));
    if (sections.length < 3) return;

    function titleOf(sec) {
      const t = sec.querySelector('.info-section-title');
      return (t && t.textContent || '').trim().toLowerCase();
    }
    const groups = [
      { id: 'account', label: 'Account', icon: 'person', match: (t) => /language|язык|verification|вериф|аккаунт|вход|account|login/.test(t) },
      { id: 'appearance', label: 'Appearance', icon: 'palette', match: (t) => /оформ|appear|theme|тема|цвет|accent/.test(t) },
      { id: 'notifications', label: 'Notifications', icon: 'notifications', match: (t) => /уведом|notif/.test(t) },
      { id: 'privacy', label: 'Privacy', icon: 'shield', match: (t) => /приват|privacy|ghost|призра|mute|block|чёрн|архив/.test(t) },
      { id: 'security', label: 'Security', icon: 'lock', match: (t) => /безопас|security|2fa|session|pin|export|сеть|network|data/.test(t) },
      { id: 'other', label: 'More', icon: 'tune', match: () => true }
    ];
    const buckets = {};
    groups.forEach(g => { buckets[g.id] = []; });
    sections.forEach(sec => {
      const t = titleOf(sec);
      const g = groups.find(x => x.match(t)) || groups[groups.length - 1];
      // Network is under security/data
      if (/network|сеть/.test(t)) buckets.security.push(sec);
      else buckets[g.id].push(sec);
    });
    // Build details
    const frag = document.createDocumentFragment();
    // keep profile card and note at top - already before sections
    groups.forEach(g => {
      const list = buckets[g.id];
      if (!list.length) return;
      const det = document.createElement('details');
      det.className = 'settings-group';
      if (g.id === 'account' || g.id === 'security') det.open = true;
      det.innerHTML = `<summary><span class="material-icons-round">${g.icon}</span>${g.label}</summary>`;
      list.forEach(sec => det.appendChild(sec));
      frag.appendChild(det);
    });
    // Remove old sections from body and append groups
    sections.forEach(s => { if (s.parentNode === body) s.remove(); });
    body.appendChild(frag);
  }

  // ---- Saved Music ----
  function likedIds() {
    try { return JSON.parse(localStorage.getItem('alpine_liked_tracks') || '[]'); } catch (_) { return []; }
  }
  function saveLikedIds(ids) {
    try { localStorage.setItem('alpine_liked_tracks', JSON.stringify(ids)); } catch (_) {}
  }

  function renderSavedMusicList() {
    const root = document.getElementById('savedMusicList');
    if (!root) return;
    const tracks = (typeof musicTracks !== 'undefined' && Array.isArray(musicTracks)) ? musicTracks : [];
    const liked = new Set(likedIds().map(String));
    let list = tracks.filter(tr => liked.has(String(tr.id)) || tr.uploader === ((profile && profile.name) || '') || tr.savedInLibrary);
    if (!list.length) list = tracks.slice(0, 30); // show library if no likes yet
    if (!list.length) {
      root.innerHTML = '<p class="setting-sub" style="padding:12px 4px">No tracks yet. Upload audio — it stays on this device.</p>';
      return;
    }
    root.innerHTML = list.map(tr => `
      <div class="saved-music-item" data-track-id="${tr.id}">
        <div class="amp-cover" style="width:40px;height:40px;border-radius:8px;background:#333;display:flex;align-items:center;justify-content:center">
          <span class="material-icons-round">music_note</span>
        </div>
        <div style="min-width:0;flex:1">
          <strong>${escapeMus(tr.title || 'Track')}</strong>
          <small>${escapeMus(tr.uploader || 'Local')} · ${tr.plays || 0} plays</small>
        </div>
        <div class="sm-actions">
          <button type="button" class="icon-btn" data-sm-play="${tr.id}" title="Play"><span class="material-icons-round">play_arrow</span></button>
          <button type="button" class="icon-btn" data-sm-like="${tr.id}" title="Like"><span class="material-icons-round">${liked.has(String(tr.id)) ? 'favorite' : 'favorite_border'}</span></button>
          <button type="button" class="icon-btn" data-sm-attach="${tr.id}" title="Attach to post"><span class="material-icons-round">add_to_photos</span></button>
          <button type="button" class="icon-btn" data-sm-profile="${tr.id}" title="On profile"><span class="material-icons-round">person</span></button>
        </div>
      </div>
    `).join('');
    root.querySelectorAll('[data-sm-play]').forEach(b => b.onclick = () => {
      try { if (typeof playTrack === 'function') playTrack(b.getAttribute('data-sm-play')); } catch (_) {}
      syncMiniPlayer();
    });
    root.querySelectorAll('[data-sm-like]').forEach(b => b.onclick = () => {
      const id = String(b.getAttribute('data-sm-like'));
      let ids = likedIds();
      if (ids.map(String).includes(id)) ids = ids.filter(x => String(x) !== id);
      else ids.push(id);
      saveLikedIds(ids);
      renderSavedMusicList();
      updateMusicBadge();
      toastSafe('Saved · Music updated');
    });
    root.querySelectorAll('[data-sm-attach]').forEach(b => b.onclick = () => {
      const id = b.getAttribute('data-sm-attach');
      const tr = (musicTracks || []).find(x => String(x.id) === String(id));
      if (!tr) return;
      window._musicAttachDraft = { id: tr.id, title: tr.title || 'Track', uploader: tr.uploader || '' };
      toastSafe('Track attached — open Home and Post');
      try { document.getElementById('closeSavedBtn')?.click(); } catch (_) {}
    });
    root.querySelectorAll('[data-sm-profile]').forEach(b => b.onclick = () => {
      const id = b.getAttribute('data-sm-profile');
      try {
        if (typeof profileTrackIds === 'undefined') window.profileTrackIds = [];
        if (!profileTrackIds.map(String).includes(String(id))) {
          if (profileTrackIds.length >= 3) { toastSafe('Profile holds up to 3 tracks'); return; }
          profileTrackIds.push(id);
        } else {
          profileTrackIds = profileTrackIds.filter(x => String(x) !== String(id));
        }
        if (typeof saveData === 'function') saveData();
        toastSafe('Profile music updated');
      } catch (_) {}
    });
    updateMusicBadge();
  }

  function escapeMus(s) {
    return String(s || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  }

  function updateMusicBadge() {
    const el = document.getElementById('savedMusicBadge');
    if (!el) return;
    const n = likedIds().length || ((typeof musicTracks !== 'undefined' && musicTracks.length) ? musicTracks.length : 0);
    el.textContent = n ? String(n) : '';
  }

  window.renderSavedMusicList = renderSavedMusicList;
  window.openSavedMusic = function () {
    try {
      if (typeof openBookmarksPanel === 'function') openBookmarksPanel();
      else if (typeof openSavedPanel === 'function') openSavedPanel();
      else {
        document.getElementById('savedPanel')?.classList.add('show');
        document.getElementById('panelOverlay')?.classList.add('show');
      }
    } catch (_) {
      document.getElementById('savedPanel')?.classList.add('show');
    }
    setTimeout(() => {
      try { if (typeof setSavedTab === 'function') setSavedTab('music'); } catch (_) {}
      renderSavedMusicList();
    }, 50);
    try { if (typeof closeDrawer === 'function') closeDrawer(); } catch (_) {}
  };

  // ---- Mini player synced to musicAudio ----
  function syncMiniPlayer() {
    const mini = document.getElementById('alpineMiniPlayer');
    const audio = document.getElementById('musicAudio');
    if (!mini) return;
    const tr = (typeof musicTracks !== 'undefined' && typeof currentTrackId !== 'undefined')
      ? musicTracks.find(x => String(x.id) === String(currentTrackId))
      : null;
    if (!tr || !audio) {
      // still show if audio playing
      if (!audio || !audio.src) { mini.classList.remove('show'); return; }
    }
    mini.classList.add('show');
    const title = document.getElementById('ampTitle');
    const artist = document.getElementById('ampArtist');
    if (title) title.textContent = (tr && tr.title) || 'Now playing';
    if (artist) artist.textContent = (tr && tr.uploader) || '';
    const icon = document.getElementById('ampPlayIcon');
    if (icon) icon.textContent = (audio && !audio.paused) ? 'pause' : 'play_arrow';
  }

  function bindMiniPlayer() {
    const audio = () => document.getElementById('musicAudio');
    document.getElementById('ampPlay')?.addEventListener('click', () => {
      const a = audio();
      if (!a) return;
      if (a.paused) a.play().catch(() => {});
      else a.pause();
      setTimeout(syncMiniPlayer, 50);
    });
    document.getElementById('ampClose')?.addEventListener('click', () => {
      const a = audio();
      if (a) { a.pause(); a.removeAttribute('src'); }
      document.getElementById('alpineMiniPlayer')?.classList.remove('show');
    });
    document.getElementById('ampNext')?.addEventListener('click', () => {
      try {
        if (typeof musicQueue !== 'undefined' && musicQueue.length && typeof currentTrackId !== 'undefined') {
          const idx = musicQueue.map(String).indexOf(String(currentTrackId));
          const next = musicQueue[(idx + 1) % musicQueue.length];
          if (typeof playTrack === 'function') playTrack(next);
        }
      } catch (_) {}
      setTimeout(syncMiniPlayer, 100);
    });
    document.getElementById('ampPrev')?.addEventListener('click', () => {
      try {
        if (typeof musicQueue !== 'undefined' && musicQueue.length && typeof currentTrackId !== 'undefined') {
          const idx = musicQueue.map(String).indexOf(String(currentTrackId));
          const prev = musicQueue[(idx - 1 + musicQueue.length) % musicQueue.length];
          if (typeof playTrack === 'function') playTrack(prev);
        }
      } catch (_) {}
      setTimeout(syncMiniPlayer, 100);
    });
    document.getElementById('ampMetaHit')?.addEventListener('click', () => {
      try { if (typeof openMusicPage === 'function') openMusicPage(); } catch (_) {}
    });
    // hook playTrack
    if (typeof playTrack === 'function' && !playTrack.__mini) {
      const orig = playTrack;
      window.playTrack = function (id) {
        const r = orig.apply(this, arguments);
        setTimeout(syncMiniPlayer, 80);
        const a = document.getElementById('musicAudio');
        if (a && !a.__miniEvents) {
          a.__miniEvents = true;
          a.addEventListener('play', syncMiniPlayer);
          a.addEventListener('pause', syncMiniPlayer);
          a.addEventListener('ended', () => {
            try {
              if (typeof musicQueue !== 'undefined' && musicQueue.length) {
                const idx = musicQueue.map(String).indexOf(String(currentTrackId));
                const next = musicQueue[(idx + 1) % musicQueue.length];
                if (next && String(next) !== String(currentTrackId)) playTrack(next);
              }
            } catch (_) {}
          });
        }
        return r;
      };
      window.playTrack.__mini = true;
    }
  }

  // ---- Upload limit + saved upload button ----
  function patchMusicUploadLimit() {
    const input = document.getElementById('musicFileInput');
    if (!input || input.__limit) return;
    input.__limit = true;
    input.addEventListener('change', () => {
      try {
        if (typeof musicTracks !== 'undefined' && musicTracks.length >= MUSIC_TRACK_LIMIT) {
          toastSafe('Track limit is ' + MUSIC_TRACK_LIMIT + ' (device storage)');
        }
      } catch (_) {}
    }, true);
  }

  // Attach music line into createPost text
  if (typeof createPost === 'function' && !createPost.__musicAttach) {
    const orig = createPost;
    window.createPost = function (text, imageData, quoteOf, mediaExtra) {
      let t = text || '';
      if (window._musicAttachDraft) {
        const m = window._musicAttachDraft;
        t = (t ? t + '\n\n' : '') + '♪ ' + (m.title || 'Track') + (m.uploader ? ' — ' + m.uploader : '');
        window._musicAttachDraft = null;
      }
      return orig.call(this, t, imageData, quoteOf, mediaExtra);
    };
    window.createPost.__musicAttach = true;
  }

  function bindSavedMusicChrome() {
    document.getElementById('savedMusicUploadBtn')?.addEventListener('click', () => {
      document.getElementById('musicFileInput')?.click();
    });
    document.getElementById('savedMusicPlaylistsBtn')?.addEventListener('click', () => {
      try {
        if (typeof openMusicPage === 'function') openMusicPage();
        if (typeof musicTab !== 'undefined') {
          window.musicTab = 'playlists';
          if (typeof renderMusicUI === 'function') renderMusicUI();
        }
      } catch (_) {}
    });
    document.getElementById('savedMusicOpenFullBtn')?.addEventListener('click', () => {
      try { if (typeof openMusicPage === 'function') openMusicPage(); } catch (_) {}
    });
  }

  function boot() {
    try { groupSettings(); } catch (e) { console.warn(e); }
    try { bindMiniPlayer(); } catch (e) { console.warn(e); }
    try { bindSavedMusicChrome(); } catch (e) { console.warn(e); }
    try { patchMusicUploadLimit(); } catch (e) { console.warn(e); }
    try { updateMusicBadge(); } catch (e) { console.warn(e); }
    setTimeout(() => {
      try { groupSettings(); bindMiniPlayer(); patchMusicUploadLimit(); } catch (_) {}
    }, 1500);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>


