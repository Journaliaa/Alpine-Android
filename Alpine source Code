          <button type="button" class="wall-post-more" data-post-menu="${p.id}" title="More">
            <span class="material-icons-round" style="font-size:20px">more_horiz</span>
          </button>
        </div>
        ${p.text ? `<div class="wall-post-text">${linkifyHashtags(p.text)}${p.edited ? ' <small style="opacity:.6">(edited)</small>' : ''}</div>` : ''}
        ${quoteHtml}
        ${renderPostMediaHtml(p)}
        <div class="wall-post-actions">
          <button type="button" class="wall-action-btn ${p.liked ? 'liked' : ''}" data-like-post="${p.id}" title="Like" aria-label="Like">
