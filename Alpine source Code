  // ---------- Real 2FA + backup codes ----------
  async function hashPin(pin) {
    const bytes = await sha256Bytes('alpine-2fa:' + String(pin || ''));
    return Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
  }
  function genBackupCodes() {
    const codes = [];
    for (let i = 0; i < 8; i++) {
      const n = crypto.getRandomValues(new Uint32Array(1))[0] % 100000000;
      codes.push(String(n).padStart(8, '0'));
    }
    return codes;
  }
  async function setup2FAInteractive() {
    const pin = prompt('Set 2FA code (6+ digits or passphrase):');
    if (!pin || String(pin).length < 6) { try { toast('2FA code too short'); } catch (_) {} return false; }
    const confirm = prompt('Confirm 2FA code:');
    if (pin !== confirm) { try { toast('Codes do not match'); } catch (_) {} return false; }
    const hash = await hashPin(pin);
    const backups = genBackupCodes();
    const backupHashes = [];
    for (const c of backups) backupHashes.push(await hashPin('backup:' + c));
    localStorage.setItem('alpine_2fa_enabled', 'true');
    localStorage.setItem('alpine_2fa_hash', hash);
    localStorage.setItem('alpine_2fa_backups', JSON.stringify(backupHashes));
    window.twoFactorEnabled = true;
    alert('Save these one-time backup codes (shown once):\n\n' + backups.join('\n') + '\n\nStore them offline.');
    try { toast('2FA enabled'); } catch (_) {}
    return true;
  }
  async function verify2FAInteractive() {
    const enabled = localStorage.getItem('alpine_2fa_enabled') === 'true';
    if (!enabled) return true;
    const input = prompt('Enter 2FA code or backup code:');
    if (input == null) return false;
    const h = await hashPin(input);
    const main = localStorage.getItem('alpine_2fa_hash');
    if (h === main) return true;
    // backup
    let backups = [];
    try { backups = JSON.parse(localStorage.getItem('alpine_2fa_backups') || '[]'); } catch (_) {}
    const bh = await hashPin('backup:' + input);
    const idx = backups.indexOf(bh);
    if (idx >= 0) {
      backups.splice(idx, 1);
      localStorage.setItem('alpine_2fa_backups', JSON.stringify(backups));
      try { toast('Backup code used (' + backups.length + ' left)'); } catch (_) {}
      return true;
    }
    try { toast('Invalid 2FA code'); } catch (_) {}
    return false;
  }

  function patch2FA() {
    // Replace demo 2FA in previous module behavior
    window.twoFactorEnabled = localStorage.getItem('alpine_2fa_enabled') === 'true';
    const sw = document.getElementById('twoFactorSwitch');
    if (sw && !sw.__real2fa) {
      sw.__real2fa = true;
      sw.onclick = async (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (!window.twoFactorEnabled) {
