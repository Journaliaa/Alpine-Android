      document.getElementById('archiveLabel').textContent = chat.archived ? 'Вернуть из архива' : 'В архив';
    const favLabel=document.getElementById('favoriteLabel'); if(favLabel)favLabel.textContent=chat.favorite?'Убрать из избранного':'В избранное';
      const blockLabel = document.getElementById('blockUserLabel');
      const blocked = typeof isChatBlocked === 'function' ? isChatBlocked(chat) : isBlockedName(chat.name);
