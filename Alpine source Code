    async function handleGoogleCredential(response) {
      if (googleSignInBusy) return;
      googleSignInBusy = true;
      showAuthError('Проверяем аккаунт Google…');
      const fallback = document.getElementById('googleSignInFallback');
      if (fallback) fallback.disabled = true;
      try {
        if (!response || !response.credential) throw new Error('Google не вернул токен. Попробуйте ещё раз.');
        const res = await fetch('/api/auth/google', {
          method: 'POST', credentials: 'same-origin', cache: 'no-store',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ credential: response.credential })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.user || !data.user.sub) {
          throw new Error(data.error || 'Сервер не смог подтвердить аккаунт Google.');
        }
        const account = upsertGoogleAccount(data.user);
        account.provider = 'google';
        account.googleSub = data.user.sub;
        account.name = data.user.name || account.name;
        account.email = data.user.email || account.email;
        loginUser(account);
      } catch (err) {
        console.error('Google sign-in failed:', err);
        const reason = (err && err.message) || '';
        showAuthError(reason.includes('Failed to fetch') || reason.includes('NetworkError')
          ? 'Не удалось связаться с сервером авторизации. Запустите Nivadagram через комплект с server.js, а не открывайте HTML напрямую.'
          : reason || 'Не удалось войти через Google.');
      } finally {
        googleSignInBusy = false;
        if (fallback) fallback.disabled = false;
      }
    }

    function initGoogleAuthButton() {
      const fallback = document.getElementById('googleSignInFallback');
