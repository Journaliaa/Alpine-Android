    function playDiscordTone(kind) {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const now = ctx.currentTime;
        if (kind === 'join') {
          [440, 554, 659].forEach((f, i) => {
            const o = ctx.createOscillator(); const g = ctx.createGain();
            o.connect(g); g.connect(ctx.destination);
            o.frequency.value = f; g.gain.value = 0.06;
            o.start(now + i * 0.08); g.gain.exponentialRampToValueAtTime(0.001, now + i * 0.08 + 0.25); o.stop(now + i * 0.08 + 0.25);
          });
        } else if (kind === 'leave') {
          [659, 440].forEach((f, i) => {
            const o = ctx.createOscillator(); const g = ctx.createGain();
            o.connect(g); g.connect(ctx.destination);
            o.frequency.value = f; g.gain.value = 0.06;
            o.start(now + i * 0.1); g.gain.exponentialRampToValueAtTime(0.001, now + i * 0.1 + 0.3); o.stop(now + i * 0.1 + 0.3);
          });
        } else {
          // ring
          for (let i = 0; i < 3; i++) {
            const o = ctx.createOscillator(); const g = ctx.createGain();
            o.connect(g); g.connect(ctx.destination);
            o.frequency.value = 520; g.gain.value = 0.05;
            o.start(now + i * 0.4); g.gain.exponentialRampToValueAtTime(0.001, now + i * 0.4 + 0.2); o.stop(now + i * 0.4 + 0.2);
          }
        }
      } catch {}
    }

