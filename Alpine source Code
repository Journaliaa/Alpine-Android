    // Offline music: tracks stored as data URLs in localStorage — work without network
    function ensureMusicOffline() {
      try {
        if (!('serviceWorker' in navigator)) return;
        const swCode = `
const CACHE = 'nivada-app-v2';
self.addEventListener('install', e => {
  self.skipWaiting();
  e.waitUntil(caches.open(CACHE).then(c => c.addAll([]).catch(() => {})));
});
self.addEventListener('activate', e => {
  e.waitUntil(self.clients.claim());
});
self.addEventListener('fetch', e => {
  const u = e.request.url;
  if (e.request.method !== 'GET') return;
  if (u.startsWith('data:') || u.startsWith('blob:')) return;
  if (u.includes('fonts.googleapis') || u.includes('fonts.gstatic') || u.includes('accounts.google')) return;
  // Network-first for HTML, cache-first fallback for same-origin shell
  if (e.request.mode === 'navigate' || u.endsWith('.html') || u.includes('Alpine')) {
    e.respondWith(
      fetch(e.request).then(res => {
        try { const clone = res.clone(); caches.open(CACHE).then(c => c.put(e.request, clone)); } catch (x) {}
        return res;
      }).catch(() => caches.match(e.request).then(r => r || caches.match('./')))
    );
  }
});
self.addEventListener('message', e => {
  const data = e.data || {};
  if (data.type === 'SHOW_NOTIFICATION') {
    e.waitUntil(
      self.registration.showNotification(data.title || 'Alpine', data.options || {})
    );
  }
  if (data.type === 'CLEAR_BADGE') {
    if (self.registration && self.registration.clearAppBadge) {
      e.waitUntil(self.registration.clearAppBadge());
    }
  }
});
self.addEventListener('notificationclick', e => {
  e.notification.close();
  const data = e.notification.data || {};
  const targetUrl = data.url || './';
  e.waitUntil(
    self.clients.matchAll({ type: 'window', includeUncontrolled: true }).then(list => {
      for (const client of list) {
        if ('focus' in client) {
          client.postMessage({ type: 'NOTIFICATION_CLICK', chatId: data.chatId || null });
          return client.focus();
        }
      }
      if (self.clients.openWindow) return self.clients.openWindow(targetUrl);
    })
  );
});
self.addEventListener('push', e => {
  let payload = { title: 'Alpine', body: 'Новое уведомление' };
  try {
    if (e.data) payload = Object.assign(payload, e.data.json ? e.data.json() : { body: e.data.text() });
  } catch (err) {}
  e.waitUntil(self.registration.showNotification(payload.title, {
    body: payload.body || '',
    icon: payload.icon,
    data: payload.data || {},
    tag: payload.tag || 'nivada-push',
    renotify: true
  }));
});
        `;
