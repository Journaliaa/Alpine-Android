    }
    .wall-repost-label .material-icons-round { font-size: 15px; color: #99a2ad; }
    .wall-quote {
      border: 1px solid #e7e8ec; border-radius: 4px;
      padding: 10px 12px; margin: 0 0 12px; background: #f5f6f8;
    }
    [data-theme="dark"] .wall-quote { background: #1a1a1a; border-color: #333; }
    .wall-quote-author { font-size: 12.5px; font-weight: 500; color: #2a5885; margin-bottom: 4px; }
    [data-theme="dark"] .wall-quote-author { color: #71aaeb; }
    .wall-quote-text { font-size: 12.5px; color: #000; white-space: pre-wrap; word-break: break-word; line-height: 1.4; }
    [data-theme="dark"] .wall-quote-text { color: #ccc; }
    .wall-comments {
      margin: 12px -15px -15px; padding: 12px 15px;
      background: #f5f6f8; border-top: 1px solid #e7e8ec; display: none;
    }
    [data-theme="dark"] .wall-comments { background: #1a1a1a; border-color: #333; }
    .wall-comments.open { display: block; }
    .wall-comment { display: flex; gap: 10px; margin-bottom: 12px; }
    .wall-comment-av {
      width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 11px; font-weight: 600;
