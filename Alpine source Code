    }
    function updatePinnedBar(chat) {
      const bar = document.getElementById('pinnedBar');
      const text = document.getElementById('pinnedBarText');
      if (!bar || !chat) return;
      const msg = chat.pinnedMsgId ? chat.messages.find(m => m.id === chat.pinnedMsgId) : null;
      if (msg) {
        bar.classList.add('show');
        text.textContent = (msg.text || msg.attachment?.name || 'Вложение').slice(0, 80);
        bar.onclick = () => {
          const el = document.querySelector(`.message[data-id="${msg.id}"]`);
          if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'center' }); el.classList.add('search-current'); setTimeout(() => el.classList.remove('search-current'), 1500); }
        };
      } else {
        bar.classList.remove('show');
        bar.onclick = null;
      }
    }
    function runChatSearch(q) {
      const chat = chats.find(c => String(c.id) === String(activeChatId));
      if (!chat) return;
      chatSearchHits = [];
      chatSearchIndex = 0;
      document.querySelectorAll('#messages .message').forEach(el => {
        el.classList.remove('search-hit', 'search-current');
      });
      if (!q.trim()) {
        document.getElementById('chatSearchCount').textContent = '';
        return;
      }
      const lower = q.toLowerCase();
      chat.messages.forEach(m => {
        if (m.system) return;
        if ((m.text || '').toLowerCase().includes(lower)) chatSearchHits.push(m.id);
      });
      chatSearchHits.forEach(id => {
        const el = document.querySelector(`.message[data-id="${id}"]`);
        if (el) el.classList.add('search-hit');
      });
      document.getElementById('chatSearchCount').textContent = chatSearchHits.length
        ? `${chatSearchHits.length ? 1 : 0}/${chatSearchHits.length}`
        : '0';
      if (chatSearchHits.length) focusSearchHit(0);
    }
    function focusSearchHit(idx) {
      if (!chatSearchHits.length) return;
      chatSearchIndex = ((idx % chatSearchHits.length) + chatSearchHits.length) % chatSearchHits.length;
      document.querySelectorAll('#messages .message.search-current').forEach(el => el.classList.remove('search-current'));
      const el = document.querySelector(`.message[data-id="${chatSearchHits[chatSearchIndex]}"]`);
      if (el) {
        el.classList.add('search-current');
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      document.getElementById('chatSearchCount').textContent = `${chatSearchIndex + 1}/${chatSearchHits.length}`;
    }
    function openChatSearch() {
      document.getElementById('chatSearchBar').classList.add('show');
      document.getElementById('chatSearchInput').value = '';
      document.getElementById('chatSearchInput').focus();
      document.getElementById('chatSearchCount').textContent = '';
