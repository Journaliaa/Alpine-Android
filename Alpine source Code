          try {
            chats = (typeof DEFAULT_CHATS !== 'undefined') ? JSON.parse(JSON.stringify(DEFAULT_CHATS)) : [];
          } catch (e) { chats = []; }
          posts = [];
          drafts = [];
          notifications = [];
