        };
        window.doLogin.__real2fa = true;
      }
    }
  }

  // ---------- Vault encryption hooks ----------
  function patchVaultCrypto() {
    if (typeof saveVaultRaw !== 'function' || saveVaultRaw.__enc) return;
    const origSave = saveVaultRaw;
    const origLoad = loadVaultRaw;
    window.saveVaultRaw = function (data) {
      // store encrypted blob in IDB when password known
      try {
        const plain = { passwordHash: data.passwordHash || '', photos: data.photos || [] };
        if (vaultSessionPassword && plain.photos.length) {
          encryptVaultPhotos(plain.photos, vaultSessionPassword).then(enc => {
            idbSet('vault_enc_' + ((currentUser && currentUser.username) || 'guest'), {
