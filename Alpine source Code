      el.classList.remove('show');
      el.setAttribute('aria-hidden', 'true');
      el.style.display = 'none';
    }
  }

  document.getElementById('obNext')?.addEventListener('click', () => {
    if (step === 0) {
      applyProfileFromOb();
      showStep(1);
      return;
    }
    if (step === 1) {
      const name = (document.getElementById('obName')?.value || '').trim();
      if (!name) {
        try { if (typeof toast === 'function') toast('Enter your name'); } catch (_) {}
        return;
      }
      applyProfileFromOb();
      showStep(2);
      return;
    }
    applyProfileFromOb();
    done();
  });
  document.getElementById('obSkip')?.addEventListener('click', () => { done(); });

  // Stagger wall posts when feed renders
  function staggerFeed(root) {
    const nodes = (root || document).querySelectorAll('.wall-post');
    nodes.forEach((el, i) => {
      el.style.animationDelay = Math.min(i * 0.04, 0.4) + 's';
    });
  }
  if (typeof renderGlobalWall === 'function' && !renderGlobalWall.__stagger) {
    const orig = renderGlobalWall;
    window.renderGlobalWall = function () {
      const r = orig.apply(this, arguments);
      try { staggerFeed(document.getElementById('globalWallPosts') || document.getElementById('globalWallFeed')); } catch (_) {}
      return r;
    };
    window.renderGlobalWall.__stagger = true;
  }
  if (typeof renderChatList === 'function' && !renderChatList.__stagger) {
    const orig = renderChatList;
    window.renderChatList = function () {
      const r = orig.apply(this, arguments);
      try {
        document.querySelectorAll('.chat-item').forEach((el, i) => {
          el.style.animation = 'tgFadeUp 0.28s cubic-bezier(0.22,1,0.36,1) both';
          el.style.animationDelay = Math.min(i * 0.03, 0.35) + 's';
        });
      } catch (_) {}
      return r;
    };
    window.renderChatList.__stagger = true;
  }

  window.openAlpineOnboarding = openOnboarding;
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootOb);
  else bootOb();
  setTimeout(() => {
    try {
      if (typeof renderGlobalWall === 'function' && !renderGlobalWall.__stagger) {/* patched above */}
    } catch (_) {}
  }, 1000);
})();
</script>


