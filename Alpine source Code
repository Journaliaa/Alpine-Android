    async function acquireCallMedia(withVideo) {
      try {
        if (!navigator.mediaDevices?.getUserMedia) return;
        // stop previous tracks
        if (callLocalStream) { callLocalStream.getTracks().forEach(t => t.stop()); }
        callLocalStream = await navigator.mediaDevices.getUserMedia({
          audio: {
            echoCancellation: true,
            noiseSuppression: true,
            autoGainControl: true,
            sampleRate: 48000
          },
          video: withVideo ? {
            facingMode: 'user',
            width: { ideal: 1280, min: 640 },
            height: { ideal: 720, min: 480 },
            frameRate: { ideal: 30, max: 30 }
          } : false
        });
        if (activeCall) {
          callLocalStream.getAudioTracks().forEach(t => { t.enabled = !activeCall.muted; });
        }
        const selfVideo = document.getElementById('callSelfVideo');
        const selfAv = document.getElementById('callTileSelfAv');
        if (withVideo && selfVideo) {
          selfVideo.srcObject = callLocalStream;
          selfVideo.style.display = 'block';
          if (selfAv) selfAv.style.display = 'none';
        } else if (selfVideo) {
          selfVideo.style.display = 'none';
          selfVideo.srcObject = null;
          if (selfAv) selfAv.style.display = '';
        }
        updateCallVideoPreview();
      } catch { /* permission denied — UI still works as demo */ }
    }
