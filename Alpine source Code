    async function doLogin() {
      showAuthError('');
      const u = (document.getElementById('loginUser')?.value || '').trim().toLowerCase();
      const p = document.getElementById('loginPass')?.value || '';
      if (!u || !p) { showAuthError('Enter username and password'); return false; }
      const list = loadAccounts();
      const acc = list.find(a =>
        a.username === u || (a.email && String(a.email).toLowerCase() === u)
      );
      if (!acc || !(await verifyAccountPassword(acc, p))) {
        showAuthError(list.length ? 'Wrong username or password' : 'No accounts yet — please sign up');
        return false;
      }
      // Direct login (OTP optional). Local/demo builds skip the extra code step.
      return loginUser({
        username: acc.username,
        name: acc.name || acc.username,
        email: acc.email || '',
        guest: false,
        provider: acc.provider || ''
      }, { fromCode: false });
    }

    function normalizeUsername(raw) {
      return String(raw || '').trim().replace(/^@/, '').toLowerCase().replace(/[^a-z0-9]/g, '');
    }
    function isValidUsername(u) {
      u = normalizeUsername(u);
      return /^[a-z0-9]{3,24}$/.test(u);
    }
    function isUsernameTaken(u, exceptSelf) {
      u = normalizeUsername(u);
      if (!u) return false;
      const self = exceptSelf ? normalizeUsername(exceptSelf) : normalizeUsername(profile && profile.username);
      try {
        const list = (typeof loadAccounts === 'function') ? loadAccounts() : [];
        if (list.some(a => normalizeUsername(a.username) === u && normalizeUsername(a.username) !== self)) return true;
      } catch (e) {}
      try {
        const cloud = (typeof loadCloud === 'function') ? loadCloud() : {};
        const profiles = cloud.profiles || {};
        for (const key of Object.keys(profiles)) {
          const pr = profiles[key] || {};
          const un = normalizeUsername(pr.username || key);
          if (un === u && un !== self) return true;
        }
      } catch (e) {}
      try {
        if (Array.isArray(peopleCatalog) && peopleCatalog.some(p => normalizeUsername(p.id) === u && normalizeUsername(p.id) !== self)) return true;
      } catch (e) {}
      try {
        if (Array.isArray(chats) && chats.some(c => c.peerId && normalizeUsername(c.peerId) === u && normalizeUsername(c.peerId) !== self)) return true;
      } catch (e) {}
      return false;
    }
    function validateUsernameOrToast(u, exceptSelf) {
      u = normalizeUsername(u);
      if (!isValidUsername(u)) {
        toast('Юзернейм: 6–8 символов, только латиница и цифры');
        return null;
      }
      if (isUsernameTaken(u, exceptSelf)) {
        toast('Этот @username уже занят');
        return null;
      }
      return u;
    }

    async function doRegister() {
      showAuthError('');
      const name = (document.getElementById('regName')?.value || '').trim();
      let username = (document.getElementById('regUser')?.value || '').trim().toLowerCase();
      const email = (document.getElementById('regEmail')?.value || '').trim().toLowerCase();
      const p1 = document.getElementById('regPass')?.value || '';
      const p2 = document.getElementById('regPass2')?.value || '';
      const regLang = document.getElementById('regLang')?.value || 'en';
      const regRegion = document.getElementById('regRegion')?.value || '';
      try { localStorage.setItem('appLang', regLang); } catch (e) {}
      if (!name || !username || !email || !p1) { showAuthError('Please fill in all fields'); return false; }
      username = normalizeUsername(username);
      if (!isValidUsername(username)) { showAuthError('Username: 3–24 letters or digits'); return false; }
      if (isUsernameTaken(username, null)) { showAuthError('This username is taken'); return false; }
      if (p1.length < 6) { showAuthError('Password must be at least 6 characters'); return false; }
      if (p1 !== p2) { showAuthError('Passwords do not match'); return false; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { showAuthError('Invalid email'); return false; }
      const list = loadAccounts();
      if (list.some(a => a.username === username)) { showAuthError('This username already exists'); return false; }
      if (list.some(a => String(a.email || '').toLowerCase() === email.toLowerCase())) { showAuthError('Email already registered'); return false; }
      let passwordRecord;
      try { passwordRecord = await createPasswordRecord(p1); } catch (e) { showAuthError(e.message || 'Could not secure password'); return false; }
      const user = { username, name, email, passwordRecord, createdAt: Date.now() };
      list.push(user);
      if (!saveAccounts(list)) return false;
      // Auto sign-in after successful registration
      return loginUser({ username, name, email, guest: false }, { fromCode: false });
