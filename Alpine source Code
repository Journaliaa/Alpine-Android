    }
    .wall-comment-form button:hover { background: #0066dd; }
    .wall-comment-form button:disabled { opacity: 0.5; cursor: default; }


    /* Subscriptions */
    .profile-social-stats {
      display: flex; gap: 20px; justify-content: center;
      margin: 8px 0 16px; padding: 0 8px;
    }
    .profile-social-stat {
      border: none; background: transparent; cursor: pointer;
      text-align: center; color: inherit; font: inherit; padding: 4px 8px;
      border-radius: 4px;
    }
    .profile-social-stat:hover { background: #f0f2f5; }
    .profile-social-stat strong { display: block; font-size: 16px; color: #2a5885; }
    .profile-social-stat span { font-size: 12px; color: #818c99; }
    .people-row {
      display: flex; align-items: center; gap: 12px;
      width: 100%; padding: 10px 4px; border: none; background: transparent;
      text-align: left; cursor: pointer; font: inherit; color: inherit;
      border-radius: 4px;
    }
    .people-row:hover { background: #f5f6f8; }
    .people-row .avatar { width: 48px; height: 48px; border-radius: 50%; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 600; }
    .people-row .meta { flex: 1; min-width: 0; }
    .people-row .meta strong { display: block; font-size: 14px; color: #2a5885; }
    .people-row .meta small { font-size: 12px; color: #818c99; }
    .people-follow-btn {
      border: none; border-radius: 4px; padding: 6px 12px; font-size: 13px;
      font-weight: 500; cursor: pointer; background: #0077ff; color: #fff; white-space: nowrap;
    }
    .people-follow-btn.following {
      background: #e7e8ec; color: #2c2d2e;
    }
    .people-follow-btn:hover { filter: brightness(0.95); }

    /* ===== Hamburger drawer ===== */
    .drawer-overlay {
      position: fixed; inset: 0; z-index: 9000;
      background: var(--md-sys-color-scrim);
      opacity: 0; pointer-events: none;
      transition: opacity 0.25s;
    }
    .drawer-overlay.show { opacity: 1; pointer-events: auto; }
    .tg-drawer {
      position: fixed; top: 0; left: 0; bottom: 0; z-index: 9010;
      width: min(300px, 86vw);
      background: var(--md-sys-color-surface-container);
      transform: translateX(-105%);
      transition: transform 0.3s cubic-bezier(0.2, 0, 0, 1);
      display: flex; flex-direction: column;
      box-shadow: 4px 0 24px rgba(0,0,0,0.18);
      pointer-events: auto;
    }
    .tg-drawer.show { transform: translateX(0); }
    .drawer-profile {
      padding: 28px 16px 18px;
      background: linear-gradient(145deg,
        color-mix(in srgb, var(--md-sys-color-primary) 22%, var(--md-sys-color-surface-container)),
        var(--md-sys-color-surface-container));
      cursor: pointer;
      border: none; width: 100%; text-align: left; color: inherit; font: inherit;
    }
    .drawer-profile:hover { filter: brightness(1.03); }
    .drawer-profile .drawer-av {
      width: 64px; height: 64px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 22px; font-weight: 600;
      margin-bottom: 12px; background-size: cover; background-position: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    .drawer-profile .drawer-av.has-photo { color: transparent; font-size: 0; }
    .drawer-profile strong { display: block; font-size: 17px; font-weight: 600; }
    .drawer-profile small { display: block; font-size: 13px; color: var(--md-sys-color-on-surface-variant); margin-top: 3px; }
    .drawer-nav { flex: 1; overflow-y: auto; padding: 8px 0; }
    .drawer-item {
      display: flex; align-items: center; gap: 18px;
      width: 100%; padding: 14px 20px; border: none; background: transparent;
      color: var(--md-sys-color-on-surface); font: inherit; font-size: 15px;
      cursor: pointer; text-align: left; transition: background 0.12s;
    }
    .drawer-item:hover { background: color-mix(in srgb, var(--md-sys-color-on-surface) 6%, transparent); }
    .drawer-item:active { background: color-mix(in srgb, var(--md-sys-color-on-surface) 10%, transparent); }
    .drawer-item .material-icons-round { font-size: 22px; color: var(--md-sys-color-on-surface-variant); width: 24px; text-align: center; }
    .drawer-item.danger { color: var(--md-sys-color-error); }
    .drawer-item.danger .material-icons-round { color: var(--md-sys-color-error); }

    .drawer-ghost-item { align-items: center; }
    .drawer-ghost-pill {
      margin-left: auto; font-size: 12px; font-weight: 600;
      padding: 4px 10px; border-radius: 999px;
      background: color-mix(in srgb, var(--md-sys-color-on-surface) 10%, transparent);
      color: var(--md-sys-color-on-surface-variant);
    }
    .drawer-ghost-item.is-on .drawer-ghost-pill {
      background: color-mix(in srgb, var(--md-sys-color-primary, #DA291C) 18%, transparent);
      color: var(--md-sys-color-primary, #DA291C);
    }

    .drawer-ghost-icon {
      width: 24px; height: 24px;
      display: inline-flex; align-items: center; justify-content: center;
      color: var(--md-sys-color-on-surface-variant);
      flex-shrink: 0;
    }
    .drawer-ghost-icon svg { display: block; }
    .drawer-ghost-item.is-on .drawer-ghost-icon {
      color: var(--md-sys-color-primary, #DA291C);
    }
.drawer-divider { height: 1px; background: var(--md-sys-color-outline-variant); margin: 6px 16px; }
    .drawer-footer {
      padding: 12px 20px 16px; font-size: 12px;
      color: var(--md-sys-color-on-surface-variant);
      border-top: 1px solid var(--md-sys-color-outline-variant);
    }
    /* Hide old footer profile on sidebar — menu has it */
    .sidebar-footer { display: none; }

    /* In-chat search bar */
    .chat-search-bar {
      display: none; align-items: center; gap: 6px;
      padding: 8px 12px; background: var(--md-sys-color-surface-container);
      border-bottom: 1px solid var(--md-sys-color-outline-variant);
    }
    .chat-search-bar.show { display: flex; }
    .chat-search-bar input {
      flex: 1; height: 40px; border: none; border-radius: 20px;
      background: var(--md-sys-color-surface-container-highest);
      padding: 0 14px; font-size: 15px; color: var(--md-sys-color-on-surface); outline: none;
    }
    .chat-search-bar .search-count { font-size: 12px; color: var(--md-sys-color-on-surface-variant); white-space: nowrap; min-width: 48px; text-align: center; }
    .message.search-hit .bubble { outline: 2px solid var(--md-sys-color-primary); }
    .message.search-current .bubble { outline: 2px solid var(--md-sys-color-tertiary); box-shadow: 0 0 0 4px color-mix(in srgb, var(--md-sys-color-primary) 25%, transparent); }

    /* Pinned message bar */
    .pinned-bar {
      display: none; align-items: center; gap: 10px;
      padding: 8px 14px; background: var(--md-sys-color-secondary-container);
      color: var(--md-sys-color-on-secondary-container);
      cursor: pointer; border-bottom: 1px solid var(--md-sys-color-outline-variant);
      font-size: 13px;
    }
    .pinned-bar.show { display: flex; }
    .pinned-bar .material-icons-round { font-size: 18px; color: var(--md-sys-color-primary); }
    .pinned-bar-text { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* Offline banner */
    .offline-banner {
      display: none; align-items: center; justify-content: center; gap: 8px;
      padding: 8px; background: var(--md-sys-color-error-container);
      color: var(--md-sys-color-on-error, #410002); font-size: 13px; font-weight: 500;
      position: sticky; top: 0; z-index: 15;
    }
    .offline-banner.show { display: flex; }
    [data-theme="dark"] .offline-banner { color: #ffdad6; }

    /* Reaction picker */
    .reaction-picker {
      position: fixed; z-index: 210;
      background: var(--md-sys-color-surface-container-high);
      border-radius: 24px; padding: 8px;
      display: none; gap: 2px; box-shadow: 0 4px 20px rgba(0,0,0,0.25);
      animation: ctxIn 0.15s ease;
    }
    .reaction-picker.show { display: flex; }
    .reaction-picker button {
      width: 40px; height: 40px; border: none; background: transparent;
      font-size: 22px; cursor: pointer; border-radius: 50%;
    }
    .reaction-picker button:hover { background: color-mix(in srgb, var(--md-sys-color-on-surface) 10%, transparent); }

    /* Group badge in chat list */
    .chat-name .group-badge {
      font-size: 14px; vertical-align: middle; margin-right: 2px;
      color: var(--md-sys-color-primary);
    }


    /* ===== Responsive / all devices ===== */
    html { -webkit-text-size-adjust: 100%; }
    body {
      padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
    }
    .app { width: 100%; }
    .icon-btn, .send-btn, .chat-folder-chip, .wall-action-btn, .people-follow-btn {
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    .icon-btn { min-width: 44px; min-height: 44px; }
    @media (max-width: 900px) {
      .sidebar { width: 100%; min-width: 0; max-width: none; }
      .chat-area { width: 100%; }
      .wall-feed { max-width: 100%; padding: 12px 10px 32px; }
      .app.wall-mode .wall-feed { max-width: 100%; padding: 12px 10px 40px; }
      .wall-page-header, .panel-header, .sidebar-header, .chat-header {
        padding-left: max(8px, env(safe-area-inset-left));
        padding-right: max(8px, env(safe-area-inset-right));
      }
      .input-area {
        padding-bottom: max(8px, env(safe-area-inset-bottom));
      }
      .wall-action-btn .vk-action-label { font-size: 12px; }
      .wall-post-actions { flex-wrap: wrap; }
      .wall-action-btn { min-height: 44px; padding: 8px 4px; }
      .side-panel .panel-body { padding: 12px 10px 28px; max-width: 100%; }
      .settings-section .setting-row {
        flex-wrap: wrap; gap: 8px;
      }
      .mini-select, .settings-section input[type="text"],
      .settings-section input[type="number"],
      .settings-section input[type="time"] {
        max-width: 100%; width: 100%;
      }
      .modal { width: calc(100% - 24px); max-width: 420px; margin: 12px; }
      .chat-folders { padding: 8px 10px; }
      .proxy-status-bar, .dnd-banner {
        padding-left: max(12px, env(safe-area-inset-left));
        padding-right: max(12px, env(safe-area-inset-right));
      }
    }
    @media (max-width: 480px) {
      .wall-action-btn .vk-action-label { display: none; }
      .wall-post-avatar { width: 40px; height: 40px; font-size: 14px; }
      .wall-composer-av { width: 36px; height: 36px; font-size: 13px; }
      .wall-page-header h2, .sidebar-header h1 { font-size: 16px; }
      .empty-state h2 { font-size: 18px; }
      .message { max-width: 92%; }
      .fab { right: 16px; bottom: max(16px, env(safe-area-inset-bottom)); }
    }
    @media (min-width: 901px) and (max-width: 1199px) {
      .sidebar { width: 340px; min-width: 300px; }
      .wall-feed { max-width: 640px; }
    }
    @media (min-width: 1200px) {
      .wall-feed, .app.wall-mode .wall-feed { max-width: 720px; }
    }
    @media (orientation: landscape) and (max-height: 500px) {
      .wall-page-header, .chat-header, .sidebar-header, .panel-header { height: 48px; }
      .empty-state .brand-logo-lg, .empty-state .material-icons-round { font-size: 48px !important; width: 48px; height: 48px; }
    }


    /* Free Music + MD3 player */
    .music-page {
      display: none; flex-direction: column; height: 100%;
      background: var(--md-sys-color-surface);
    }
    .music-page.show { display: flex; }
    .music-page-header {
      height: 56px; display: flex; align-items: center; gap: 8px;
      padding: 0 12px; background: var(--md-sys-color-surface-container-lowest);
      border-bottom: 1px solid var(--md-sys-color-outline-variant); flex-shrink: 0;
    }
    .music-page-header h2 { font-size: 18px; font-weight: 600; flex: 1; }
    .music-body { flex: 1; overflow-y: auto; padding: 16px; max-width: 720px; width: 100%; margin: 0 auto; box-sizing: border-box; }
    .music-tabs { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
    .music-tab {
      border: none; border-radius: 20px; padding: 8px 16px; font: inherit; font-size: 13px;
      font-weight: 500; cursor: pointer; background: var(--md-sys-color-secondary-container);
      color: var(--md-sys-color-on-secondary-container);
    }
    .music-tab.active { background: var(--md-sys-color-primary); color: var(--md-sys-color-on-primary); }
