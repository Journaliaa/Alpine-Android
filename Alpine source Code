      }
      proxyEnabled = false;
      proxyConfig.connected = false;
      proxyConfig._error = true;
      exitIpInfo = null;
      saveData();
      updateProxyUI();
      updateProxyIpCard();
      updateAccessBlockBanner();
      toast('Релеи недоступны: ' + (lastErr && lastErr.message ? lastErr.message : 'сеть/CORS'));
      return false;
    }

    async function refreshProxyPing() {
      if (!proxyEnabled || !proxyConfig.connected) { toast('Сначала подключите прокси'); return; }
      const badge = document.getElementById('proxySettingsPing');
      if (badge) badge.textContent = '…';
      try {
        const exit = await probeExitIp(proxyConfig.relay || activeRelayId || 'allorigins');
        exitIpInfo = exit;
        proxyConfig.ping = exit.ping;
        proxyConfig.lastCheck = Date.now();
        saveData();
        updateProxyUI();
        updateProxyIpCard();
        updateAccessBlockBanner();
        toast('Пинг: ' + exit.ping + ' мс · exit ' + exit.ip);
      } catch (e) {
        toast('Пинг не удался: ' + (e && e.message ? e.message : e));
      }
    }
    function disconnectProxy() {
      if (typeof isProxyFeatureEnabled === "function" && !isProxyFeatureEnabled()) { updateProxyUI(); return; }
      try { proxyLog('Отключение релей'); } catch (e) {}
      proxyEnabled = false;
      proxyConfig.connected = false;
      proxyConfig._error = false;
      exitIpInfo = null;
      activeRelayId = null;
      circumventionActive = false;
      saveData();
      updateProxyUI();
      try { updateProxyIpCard(); } catch (e) {}
      try { updateAccessBlockBanner(); } catch (e) {}
      toast('Прокси отключён');
    }


