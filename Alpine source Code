    async function toggleScreenShare() {
      if (!activeCall || activeCall.status !== 'active') return;
      const btn = document.getElementById('callScreenBtn');
      if (activeCall.screenOn && callScreenStream) {
        callScreenStream.getTracks().forEach(t => t.stop());
        callScreenStream = null;
        activeCall.screenOn = false;
        btn?.classList.remove('active-green');
        updateCallVideoPreview();
        toast('Демонстрация экрана остановлена');
        return;
      }
      try {
        callScreenStream = await navigator.mediaDevices.getDisplayMedia({ video: true, audio: false });
        activeCall.screenOn = true;
        btn?.classList.add('active-green');
        const prev = document.getElementById('callVideoPreview');
        if (prev) {
          let v = prev.querySelector('video');
          if (!v) {
            v = document.createElement('video');
            v.autoplay = true; v.muted = true; v.playsInline = true;
            prev.innerHTML = ''; prev.appendChild(v);
          }
          v.srcObject = callScreenStream;
          prev.classList.add('show');
        }
        callScreenStream.getVideoTracks()[0].onended = () => {
          activeCall && (activeCall.screenOn = false);
          callScreenStream = null;
          btn?.classList.remove('active-green');
          updateCallVideoPreview();
        };
        toast('Демонстрация экрана');
