    function upsertGoogleAccount(verifiedUser) {
      const username = 'google_' + String(verifiedUser.sub).slice(-12).toLowerCase();
      const list = loadAccounts();
      let account = list.find(a => a.provider === 'google' && a.googleSub === verifiedUser.sub);
