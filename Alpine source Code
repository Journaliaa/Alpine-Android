    }
    function serviceBotReply(userText) {
      const t = (userText || '').toLowerCase().trim();
      if (!t) return 'Напишите «помощь», чтобы увидеть список команд.';
      if (/помощ|help|команд|меню/.test(t)) {
        return 'Команды службы:\n• помощь — это меню\n• безопасность — советы по защите аккаунта\n• код — как работают коды входа\n• архив — про автоархив незнакомцев\n• статус — состояние аккаунта\n• версия — о приложении';
      }
      if (/безопас|парол|сеанс|взлом/.test(t)) {
        return 'Безопасность:\n1) Не сообщайте код из этого чата.\n2) Завершайте чужие сеансы в Настройках → Устройства.\n3) Используйте длинный пароль.\n4) При подозрительном входе смените пароль сразу.';
      }
      if (/код|login|вход/.test(t)) {
        return 'Login codes are created when you sign in and appear here. They are one-time and only for you.';
      }
      if (/архив|незнаком/.test(t)) {
        return autoArchiveUnknown
          ? 'Автоархив включён: новые чаты от незнакомцев сразу попадают в архив без уведомлений. Откройте архив в списке чатов или выключите опцию в настройках.'
          : 'Автоархив выключен. Включите «Архивировать чаты с незнакомцами» в настройках, чтобы новые диалоги от неизвестных сразу уходили в архив.';
      }
      if (/статус|аккаунт|профиль/.test(t)) {
        const u = (currentUser && currentUser.username) || profile.username || '—';
        const n = profile.name || (currentUser && currentUser.name) || '—';
        return 'Аккаунт: ' + n + ' (@' + u + ')\nГость: ' + (currentUser && currentUser.guest ? 'да' : 'нет') + '\nСессия активна в этом браузере.';
      }
      if (/верси|about|о приложен/.test(t)) {
        return 'Alpine · local client\nChats · feed · notification service\nOfficial messages only appear in this chat.';
      }
      if (/прив|здрав|hello|\bhi\b/.test(t)) {
        return 'Hello! I am Alpine Service. Type “help” if you need a tip.';
      }
      return 'Служба приняла сообщение. Напишите «помощь» для списка команд. Для поддержки аккаунта откройте Настройки → Безопасность.';
    }
    function handleServiceUserMessage(chat, userText) {
      if (!chat || chat.type !== 'service') return;
      setTimeout(() => {
        const reply = {
          id: ++msgIdCounter,
          text: serviceBotReply(userText),
          outgoing: false,
          time: Date.now(),
          service: true,
          reactions: []
        };
        chat.messages.push(reply);
        if (String(activeChatId) !== String(chat.id)) chat.unread = (chat.unread || 0) + 1;
        saveData();
        try { renderChatList(); } catch (e) {}
        if (String(activeChatId) === String(chat.id)) {
          try { renderMessages(chat); } catch (e) {}
        }
      }, 400 + Math.random() * 500);
    }


    function ensureNotesChat() {
      // «Заметки себе» отключены — удаляем, если остались в данных
      const before = chats.length;
      chats = chats.filter(c => c.id !== 'notes_self' && c.type !== 'notes' && c.name !== 'Заметки себе');
      if (chats.length !== before) {
        try { saveData(); } catch (e) {}
      }
      if (activeChatId === 'notes_self' || (typeof activeChatId === 'string' && String(activeChatId).includes('notes'))) {
        activeChatId = null;
        try {
