    function isKnownContactChat(chat) {
      if (!chat) return false;
      if (chat.type === 'service' || chat.type === 'bookmarks' || chat.type === 'notes') return true;
      if (chat.type === 'group' || chat.type === 'channel') return true;
      if (chat.favorite || chat.pinned || chat.isContact) return true;
      const out = (chat.messages || []).filter(m => m && m.outgoing && !m.system).length;
      return out >= 2;
    }
    function maybeAutoArchiveChat(chat) {
      if (!autoArchiveUnknown || !chat) return false;
      if (chat.type !== 'private') return false;
