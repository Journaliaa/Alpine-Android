    });
    document.getElementById('drawerChatsBtn')?.addEventListener('click', function () {
      setTimeout(openMessagesFixed, 50);
    });
    setTimeout(nukeRemovedUI, 500);
    setTimeout(nukeRemovedUI, 2000);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>


<script>
/* Avatar + chat white screen hard fix */
(function () {
  function forceChatUI(chat) {
    document.body.classList.add('chat-conversation-open');
    document.body.classList.remove('wall-mode');
    document.documentElement.classList.remove('wall-mode');
    document.querySelector('.app')?.classList.remove('wall-mode');
    document.getElementById('wallPage')?.classList.remove('show');
    const ac = document.getElementById('activeChat');
    if (ac) {
      ac.classList.add('is-chat-open');
      ac.style.cssText = 'display:flex!important;flex-direction:column!important;visibility:visible!important;opacity:1!important;height:100%!important;min-height:100dvh!important;width:100%!important;background:var(--md-sys-color-surface,#0e1621)!important;z-index:30!important;';
    }
    const es = document.getElementById('emptyState');
    if (es) es.style.display = 'none';
    const side = document.getElementById('sidebar');
    if (side && window.matchMedia('(max-width:900px)').matches) {
      side.classList.add('hidden');
      side.style.display = 'none';
    }
    const msgs = document.getElementById('messages');
    if (msgs) {
      msgs.style.cssText = 'display:flex!important;flex-direction:column!important;flex:1!important;min-height:240px!important;overflow-y:auto!important;visibility:visible!important;padding:12px!important;';
    }
    const hn = document.getElementById('headerName');
    if (hn && chat) hn.textContent = chat.name || 'Chat';
    // Always paint something in messages
    if (msgs && chat) {
      if (!Array.isArray(chat.messages)) chat.messages = [];
      try {
        if (typeof renderMessages === 'function') renderMessages(chat);
      } catch (e) { console.warn(e); }
      if (!msgs.innerHTML || msgs.innerHTML.trim().length < 8) {
        if (typeof simpleRenderMessages === 'function') {
          try { simpleRenderMessages(chat); } catch (e) {}
        }
      }
      if (!msgs.innerHTML || msgs.innerHTML.trim().length < 8) {
        msgs.innerHTML = chat.messages && chat.messages.length
          ? chat.messages.map(m => {
              const out = m.outgoing ? 'flex-end' : 'flex-start';
              const bg = m.outgoing ? '#2AABEE' : '#182533';
              const t = (m.text || '').replace(/</g,'&lt;') || '·';
              return '<div style="display:flex;justify-content:'+out+';margin:4px 0"><div style="max-width:80%;padding:8px 12px;border-radius:12px;background:'+bg+';color:#fff;font-size:15px">'+t+'</div></div>';
            }).join('')
          : '<div style="margin:auto;text-align:center;color:#8b98a5;padding:40px 16px">Нет сообщений<br><span style="font-size:13px">Напишите первое сообщение</span></div>';
      }
      try { msgs.scrollTop = msgs.scrollHeight; } catch (_) {}
    }
  }

  function wrapOpenChat() {
    if (typeof openChat !== 'function' || openChat.__whiteFix) return;
    const orig = openChat;
    window.openChat = function (id) {
      let chat = null;
      try { chat = (chats || []).find(c => String(c.id) === String(id)); } catch (_) {}
      try { forceChatUI(chat); } catch (_) {}
      let r;
      try { r = orig.apply(this, arguments); } catch (e) { console.error(e); }
      try {
        chat = (chats || []).find(c => String(c.id) === String(id)) || chat;
        forceChatUI(chat);
      } catch (e) { console.error(e); }
      requestAnimationFrame(() => { try { forceChatUI(chat); } catch (_) {} });
      setTimeout(() => { try { forceChatUI(chat); } catch (_) {} }, 50);
      return r;
    };
    window.openChat.__whiteFix = true;
  }

  // Extra avatar click bindings (profile may open late)
  function bindAvatar() {
    const btn = document.getElementById('profilePhotoBtn');
    const input = document.getElementById('profilePhotoInput');
    const av = document.getElementById('profilePreviewAvatar');
    if (input && !input.__avatarBound) {
      input.__avatarBound = true;
      // keep existing change listeners; add fallback
      input.addEventListener('change', async function (e) {
        if (e.target.__handled) return;
        const file = e.target.files && e.target.files[0];
        if (!file || !file.type.startsWith('image/')) return;
        // if main handler already applied photo within 300ms, skip
      });
    }
    if (btn && !btn.__avatarBound) {
      btn.__avatarBound = true;
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        input && input.click();
      }, true);
    }
    if (av && !av.__avatarBound) {
      av.__avatarBound = true;
      av.style.cursor = 'pointer';
      av.title = 'Сменить фото';
      av.addEventListener('click', function () { input && input.click(); });
    }
  }

  function boot() {
    wrapOpenChat();
    bindAvatar();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(boot, 400);
  setTimeout(boot, 1500);
})();
</script>




