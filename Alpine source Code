      max-width: 360px; line-height: 1.35;
    }
    .community-stub p {
      font-size: 14px; color: var(--md-sys-color-on-surface-variant);
      max-width: 340px; line-height: 1.45;
    }


    /* classic banner: image strip only, content below on surface */
    .profile-badges {
      display: flex; flex-wrap: wrap; gap: 6px; justify-content: center;
      margin: 6px 0 4px;
    }
    .profile-badge {
      display: inline-flex; align-items: center; gap: 4px;
      font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 999px;
      background: color-mix(in srgb, var(--md-sys-color-primary) 14%, transparent);
      color: var(--md-sys-color-primary);
    }
    .profile-badge .material-icons-round { font-size: 14px; }
    .profile-badge.verified { background: #e3f2fd; color: #1565c0; }
    .profile-badge.creator { background: #f3e5f5; color: #7b1fa2; }
    .profile-badge.early { background: #e8f5e9; color: #2e7d32; }
    [data-theme="dark"] .profile-badge.verified { background: #0d47a1; color: #90caf9; }
    [data-theme="dark"] .profile-badge.creator { background: #4a148c; color: #e1bee7; }
    [data-theme="dark"] .profile-badge.early { background: #1b5e20; color: #a5d6a7; }
    .profile-username {
      text-align: center; font-size: 13px; color: var(--md-sys-color-primary);
      font-weight: 500; margin-top: 2px;
    }
    .profile-presence {
      text-align: center; font-size: 12px; color: var(--md-sys-color-on-surface-variant);
      margin-top: 2px;
    }
    .profile-presence.online { color: #2e7d32; font-weight: 500; }
    .profile-action-row {
      display: flex; gap: 8px; margin: 12px 0; flex-wrap: wrap;
    }
    .profile-action-row .btn { flex: 1; min-width: 120px; justify-content: center; }
    .profile-links {
      display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;
      margin: 8px 0 12px;
    }
    .profile-link-chip {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 12px; border-radius: 999px; text-decoration: none;
      font-size: 13px; font-weight: 500;
      background: var(--md-sys-color-secondary-container);
      color: var(--md-sys-color-on-secondary-container);
    }
    .profile-link-chip:hover { filter: brightness(0.97); }
    .profile-link-chip .material-icons-round { font-size: 16px; }
    .profile-private-note {
      text-align: center; padding: 16px; border-radius: 12px;
      background: var(--md-sys-color-surface-container); font-size: 13px;
      color: var(--md-sys-color-on-surface-variant); margin: 12px 0;
    }
    #profilePanelBody, #viewProfilePanel .panel-body {
      --profile-theme-a: #0077ff;
      --profile-theme-b: #6b4fa0;
    }


    .info-avatar.default-avatar,
    .wall-composer-av.default-avatar {
      background: #c4c4c4 !important;
      color: #fff;
      position: relative;
      overflow: hidden;
    }
    .info-avatar.default-avatar::after,
    .wall-composer-av.default-avatar::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 50% 38%, #fff 0 22%, transparent 23%),
        radial-gradient(circle at 50% 110%, #fff 0 42%, transparent 43%);
      opacity: 0.95;
    }
    .info-avatar.has-photo::after,
    .wall-composer-av.has-photo::after { display: none; }
    .profile-banner.default-banner {
      background: #c4c4c4 !important;
      background-image: none !important;
    }
    .profile-verify-mark {
      display: inline-flex; align-items: center; justify-content: center;
      width: 18px; height: 18px; border-radius: 50%;
      background: #1d9bf0; color: #fff; font-size: 12px;
      margin-left: 4px; vertical-align: middle;
    }
    .profile-verify-mark .material-icons-round { font-size: 14px; line-height: 1; }
    .profile-username { display: flex; align-items: center; justify-content: center; gap: 2px; }
    .name-with-verify {
      display: inline-flex; align-items: center; gap: 4px; flex-wrap: wrap;
    }
    .drawer-profile strong.name-with-verify,
    #drawerName.name-with-verify {
      display: inline-flex; align-items: center; gap: 4px;
    }
    .drawer-profile .drawer-userline {
      display: flex; flex-direction: column; align-items: flex-start; gap: 2px; min-width: 0;
    }
    .drawer-profile .drawer-userline .drawer-nick {
      font-size: 12px; font-weight: 500; opacity: 0.85;
      display: inline-flex; align-items: center; gap: 4px;
    }



    /* Notifications */
    .notif-panel {
      position: absolute; top: 56px; right: 8px; width: min(360px, 94vw);
      max-height: 70vh; overflow-y: auto; z-index: 80;
      background: var(--md-sys-color-surface-container-lowest);
      border: 1px solid var(--md-sys-color-outline-variant);
      border-radius: 16px; box-shadow: 0 12px 40px rgba(0,0,0,.18);
      display: none; flex-direction: column;
    }
    .notif-panel.show { display: flex; }
    .notif-panel-head {
      display: flex; align-items: center; padding: 12px 14px;
      border-bottom: 1px solid var(--md-sys-color-outline-variant);
      font-weight: 600; font-size: 14px;
    }
    .notif-panel-head .btn-text { margin-left: auto; font-size: 12px; }
    .notif-item {
      display: flex; gap: 10px; padding: 12px 14px; cursor: pointer;
      border-bottom: 1px solid color-mix(in srgb, var(--md-sys-color-outline-variant) 50%, transparent);
    }
    .notif-item:hover { background: color-mix(in srgb, var(--md-sys-color-on-surface) 5%, transparent); }
    .notif-item.unread { background: color-mix(in srgb, var(--md-sys-color-primary) 8%, transparent); }
    .notif-item .n-body { flex: 1; min-width: 0; font-size: 13px; }
    .notif-item .n-body small { display: block; color: var(--md-sys-color-on-surface-variant); margin-top: 2px; }
    .notif-badge {
      position: absolute; top: 6px; right: 6px; min-width: 16px; height: 16px;
      padding: 0 4px; border-radius: 8px; background: #e53935; color: #fff;
      font-size: 10px; font-weight: 700; display: none; align-items: center; justify-content: center;
    }
    .notif-badge.show { display: flex; }
    .icon-btn.rel { position: relative; }
    /* Emoji panel */
    .emoji-panel {
      display: none; position: absolute; bottom: 100%; left: 8px; right: 8px;
      max-height: 200px; overflow-y: auto; z-index: 40;
      background: var(--md-sys-color-surface-container);
      border: 1px solid var(--md-sys-color-outline-variant);
      border-radius: 16px; padding: 8px; margin-bottom: 6px;
      grid-template-columns: repeat(8, 1fr); gap: 2px;
    }
    .emoji-panel.show { display: grid; }
    .emoji-panel button {
      border: none; background: transparent; font-size: 22px; padding: 6px;
      cursor: pointer; border-radius: 8px; line-height: 1;
    }
    .emoji-panel button:hover { background: color-mix(in srgb, var(--md-sys-color-on-surface) 8%, transparent); }
    .input-area { position: relative; }
    /* Voice message */
    .voice-msg {
      display: flex; align-items: center; gap: 10px; min-width: 180px; max-width: 260px;
      padding: 6px 4px;
    }
    .voice-msg .wave {
      flex: 1; height: 28px; display: flex; align-items: center; gap: 2px;
    }
    .voice-msg .wave span {
      width: 3px; border-radius: 2px; background: currentColor; opacity: 0.7;
      animation: wavePulse 1s ease-in-out infinite alternate;
    }
    @keyframes wavePulse { from { transform: scaleY(0.4); } to { transform: scaleY(1); } }
    .voice-rec-bar {
      display: none; align-items: center; gap: 10px; padding: 8px 12px;
      background: color-mix(in srgb, var(--md-sys-color-error) 12%, transparent);
      color: var(--md-sys-color-error); font-size: 13px; font-weight: 500;
    }
    .voice-rec-bar.show { display: flex; }
    .voice-rec-bar .dot {
      width: 10px; height: 10px; border-radius: 50%; background: currentColor;
      animation: blink 1s step-end infinite;
    }
    @keyframes blink { 50% { opacity: 0; } }
    /* Forward / QR modals extras */
    .forward-chat-item {
      display: flex; align-items: center; gap: 12px; padding: 10px 12px;
      border-radius: 12px; cursor: pointer; border: none; width: 100%;
      background: transparent; font: inherit; text-align: left; color: inherit;
    }
    .forward-chat-item:hover { background: color-mix(in srgb, var(--md-sys-color-on-surface) 6%, transparent); }
    .forward-chat-item .av {
      width: 40px; height: 40px; border-radius: 50%; display: flex;
      align-items: center; justify-content: center; color: #fff; font-weight: 600; flex-shrink: 0;
    }
    .qr-box { text-align: center; padding: 12px; }
    .qr-box img { width: 200px; height: 200px; border-radius: 12px; background: #fff; }
    .qr-box code { display: block; margin-top: 10px; font-size: 12px; word-break: break-all; opacity: 0.8; }


    /* Expanded music player */
    .md3-player.expanded {
      padding-bottom: max(16px, env(safe-area-inset-bottom));
    }
    .md3-player.expanded .md3-player-extra { display: flex; }
    .md3-player-extra {
      display: none; flex-direction: column; gap: 8px; margin-top: 4px;
    }
    .md3-player .expand-hit { cursor: pointer; flex: 1; min-width: 0; }
    .music-sort-bar { display: flex; gap: 6px; margin-bottom: 12px; flex-wrap: wrap; }
    .music-sort-bar button {
      border: none; border-radius: 16px; padding: 6px 12px; font: inherit; font-size: 12px;
      cursor: pointer; background: var(--md-sys-color-secondary-container);
      color: var(--md-sys-color-on-secondary-container);
    }
    .music-sort-bar button.active { background: var(--md-sys-color-primary); color: var(--md-sys-color-on-primary); }
    .proxy-ip-card {
      border-radius: 12px; padding: 12px; margin: 8px 0 12px;
      background: var(--md-sys-color-surface-container); font-size: 13px;
    }
    .proxy-ip-card strong { display: block; margin-bottom: 4px; }
    .proxy-ip-card .ip-line { font-family: ui-monospace, monospace; font-size: 12px; opacity: 0.9; }
    .wall-owner-actions { display: flex; gap: 4px; margin-left: auto; }



    /* ===== UI animations ===== */
    @media (prefers-reduced-motion: no-preference) {
      html { scroll-behavior: smooth; }

      .icon-btn {
        transition: background 0.18s ease, transform 0.15s ease, opacity 0.15s ease !important;
      }
      .icon-btn:active { transform: scale(0.88); }

      .btn, .btn-filled, .btn-text, .send-btn, .people-follow-btn, .wall-action-btn {
        transition: transform 0.15s ease, background 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease, filter 0.15s !important;
      }
      .btn:active, .btn-filled:active, .send-btn:active, .people-follow-btn:active {
        transform: scale(0.96);
      }

      .chat-item {
        transition: background 0.18s ease, transform 0.2s ease, opacity 0.25s ease !important;
        animation: tgListIn 0.32s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      }
      .chat-item:nth-child(1) { animation-delay: 0.02s; }
      .chat-item:nth-child(2) { animation-delay: 0.04s; }
      .chat-item:nth-child(3) { animation-delay: 0.06s; }
      .chat-item:nth-child(4) { animation-delay: 0.08s; }
      .chat-item:nth-child(5) { animation-delay: 0.1s; }
      .chat-item:nth-child(6) { animation-delay: 0.12s; }
      .chat-item:nth-child(n+7) { animation-delay: 0.14s; }
      .chat-item:active { transform: scale(0.99); }

      @keyframes tgListIn {
        from { opacity: 0; transform: translateX(-10px); }
        to { opacity: 1; transform: none; }
      }

      .message {
        animation: tgMsgIn 0.28s cubic-bezier(0.2, 0.9, 0.3, 1) both;
      }
      .message.outgoing { animation-name: tgMsgOut; }
      @keyframes tgMsgIn {
        from { opacity: 0; transform: translateY(10px) scale(0.96); }
        to { opacity: 1; transform: none; }
      }
      @keyframes tgMsgOut {
        from { opacity: 0; transform: translateY(12px) scale(0.94); }
        to { opacity: 1; transform: none; }
      }
      .message .bubble {
        transition: box-shadow 0.2s ease, transform 0.15s ease !important;
      }
      .message .bubble:active { transform: scale(0.98); }

      .wall-post {
        animation: tgPostIn 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) both;
        transition: box-shadow 0.22s ease, transform 0.2s ease, border-color 0.2s ease !important;
      }
      .wall-post:nth-child(1) { animation-delay: 0.03s; }
      .wall-post:nth-child(2) { animation-delay: 0.06s; }
      .wall-post:nth-child(3) { animation-delay: 0.09s; }
      .wall-post:nth-child(4) { animation-delay: 0.12s; }
      .wall-post:nth-child(n+5) { animation-delay: 0.15s; }
      @keyframes tgPostIn {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: none; }
      }
      .wall-post:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
      .wall-action-btn:active { transform: scale(0.9); }
      .wall-action-btn.liked .material-icons-round {
        animation: tgHeart 0.45s cubic-bezier(0.2, 0.9, 0.3, 1);
      }
      @keyframes tgHeart {
        0% { transform: scale(1); }
        35% { transform: scale(1.35); }
        100% { transform: scale(1); }
      }

      .tg-drawer {
        transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1) !important;
      }
      .drawer-overlay {
        transition: opacity 0.28s ease !important;
      }
      .drawer-item {
        transition: background 0.15s ease, transform 0.12s ease !important;
        animation: tgDrawerItem 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      }
      .tg-drawer.show .drawer-item:nth-child(1) { animation-delay: 0.04s; }
      .tg-drawer.show .drawer-item:nth-child(2) { animation-delay: 0.07s; }
      .tg-drawer.show .drawer-item:nth-child(3) { animation-delay: 0.1s; }
      .tg-drawer.show .drawer-item:nth-child(4) { animation-delay: 0.13s; }
      .tg-drawer.show .drawer-item:nth-child(5) { animation-delay: 0.16s; }
      .tg-drawer.show .drawer-item:nth-child(n+6) { animation-delay: 0.19s; }
      @keyframes tgDrawerItem {
        from { opacity: 0; transform: translateX(-12px); }
        to { opacity: 1; transform: none; }
      }
      .drawer-item:active { transform: scale(0.98); }

      .side-panel {
        transition: transform 0.34s cubic-bezier(0.32, 0.72, 0, 1) !important;
      }
      .panel-overlay {
        transition: opacity 0.28s ease !important;
      }

      .modal-overlay {
        transition: opacity 0.22s ease !important;
      }
      .modal-overlay.show .modal {
        animation: tgModalIn 0.3s cubic-bezier(0.2, 0.9, 0.3, 1) both;
      }
      @keyframes tgModalIn {
        from { opacity: 0; transform: scale(0.92) translateY(12px); }
        to { opacity: 1; transform: none; }
      }

      .switch {
        transition: background 0.2s ease !important;
      }
      .switch::after, .switch .knob, .switch:before {
        transition: transform 0.22s cubic-bezier(0.2, 0.9, 0.3, 1), background 0.2s ease !important;
      }

      .toast, .snackbar, #snackbar {
        animation: tgToast 0.35s cubic-bezier(0.2, 0.9, 0.3, 1) both;
      }
      @keyframes tgToast {
        from { opacity: 0; transform: translate(-50%, 12px) scale(0.96); }
        to { opacity: 1; transform: translate(-50%, 0) scale(1); }
      }

      .music-track, .playlist-card {
        animation: tgListIn 0.3s ease both;
        transition: background 0.15s ease, transform 0.15s ease !important;
      }
      .music-track:active, .playlist-card:active { transform: scale(0.98); }

      .md3-player {
        transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1), opacity 0.25s ease !important;
        animation: tgPlayerUp 0.35s cubic-bezier(0.2, 0.9, 0.3, 1) both;
      }
      @keyframes tgPlayerUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: none; }
      }

      .wall-page.show, .music-page.show, .community-page.show {
        animation: tgPageFade 0.28s ease both;
      }
      @keyframes tgPageFade {
        from { opacity: 0.6; }
        to { opacity: 1; }
      }

      .avatar, .info-avatar, .drawer-av, .wall-composer-av {
        transition: transform 0.2s ease, box-shadow 0.2s ease !important;
      }
      .avatar:active, .info-avatar:active { transform: scale(0.95); }

      .notif-panel {
        transition: opacity 0.22s ease, transform 0.25s cubic-bezier(0.2, 0.9, 0.3, 1) !important;
      }
      .notif-panel.show {
        animation: tgNotifIn 0.28s cubic-bezier(0.2, 0.9, 0.3, 1) both;
      }
      @keyframes tgNotifIn {
        from { opacity: 0; transform: translateY(-8px) scale(0.96); }
        to { opacity: 1; transform: none; }
      }
      .notif-item {
        animation: tgListIn 0.28s ease both;
        transition: background 0.15s ease !important;
      }

      .profile-verify-mark {
        animation: tgPop 0.4s cubic-bezier(0.2, 0.9, 0.3, 1) both;
      }
      @keyframes tgPop {
        0% { transform: scale(0); opacity: 0; }
        70% { transform: scale(1.15); }
        100% { transform: scale(1); opacity: 1; }
      }

      .call-overlay, .call-screen {
        animation: tgPageFade 0.3s ease both;
      }

      .nav-rail .icon-btn {
        transition: background 0.18s ease, transform 0.15s ease, color 0.18s ease !important;
      }
      .nav-rail .icon-btn.active {
        animation: tgPop 0.3s ease both;
      }

      .setting-row, .info-row {
        transition: background 0.15s ease !important;
      }
      .info-row:active, .setting-row:active { opacity: 0.85; }

      .wall-filter-btn, .chat-folder-chip, [data-music-tab], .music-sort-bar button {
        transition: background 0.18s ease, color 0.18s ease, transform 0.12s ease !important;
      }
      .wall-filter-btn:active, .chat-folder-chip:active { transform: scale(0.95); }

      .emoji-panel {
        transition: opacity 0.2s ease, transform 0.22s cubic-bezier(0.2, 0.9, 0.3, 1) !important;
      }
      .emoji-panel.show {
        animation: tgNotifIn 0.25s ease both;
      }

      .reply-bar, .quote-reply-bar {
        animation: tgMsgIn 0.25s ease both;
      }

      .fab, #fabNewChat {
        transition: transform 0.2s cubic-bezier(0.2, 0.9, 0.3, 1), box-shadow 0.2s ease !important;
      }
      .fab:active, #fabNewChat:active { transform: scale(0.9); }

      .proxy-status-bar, .dnd-banner, .offline-banner {
        animation: tgBannerIn 0.35s cubic-bezier(0.2, 0.9, 0.3, 1) both;
      }
      @keyframes tgBannerIn {
        from { opacity: 0; transform: translateY(-100%); }
        to { opacity: 1; transform: none; }
      }

      .switch.on {
        transition: background 0.2s ease !important;
      }
    }



    /* Auth photo background (user sunset image) */
    .auth-screen {
      background: #0b1220 !important;
    }
    .tw-auth-layout {
      background: transparent !important;
      position: relative;
      isolation: isolate;
    }
    .tw-auth-layout::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 0;
      background:
        linear-gradient(180deg, rgba(8,12,24,0.35) 0%, rgba(8,12,24,0.55) 45%, rgba(8,12,24,0.78) 100%),
        url('data:image/jpeg;base64,') center/cover no-repeat;
      pointer-events: none;
    }
    .tw-auth-hero {
      background: transparent !important;
      position: relative;
      z-index: 1;
    }
    .tw-auth-hero::before { display: none !important; }
    .tw-auth-hero-inner {
      background: rgba(0,0,0,0.28);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.18);
