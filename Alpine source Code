    function peerBlockKeys(chat) {
      if (!chat) return [];
      const keys = [];
      if (chat.name) keys.push(String(chat.name));
      if (chat.peerId) keys.push(String(chat.peerId));
      if (chat.username) keys.push(String(chat.username).replace(/^@/, ''));
      if (chat.peerUsername) keys.push(String(chat.peerUsername).replace(/^@/, ''));
      return keys.filter(Boolean);
    }
    function isChatBlocked(chat) {
      if (!chat) return false;
      if (chat.type === 'service' || chat.type === 'bookmarks' || chat.type === 'notes' || chat.type === 'group' || chat.type === 'channel') return false;
      return peerBlockKeys(chat).some(k => isBlockedName(k));
    }
    function blockChatPeer(chat) {
      if (!chat) return;
      peerBlockKeys(chat).forEach(k => {
        const key = String(k).replace(/^@/, '');
        if (!isBlockedName(key)) blacklist.push(key);
      });
      chat.blocked = true;
      saveData();
      try { renderChatList(); } catch (_) {}
      try { renderBlacklist(); } catch (_) {}
      try { updateChatBlockedUI(chat); } catch (_) {}
      toast((chat.name || 'Пользователь') + ' заблокирован');
    }
    function unblockChatPeer(chat) {
      if (!chat) return;
      const keys = peerBlockKeys(chat).map(k => String(k).replace(/^@/, '').toLowerCase());
      blacklist = (blacklist || []).filter(b => !keys.includes(String(b).replace(/^@/, '').toLowerCase()));
      chat.blocked = false;
      saveData();
      try { renderChatList(); } catch (_) {}
      try { renderBlacklist(); } catch (_) {}
      try { updateChatBlockedUI(chat); } catch (_) {}
      toast((chat.name || 'Пользователь') + ' разблокирован');
