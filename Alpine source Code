    .wall-hashtag { color: #2a5885; cursor: pointer; font-weight: 500; }
    .wall-hashtag:hover { text-decoration: underline; }
    .quote-reply-bar {
      display: none; align-items: center; gap: 10px;
      padding: 8px 12px; background: #f0f2f5;
