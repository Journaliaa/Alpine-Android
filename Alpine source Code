      function sendSticker(id) {
        if (activeChatId == null) { toast('Откройте чат'); return; }
        const chat = chats.find(c => String(c.id) === String(activeChatId));
        if (!chat) return;
        const img = ensureStickerImg();
        const push = () => {
          const dataUrl = stickerDataUrl(id) || '';
          const msg = {
            id: ++msgIdCounter,
            text: '',
            stickerId: id,
            sticker: dataUrl,
            stickerCss: stickerStyle(id),
            outgoing: true,
            time: Date.now(),
            reactions: [],
            read: false
          };
          chat.messages.push(msg);
          saveData();
          renderMessages(chat);
          renderChatList();
          document.getElementById('emojiPanel')?.classList.remove('show');
        };
        if (img.complete && img.naturalWidth) push();
        else { img.onload = push; setTimeout(push, 400); }
      }
      function draw(mode) {
        mode = mode || 'emoji';
        grid.classList.toggle('stickers-mode', mode === 'stickers');
        if (mode === 'stickers') {
          ensureStickerImg();
          let h = '';
          for (let id = 0; id < NIVA_STICKER_COUNT; id++) {
            const p = stickerPos(id);
            h += '<button type="button" class="sticker-btn" data-sticker-id="' + id + '">' +
              '<span class="sticker-sprite" style="background-position:-' + p.x + 'px -' + p.y + 'px"></span></button>';
          }
          grid.innerHTML = h;
          grid.querySelectorAll('[data-sticker-id]').forEach(btn => {
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              sendSticker(Number(btn.dataset.stickerId));
            });
          });
          return;
        }
        const items = mode === 'gif' ? gifSet : (typeof EMOJIS !== 'undefined' ? EMOJIS : emojiFallback);
        grid.innerHTML = items.map(e => '<button type="button" class="emoji-btn">' + e + '</button>').join('');
        grid.querySelectorAll('.emoji-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const ta = document.getElementById('messageInput');
            if (!ta) return;
            ta.value += btn.textContent;
            ta.focus();
            try { autoResize(); } catch (err) {}
            const sb = document.getElementById('sendBtn');
            if (sb) sb.disabled = !ta.value.trim();
          });
        });
      }
      document.querySelectorAll('[data-emoji-mode]').forEach(btn => {
        btn.addEventListener('click', (e) => {
