<script>
/* Avatar persist + camera reliability v2 */
(function () {
  const IDB_NAME = 'alpine_media_v1';
  const IDB_STORE = 'blobs';

  function idb() {
    return new Promise((resolve, reject) => {
      const req = indexedDB.open(IDB_NAME, 1);
      req.onupgradeneeded = () => {
        const db = req.result;
        if (!db.objectStoreNames.contains(IDB_STORE)) db.createObjectStore(IDB_STORE);
      };
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  }
  async function idbSet(key, val) {
    const db = await idb();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(IDB_STORE, 'readwrite');
      tx.objectStore(IDB_STORE).put(val, key);
      tx.oncomplete = () => resolve();
      tx.onerror = () => reject(tx.error);
    });
  }
  async function idbGet(key) {
    const db = await idb();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(IDB_STORE, 'readonly');
      const r = tx.objectStore(IDB_STORE).get(key);
      r.onsuccess = () => resolve(r.result);
      r.onerror = () => reject(r.error);
    });
  }

  window.__alpineSaveAvatarBlob = async function (dataUrl) {
    try { await idbSet('profile_photo', dataUrl); } catch (e) { console.warn('idb avatar', e); }
  };
  window.__alpineLoadAvatarBlob = async function () {
    try { return await idbGet('profile_photo'); } catch (e) { return null; }
  };

  function paintAllAvatars(photo) {
    try {
      if (typeof profile !== 'undefined' && profile) profile.photo = photo || profile.photo || '';
      const name = (profile && profile.name) || 'Я';
      const color = (profile && profile.color) || '#c4c4c4';
      const ini = (typeof initials === 'function') ? initials(name) : (name[0] || 'Я');
      const ids = ['profilePreviewAvatar', 'globalWallComposerAv', 'drawerAvatar', 'headerAvatar', 'sidebarProfileAvatar', 'settingsProfileAvatar'];
      ids.forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        if (typeof setAvatarEl === 'function') setAvatarEl(el, ini, color, photo || '');
        else if (photo) {
          el.textContent = '';
          el.style.backgroundImage = 'url(' + photo + ')';
          el.style.backgroundSize = 'cover';
          el.style.backgroundPosition = 'center';
          el.classList.add('has-photo');
        }
      });
    } catch (e) { console.warn(e); }
  }

  function wrapApply() {
    const orig = window.applyProfilePhoto;
    if (typeof orig === 'function' && !orig.__avatarWrapped) {
      window.applyProfilePhoto = function (data) {
        try { orig(data); } catch (e) { console.warn(e); }
        try {
          if (typeof profile !== 'undefined' && profile) profile.photo = data;
          if (typeof profileDraft !== 'undefined' && profileDraft) profileDraft.photo = data;
        } catch (_) {}
        paintAllAvatars(data);
        window.__alpineSaveAvatarBlob(data);
        try { if (typeof saveData === 'function') saveData(); } catch (_) {}
      };
      window.applyProfilePhoto.__avatarWrapped = true;
    }
  }

  async function restoreAvatar() {
    let photo = null;
    try { photo = (typeof profile !== 'undefined' && profile && profile.photo) || ''; } catch (_) {}
    if (!photo || String(photo).length < 32) {
      const fromIdb = await window.__alpineLoadAvatarBlob();
      if (fromIdb) {
        photo = fromIdb;
        try { if (typeof profile !== 'undefined' && profile) profile.photo = photo; } catch (_) {}
      }
    }
    if (photo) paintAllAvatars(photo);
  }

  function bindAvatarInputs() {
    const input = document.getElementById('profilePhotoInput');
    const btn = document.getElementById('profilePhotoBtn');
    const av = document.getElementById('profilePreviewAvatar');

    async function handleFile(file) {
      if (window.__handleProfilePhotoFile) return window.__handleProfilePhotoFile(file);
      if (!file) return;
      try {
        let data;
        if (typeof compressImageFile === 'function') data = await compressImageFile(file, 512, 0.82);
        else {
          data = await new Promise((res, rej) => {
            const r = new FileReader();
            r.onload = () => res(r.result);
            r.onerror = rej;
            r.readAsDataURL(file);
          });
        }
        if (window.applyProfilePhoto) window.applyProfilePhoto(data);
        else paintAllAvatars(data);
        if (typeof toast === 'function') toast('Аватар сохранён');
      } catch (e) {
        console.warn(e);
        if (typeof toast === 'function') toast('Не удалось загрузить фото');
      }
    }

    if (input && !input.__hardBoundV2) {
      input.__hardBoundV2 = true;
      input.addEventListener('change', e => {
        const f = e.target.files && e.target.files[0];
        if (f) handleFile(f);
        setTimeout(() => { e.target.value = ''; }, 0);
      });
    }
    if (av && !av.__hardBoundV2) {
      av.__hardBoundV2 = true;
      av.style.cursor = 'pointer';
      av.addEventListener('click', e => {
        e.preventDefault();
        e.stopPropagation();
        input && input.click();
      });
    }
    // Ensure label works; also force click on input if needed
    if (btn && !btn.__hardBoundV2) {
      btn.__hardBoundV2 = true;
      btn.addEventListener('click', e => {
        if (!input) return;
        // If native label[for] works, skip forced click to avoid double dialog
        if (btn.tagName === 'LABEL' && btn.getAttribute('for') === 'profilePhotoInput') return;
        e.preventDefault();
        try { input.click(); } catch (_) {}
      });
    }
  }

  function boot() {
    wrapApply();
    bindAvatarInputs();
    restoreAvatar();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(boot, 300);
  setTimeout(boot, 1000);
  setTimeout(restoreAvatar, 1800);
})();
</script>




<script>
/* M3 Expressive appearance: palettes + avatar shape (local only) */
(function () {
  const STORAGE_KEY = 'alpine_m3_appearance_v1';
  const PALETTES = {
    blue: '#1a73e8',
    violet: '#7c4dff',
    mint: '#00bfa5',
    rose: '#e91e63',
    amber: '#f9a825',
    teal: '#00897b',
    mono: '#607d8b',
    custom: null
  };

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) return JSON.parse(raw);
    } catch (_) {}
    return { palette: 'blue', hex: '#1a73e8', avatarShape: 'circle' };
  }
  function saveState(st) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(st)); } catch (_) {}
  }

  let state = loadState();

  function getApplyAccent() {
    if (typeof window.applyAccent === 'function') return window.applyAccent;
    if (typeof applyAccent === 'function') return applyAccent;
    return null;
  }

  function forceCssVars(hex) {
    // Minimal fallback if tonal palette unavailable
    const root = document.documentElement.style;
    root.setProperty('--md-sys-color-primary', hex);
    root.setProperty('--vk-blue', hex);
    root.setProperty('--md-sys-color-inverse-primary', hex);
    // light containers
    try {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      const soft = 'rgba(' + r + ',' + g + ',' + b + ',0.14)';
      root.setProperty('--md-sys-color-primary-container', soft);
    } catch (_) {}
  }

  function applyAvatarShape(shape) {
    const s = ['circle', 'squircle', 'rounded', 'diamond'].includes(shape) ? shape : 'circle';
    document.documentElement.setAttribute('data-avatar-shape', s);
    document.body && document.body.setAttribute('data-avatar-shape', s);
    state.avatarShape = s;
    document.querySelectorAll('[data-avatar-shape]').forEach(btn => {
      btn.setAttribute('aria-pressed', btn.getAttribute('data-avatar-shape') === s ? 'true' : 'false');
    });
  }

  function applyPalette(id, hexOverride, silent) {
    let hex = hexOverride;
    if (!hex) {
      if (id === 'custom') hex = state.hex || '#1a73e8';
      else hex = PALETTES[id] || PALETTES.blue;
    }
    if (!/^#([0-9a-fA-F]{6})$/.test(hex)) hex = '#1a73e8';
    state.palette = id || state.palette || 'blue';
    state.hex = hex;

    let ok = false;
    try {
      const fn = getApplyAccent();
      if (fn) {
        fn(hex);
        ok = true;
      }
    } catch (e) { console.warn('applyAccent', e); }
    if (!ok) forceCssVars(hex);

    try {
      if (typeof accentColor !== 'undefined') accentColor = hex;
      window.accentColor = hex;
    } catch (_) {}
    try {
      // persist into main app storage if present
      if (typeof saveData === 'function') saveData();
    } catch (_) {}

    document.querySelectorAll('[data-palette]').forEach(btn => {
      btn.setAttribute('aria-pressed', btn.getAttribute('data-palette') === state.palette ? 'true' : 'false');
    });
    const colorInput = document.getElementById('m3CustomColor');
    const hexInput = document.getElementById('m3CustomHex');
    if (colorInput) colorInput.value = hex;
    if (hexInput) hexInput.value = hex;
    saveState(state);
    if (!silent) {
      try { if (typeof toast === 'function') toast('Палитра: ' + (id || 'custom')); } catch (_) {}
    }
  }

  function bind() {
    // Event delegation — works even if settings panel re-renders
    if (!document.__m3PaletteDelegated) {
      document.__m3PaletteDelegated = true;
      document.addEventListener('click', function (e) {
        const pBtn = e.target && e.target.closest && e.target.closest('#m3PaletteGrid [data-palette]');
        if (pBtn) {
          e.preventDefault();
          const id = pBtn.getAttribute('data-palette');
          if (id === 'custom') {
            let hex = (document.getElementById('m3CustomHex')?.value || state.hex || '#1a73e8').trim();
            if (!hex.startsWith('#')) hex = '#' + hex;
            applyPalette('custom', hex);
          } else {
            applyPalette(id);
          }
          return;
        }
        if (e.target && e.target.id === 'm3ApplyHexBtn') {
          e.preventDefault();
          let hex = (document.getElementById('m3CustomHex')?.value || '').trim();
          if (!hex.startsWith('#')) hex = '#' + hex;
          if (!/^#([0-9a-fA-F]{6})$/.test(hex)) {
            if (typeof toast === 'function') toast('HEX вида #1a73e8');
            return;
          }
          applyPalette('custom', hex);
        }
        const shapeBtn = e.target && e.target.closest && e.target.closest('#m3AvatarShapeRow [data-avatar-shape]');
        if (shapeBtn) {
          e.preventDefault();
          applyAvatarShape(shapeBtn.getAttribute('data-avatar-shape'));
          saveState(state);
          try { if (typeof toast === 'function') toast('Форма аватара'); } catch (_) {}
        }
      }, true);
      document.addEventListener('input', function (e) {
        if (e.target && e.target.id === 'm3CustomColor') {
          const hex = e.target.value;
          const hexInput = document.getElementById('m3CustomHex');
          if (hexInput) hexInput.value = hex;
          applyPalette('custom', hex, true);
        }
      }, true);
    }
  }

  function boot() {
    bind();
    applyAvatarShape(state.avatarShape || 'circle');
    applyPalette(state.palette || 'blue', state.hex, true);
  }

  document.addEventListener('click', e => {
    if (e.target && (e.target.id === 'themeSwitch' || e.target.closest?.('#themeSwitch') || e.target.id === 'drawerThemeBtn')) {
      setTimeout(() => applyPalette(state.palette, state.hex, true), 50);
      setTimeout(() => applyPalette(state.palette, state.hex, true), 250);
    }
  });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(boot, 300);
  setTimeout(boot, 1000);
  setTimeout(boot, 2500);

  try {
    if (typeof applyThemeMode === 'function' && !applyThemeMode.__m3) {
      const o = applyThemeMode;
      window.applyThemeMode = applyThemeMode = function () {
        const r = o.apply(this, arguments);
        setTimeout(() => applyPalette(state.palette, state.hex, true), 40);
        return r;
      };
      applyThemeMode.__m3 = true;
    }
  } catch (_) {}

  window.__m3ApplyAppearance = boot;
  window.__m3ApplyPalette = applyPalette;
})();

</script>


