          profile = { name: 'My profile', username: 'user', status: '', color: '#DA291C', photo: '', banner: '', bio: '', themeA: '#DA291C', themeB: '#6b4fa0', profilePublic: true };
          return;
        }
        if (saved) {
          const data = JSON.parse(saved);
          chats = Array.isArray(data.chats) ? data.chats : JSON.parse(JSON.stringify(DEFAULT_CHATS));
          chats = (Array.isArray(chats) ? chats : []).filter(Boolean).map(c => ({ ...c, type: c.type || 'private', favorite: !!c.favorite, members: Array.isArray(c.members) ? c.members : undefined, pinnedMsgId: c.pinnedMsgId || null, folderId: c.folderId || 'all', ttl: c.ttl || 0, messages: Array.isArray(c.messages) ? c.messages.filter(Boolean) : [], unread: Number(c.unread) || 0 }));
          soundEnabled = data.soundEnabled !== false;
          profile = {
            name: 'My profile', username: 'user', status: '', color: '#DA291C', photo: '', banner: '', bio: '',
            themeA: '#DA291C', themeB: '#6b4fa0', profilePublic: true,
            ...(data.profile || {})
          };
