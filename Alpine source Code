    .wall-action-btn.reposted { color: #4bb34b; }
    .wall-action-btn .material-icons-round { font-size: 18px; }
    .wall-action-btn .vk-action-label { font-size: 13px; }
    .wall-empty {
      text-align: center; padding: 48px 20px; color: #818c99; font-size: 13px;
      background: #fff; border-radius: 4px; border: 1px solid #e7e8ec; margin: 0 12px;
    }
