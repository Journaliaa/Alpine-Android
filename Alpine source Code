      border-radius: 0 4px 4px 0; font-size: 12px;
    }
    .quote-reply-bar.show { display: flex; }
    .quote-reply-bar .qr-body { flex: 1; min-width: 0; }
    .quote-reply-bar strong { display: block; color: #2a5885; font-size: 12px; }
    .quote-reply-bar small { color: #818c99; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }
    .dnd-banner {
