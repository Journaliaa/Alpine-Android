}
.wall-post, .chat-item, .settings-section, .drawer-item,
.message .bubble, .people-row, .notif-item, .music-track-row {
  border-radius: var(--m3-radius-md) !important;
  transition: background 0.18s var(--m3-ease), transform 0.16s var(--m3-spring), box-shadow 0.2s var(--m3-ease);
}
.btn, .btn-filled, .btn-text, .people-follow-btn, .wall-filter-btn,
.chat-folder-chip, .music-tab, .music-seg-btn, .io-chip {
  border-radius: var(--m3-radius-full) !important;
  font-weight: 600 !important;
  letter-spacing: 0.02em;
  transition: transform 0.15s var(--m3-spring), background 0.15s var(--m3-ease), box-shadow 0.15s var(--m3-ease);
}
.btn:active, .btn-filled:active, .icon-btn:active, .drawer-item:active, .chat-item:active {
  transform: scale(0.96);
}
.btn-filled, .send-btn, .fab {
  box-shadow: none !important;
  background: var(--md-sys-color-primary) !important;
  color: var(--md-sys-color-on-primary) !important;
