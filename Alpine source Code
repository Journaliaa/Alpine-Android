  // Wrap vault password set to store verifier + encrypt existing photos
  const _origVaultSetPassword = window.vaultSetPassword;
  // Will bind after functions exist

  // ---------- Offline queue ----------
  async function enqueueOutbound(type, payload) {
    const id = await idbQueueAdd({ type, payload });
    updateQueueBadge();
    return id;
  }
  async function flushQueue() {
    if (!navigator.onLine) return;
    const items = await idbQueueAll();
    for (const item of items) {
      try {
        if (item.type === 'post') {
          // merge into posts if not present
          if (typeof posts !== 'undefined' && Array.isArray(posts)) {
            const exists = posts.some(p => String(p.id) === String(item.payload && item.payload.id));
            if (!exists && item.payload) {
              posts.unshift(item.payload);
              try { if (typeof saveData === 'function') saveData(); } catch (_) {}
              try { if (typeof renderGlobalWall === 'function') renderGlobalWall(); } catch (_) {}
            }
          }
        } else if (item.type === 'message') {
          // best-effort: push into chat messages
          try {
            const ch = (chats || []).find(c => String(c.id) === String(item.payload.chatId));
            if (ch) {
              ch.messages = ch.messages || [];
              if (!ch.messages.some(m => m.id === item.payload.message.id)) {
                ch.messages.push(item.payload.message);
                try { if (typeof saveData === 'function') saveData(); } catch (_) {}
                try { if (typeof renderMessages === 'function') renderMessages(); } catch (_) {}
              }
            }
          } catch (_) {}
        }
        await idbQueueDelete(item.id);
      } catch (e) {
        console.warn('queue item failed', e);
