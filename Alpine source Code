    // ===== Video notes (circles) =====
    function stopVnTimer() {
      if (vnTimerInterval) { clearInterval(vnTimerInterval); vnTimerInterval = null; }
      if (vnMaxTimeout) { clearTimeout(vnMaxTimeout); vnMaxTimeout = null; }
    }
    function cleanupVnStream() {
      if (vnStream) { vnStream.getTracks().forEach(t => t.stop()); vnStream = null; }
      const v = document.getElementById('vnPreviewVideo');
      if (v) v.srcObject = null;
    }
    function closeVnOverlay() {
      document.getElementById('vnRecordOverlay')?.classList.remove('show');
      stopVnTimer();
      cleanupVnStream();
      vnRecorder = null;
      vnChunks = [];
    }
    function updateVnTimer() {
      const sec = Math.floor((Date.now() - vnStartTime) / 1000);
      document.getElementById('vnRecordTimer').textContent = formatVnDuration(sec);
    }
    async function startVideoNote() {
      if (!activeChatId) { toast('Сначала откройте чат'); return; }
      if (!navigator.mediaDevices?.getUserMedia || !window.MediaRecorder) {
        toast('Запись видео не поддерживается'); return;
      }
      if (vnRecorder && vnRecorder.state === 'recording') return;
      try {
        vnStream = await navigator.mediaDevices.getUserMedia({
          audio: true,
          video: { facingMode: 'user', width: { ideal: 480 }, height: { ideal: 480 } }
        });
        const preview = document.getElementById('vnPreviewVideo');
        preview.srcObject = vnStream;
        await preview.play().catch(() => {});

        vnChunks = [];
        const mimeCandidates = [
          'video/webm;codecs=vp9,opus',
          'video/webm;codecs=vp8,opus',
          'video/webm',
          'video/mp4'
        ];
        const mime = mimeCandidates.find(m => MediaRecorder.isTypeSupported(m)) || '';
        vnRecorder = mime ? new MediaRecorder(vnStream, { mimeType: mime }) : new MediaRecorder(vnStream);
        vnRecorder.ondataavailable = e => { if (e.data && e.data.size) vnChunks.push(e.data); };
        vnRecorder.onstop = () => {
          stopVnTimer();
          const duration = Math.max(1, Math.round((Date.now() - vnStartTime) / 1000));
          const blob = new Blob(vnChunks, { type: vnRecorder.mimeType || 'video/webm' });
          cleanupVnStream();
          document.getElementById('vnRecordOverlay')?.classList.remove('show');
          if (!vnChunks.length || blob.size < 500) {
            toast('Слишком короткая запись');
            vnRecorder = null;
            return;
          }
          const reader = new FileReader();
          reader.onload = () => {
            const chat = chats.find(c => String(c.id) === String(activeChatId));
            if (!chat) return;
            chat.messages.push({
              id: ++msgIdCounter,
              text: '',
              outgoing: true,
              time: Date.now(),
              reactions: [],
              attachment: {
                name: 'Видео-кружок',
                kind: 'video_note',
                data: reader.result,
                duration
              }
            });
            renderMessages(chat);
            renderChatList(document.getElementById('searchInput')?.value || '');
            saveData();
            toast('Видео-кружок отправлен');
          };
          reader.readAsDataURL(blob);
          vnRecorder = null;
          vnChunks = [];
        };

        document.getElementById('vnRecordOverlay').classList.add('show');
        vnStartTime = Date.now();
        document.getElementById('vnRecordTimer').textContent = '0:00';
        vnTimerInterval = setInterval(updateVnTimer, 250);
        vnRecorder.start(200);
        // auto-stop at 60s
        vnMaxTimeout = setTimeout(() => {
          if (vnRecorder && vnRecorder.state === 'recording') {
            vnRecorder.stop();
            toast('Лимит 60 сек');
          }
        }, 60000);
      } catch (err) {
        cleanupVnStream();
        toast('Нет доступа к камере или микрофону');
      }
    }
