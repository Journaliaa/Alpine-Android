    function wallCamWithTimeout(promise, ms) {
      return Promise.race([
        promise,
        new Promise((_, reject) => setTimeout(() => reject(new Error('camera timeout')), ms))
      ]);
    }

    async function requestWallCameraStream(facing) {
      const want = facing === 'environment' ? 'environment' : 'user';
      // Simple constraints first — avoids hangs from exact+deviceId chains on mobile
      const attempts = [
        { audio: false, video: { facingMode: want, width: { ideal: 960 }, height: { ideal: 960 } } },
        { audio: false, video: { facingMode: { ideal: want } } },
        { audio: false, video: true }
      ];
      // deviceId only if labels already available (after prior permission)
      try {
        const devices = await navigator.mediaDevices.enumerateDevices();
        const cams = devices.filter(d => d.kind === 'videoinput' && d.deviceId);
        if (cams.length) {
          const isFront = (label) => /front|user|face|перед|selfie/i.test(label || '');
          const isBack = (label) => /back|rear|environment|задн|world/i.test(label || '');
          let preferred = null;
          if (want === 'user') preferred = cams.find(d => isFront(d.label));
          else preferred = cams.find(d => isBack(d.label));
          if (!preferred && cams.length > 1) {
            preferred = want === 'user' ? cams[0] : cams[cams.length - 1];
          }
          if (preferred && preferred.deviceId) {
            attempts.unshift({
              audio: false,
              video: { deviceId: { ideal: preferred.deviceId }, width: { ideal: 960 }, height: { ideal: 960 } }
            });
          }
        }
      } catch (_) {}

      let lastErr = null;
      for (const constraints of attempts) {
        try {
          const stream = await wallCamWithTimeout(
            navigator.mediaDevices.getUserMedia(constraints),
            8000
          );
          return stream;
        } catch (e) {
          lastErr = e;
        }
      }
      throw lastErr || new Error('getUserMedia failed');
    }

