    if (!file) return 'No file selected';
    if (kind === 'image' && !file.type.startsWith('image/')) return 'Please choose an image (JPG, PNG, WebP, GIF)';
    if (kind === 'video' && !file.type.startsWith('video/') && file.type !== 'image/gif') return 'Please choose a video or GIF';
    if (kind === 'image' && file.size > MEDIA_LIMITS.imageBytes) {
      return 'Image is too large (max ~2.5 MB). It will be compressed if possible.';
    }
    if (kind === 'video' && file.size > MEDIA_LIMITS.videoBytes) {
      return 'Video is too large (max ~12 MB). Trim it or pick a shorter clip.';
    }
    return '';
