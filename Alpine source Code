    function isCommOwner(c) {
      const me = myCommIdentity();
      return c && (c.ownerId === me.id || c.ownerId === me.name);
    }
    function ensureCommunityChat(c) {
      normalizeCommunity(c);
      let chat = chats.find(x => String(x.id) === String(c.chatId) || x.communityId === c.id);
      if (!chat) {
        const numericId = typeof c.chatId === 'number' ? c.chatId : (Date.now() + Math.floor(Math.random()*999));
        c.chatId = numericId;
        chat = {
          id: numericId,
          communityId: c.id,
          name: '💬 ' + c.name,
          avatar: (c.name || 'C').slice(0, 2).toUpperCase(),
          color: c.color || '#0077ff',
          type: 'group',
          online: true,
          pinned: false,
          muted: false,
          unread: 0,
          members: (c.memberList || []).map(m => m.name),
          messages: [
            { id: Date.now() - 1000, text: 'Общий чат сообщества «' + c.name + '»', outgoing: false, time: Date.now() - 1000, reactions: [], system: true }
          ],
          lastSeen: Date.now()
        };
        chats.unshift(chat);
        saveData();
      } else {
        chat.name = '💬 ' + c.name;
        chat.color = c.color || chat.color;
        chat.members = (c.memberList || []).map(m => m.name);
      }
      return chat;
    }
    function joinCommunity(c) {
      const me = myCommIdentity();
      normalizeCommunity(c);
      if (!c.memberList.some(m => m.id === me.id || m.name === me.name)) {
        c.memberList.push({ id: me.id, name: me.name, color: me.color, avatar: me.avatar || (me.name || '?').slice(0, 1), photo: me.photo });
      }
      c.joined = true;
      c.members = c.memberList.length;
      ensureCommunityChat(c);
      saveCommunities();
      saveData();
    }
    function leaveCommunity(c) {
      const me = myCommIdentity();
      if (isCommOwner(c)) { toast('Создатель не может выйти — передайте сообщество или удалите'); return false; }
      c.memberList = (c.memberList || []).filter(m => m.id !== me.id && m.name !== me.name);
      c.joined = false;
      c.members = c.memberList.length;
      saveCommunities();
      return true;
    }
