  // ---- Pin post ----
  function pinPost(postId) {
    try {
      if (typeof pinnedPostId !== 'undefined') {
        window.pinnedPostId = postId;
        pinnedPostId = postId;
      } else {
        window.pinnedPostId = postId;
      }
      try { if (typeof saveData === 'function') saveData(); } catch (_) {}
      try { if (typeof renderProfileWall === 'function') renderProfileWall(); } catch (_) {}
      toastSafe('Pinned to profile');
    } catch (e) { console.warn(e); }
