        const defaults = new Set(['', 'Мой профиль', 'Пользователь', 'user', 'guest', 'Гость']);
        const curName = (profile.name || '').trim();
        const curUser = (profile.username || '').replace(/^@/, '').trim();
        // Keep edited profile on reload; only fill empty / default fields from session
        if (!curName || defaults.has(curName)) {
          profile.name = user.name || user.username || curName || 'Пользователь';
        }
        if (!curUser || defaults.has(curUser) || curUser === 'user') {
          // if profile username still default, take session username
          if (!(curUser && curUser.length >= 3 && !defaults.has(curUser))) {
            profile.username = (user.username || curUser || 'user').replace(/^@/, '');
          }
        }
        // Prefer already-saved profile username/name always when they look intentional
        if (curUser && curUser.length >= 3 && !defaults.has(curUser)) {
          profile.username = curUser;
        }
        if (curName && !defaults.has(curName)) {
          profile.name = curName;
        }
        if (user.email && (!profile.status || profile.status === 'Настроить профиль')) {
          profile.status = 'На связи';
