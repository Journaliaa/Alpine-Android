      }
    });
    document.getElementById('alpineDmE2eClose')?.addEventListener('click', () => {
      try { localStorage.setItem('alpine_e2e_banner_hidden_v1', '1'); } catch (_) {}
      const el = document.getElementById('alpineDmE2e');
      if (el) el.style.display = 'none';
    });
    document.addEventListener('click', e => {
      if (!e.target.closest || e.target.closest('#alpineDmMore') || e.target.closest('#alpineDmMenu')) return;
      hideDmMenu();
    });

    return layer;
  }

  function hideDmMenu() {
    document.getElementById('alpineDmMenu')?.classList.remove('show');
  }

  let currentId = null;

  function esc(t) {
    return String(t ?? '').replace(/[&<>"']/g, ch => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[ch]));
  }

  function findChat(id) {
    try {
      return (typeof chats !== 'undefined' ? chats : []).find(c => String(c.id) === String(id)) || null;
    } catch (_) {
      return null;
    }
  }

  function paintMsgs(chat) {
    const box = document.getElementById('alpineDmMsgs');
    if (!box || !chat) return;
    if (!Array.isArray(chat.messages)) chat.messages = [];
    const list = chat.messages.filter(Boolean);
    if (!list.length) {
      box.innerHTML = '<div class="dm-empty">Нет сообщений<br><span style="font-size:13px">Напишите первое сообщение</span></div>';
      return;
    }
    const html = list.map(m => {
      if (m.system || m.service) {
        return '<div class="dm-row sys"><div class="dm-bubble">' + esc(m.text || '') + '</div></div>';
      }
      const out = !!(m.outgoing || m.out || m.fromMe);
      let text = m.deletedForAll ? '<i>Сообщение удалено</i>' : esc(m.text || '');
      if (!text) {
        if (m.attachment && m.attachment.kind === 'image') text = '📷 Фото';
        else if (m.voice || (m.attachment && m.attachment.kind === 'audio')) text = '🎤 Голосовое';
        else if (m.attachment) text = '📎 ' + esc(m.attachment.name || 'Файл');
        else text = '·';
      }
      const time = m.time ? new Date(m.time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '';
      return '<div class="dm-row ' + (out ? 'out' : 'in') + '"><div class="dm-bubble">' + text +
        (time ? '<div class="dm-time">' + time + '</div>' : '') + '</div></div>';
    }).join('');
    box.innerHTML = html;
    box.scrollTop = box.scrollHeight;
  }

  function isSpecialChat(chat) {
    if (!chat) return true;
    const id = String(chat.id || '');
    const t = String(chat.type || '');
    if (t === 'service' || t === 'bookmarks' || t === 'notes') return true;
    if (id === 'service_nivada' || id === 'bookmarks_saved' || id === 'notes_self') return true;
    if (chat.name === 'Alpine Service' || chat.name === 'Избранное' || chat.name === 'Заметки себе') return true;
    return false;
  }

  function isMobileUi() {
    try { return window.matchMedia('(max-width: 900px)').matches; } catch (_) { return true; }
  }

  function updateDmActions(chat) {
    const special = isSpecialChat(chat);
    const call = document.getElementById('alpineDmCall');
    const more = document.getElementById('alpineDmMore');
    const e2e = document.getElementById('alpineDmE2e');
    if (call) call.style.display = special ? 'none' : 'flex';
    if (more) more.style.display = special ? 'none' : 'flex';
    if (e2e) {
      if (special) e2e.style.display = 'none';
      else {
        try {
          const hide = localStorage.getItem('alpine_e2e_banner_hidden_v1') === '1';
          e2e.style.display = hide ? 'none' : 'flex';
        } catch (_) { e2e.style.display = 'flex'; }
      }
    }
    // status for special
    const st = document.getElementById('alpineDmStatus');
    if (st && special) {
      if (chat.type === 'bookmarks' || chat.id === 'bookmarks_saved') st.textContent = 'сохранённые сообщения';
      else if (chat.type === 'notes' || chat.id === 'notes_self') st.textContent = 'личные заметки';
      else st.textContent = 'служебный чат';
    }
  }

  function openDm(id) {
    ensureLayer();
    const chat = findChat(id);
    if (!chat) {
      try { if (typeof toast === 'function') toast('Чат не найден'); } catch (_) {}
      return false;
    }
    try {
      if (typeof requireChatPin === 'function' && !requireChatPin()) return false;
    } catch (_) {}

    currentId = chat.id;
    try { activeChatId = chat.id; } catch (_) { window.activeChatId = chat.id; }
    chat.unread = 0;
    if (!Array.isArray(chat.messages)) chat.messages = [];

    const layer = document.getElementById(LAYER_ID);
    layer.classList.add('open');
    layer.setAttribute('aria-hidden', 'false');
    try {
      if (!isMobileUi()) document.body.classList.add('dm-open-desktop');
      else document.body.classList.remove('dm-open-desktop');
      // hide wall if open
      document.getElementById('wallPage')?.classList.remove('show');
      document.querySelector('.app')?.classList.remove('wall-mode');
      document.body.classList.remove('wall-mode');
    } catch (_) {}

    document.getElementById('alpineDmName').textContent = chat.name || 'Chat';
    const st = document.getElementById('alpineDmStatus');
    if (chat.type === 'group' || chat.type === 'channel') {
      st.textContent = ((chat.members && chat.members.length) || 0) + ' участников';
    } else if (isSpecialChat(chat)) {
      if (chat.type === 'bookmarks' || chat.id === 'bookmarks_saved') st.textContent = 'сохранённые сообщения';
      else if (chat.type === 'notes' || chat.id === 'notes_self') st.textContent = 'личные заметки';
      else st.textContent = 'служебный чат';
    } else {
      st.textContent = chat.online ? 'в сети' : (chat.lastSeen ? 'был(а) недавно' : '');
    }

    const av = document.getElementById('alpineDmAvatar');
    av.textContent = chat.avatar || (chat.name || '?').slice(0, 1).toUpperCase();
    av.style.background = chat.color || '#DA291C';

    try {
      updateDmActions(chat);
      hideDmMenu();
    } catch (_) {}

    paintMsgs(chat);

    const inp = document.getElementById('alpineDmInput');
    if (inp) {
      try {
        const draft = (typeof drafts !== 'undefined' && drafts) ? (drafts[chat.id] || drafts[String(chat.id)] || '') : '';
        inp.value = draft || '';
      } catch (_) { inp.value = ''; }
      document.getElementById('alpineDmSend').disabled = !inp.value.trim();
      setTimeout(() => { try { inp.focus(); } catch (_) {} }, 80);
    }

    try { if (typeof renderChatList === 'function') renderChatList(document.getElementById('searchInput')?.value || ''); } catch (_) {}
    try { if (typeof saveData === 'function') saveData(); } catch (_) {}
    return true;
  }

  function closeDm() {
    currentId = null;
    try { activeChatId = null; } catch (_) {}
    const layer = document.getElementById(LAYER_ID);
    if (layer) {
      layer.classList.remove('open');
      layer.setAttribute('aria-hidden', 'true');
    }
    try { document.body.classList.remove('dm-open-desktop'); } catch (_) {}
    try { if (typeof renderChatList === 'function') renderChatList(document.getElementById('searchInput')?.value || ''); } catch (_) {}
  }

  function sendDm() {
    const inp = document.getElementById('alpineDmInput');
    const text = (inp?.value || '').trim();
    if (!text || currentId == null) return;
    const chat = findChat(currentId);
    if (!chat) return;
    if (!Array.isArray(chat.messages)) chat.messages = [];

    const msg = {
      id: (window.msgIdCounter = (window.msgIdCounter || Date.now()) + 1),
      text,
      outgoing: true,
      time: Date.now(),
      reactions: [],
      delivered: true,
      read: false
    };
    chat.messages.push(msg);
    inp.value = '';
    inp.style.height = 'auto';
    document.getElementById('alpineDmSend').disabled = true;
    paintMsgs(chat);
    try { if (typeof saveData === 'function') saveData(); } catch (_) {}
    try { if (typeof renderChatList === 'function') renderChatList(document.getElementById('searchInput')?.value || ''); } catch (_) {}

    // Optional: also call original send path side-effects for cloud etc.
    try {
      if (chat.type === 'service' || chat.id === 'service_nivada') {
        if (typeof handleServiceUserMessage === 'function') handleServiceUserMessage(chat, text);
      } else if (!chat.peerId && Math.random() > 0.35 && chat.type === 'private' && typeof simulateReply === 'function') {
        // lightweight auto-reply for demo private chats
        setTimeout(() => {
          const replies = ['Ок 👍', 'Понял', 'Хорошо!', 'Сейчас', '👍', 'Да'];
          chat.messages.push({
            id: (window.msgIdCounter = (window.msgIdCounter || Date.now()) + 1),
            text: replies[Math.floor(Math.random() * replies.length)],
            outgoing: false,
            time: Date.now(),
            reactions: []
          });
          if (String(currentId) === String(chat.id)) paintMsgs(chat);
          try { if (typeof saveData === 'function') saveData(); } catch (_) {}
          try { if (typeof renderChatList === 'function') renderChatList(); } catch (_) {}
        }, 800 + Math.random() * 1200);
      }
    } catch (_) {}
  }

  function bindListClicks() {
    const list = document.getElementById('chatList') || document.querySelector('.chat-list');
    if (!list || list.__alpineDmBound) return;
    list.__alpineDmBound = true;
    list.addEventListener('click', function (e) {
      if (e.target.closest('#archiveOpenRow, #archiveBackRow, button, a, input')) return;
      const item = e.target.closest('.chat-item, [data-id]');
      if (!item) return;
      const id = item.getAttribute('data-id') || item.dataset?.id;
      if (id == null || id === '') return;
      e.preventDefault();
      e.stopPropagation();
      openDm(id);
    }, true);
  }

  // Patch openChat so any existing code path opens our layer
  function patchOpenChat() {
    if (window.openChat && window.openChat.__alpineDmV2) return;
    const prev = window.openChat;
    window.openChat = function (id) {
      const ok = openDm(id);
      // still run original for drafts/unread side effects
      if (typeof prev === 'function' && !prev.__alpineDm && !prev.__alpineDmV2) {
        try { prev.apply(this, arguments); } catch (_) {}
        // keep our layer on top
        if (ok) openDm(id);
      }
      return ok;
    };
    window.openChat.__alpineDm = true;
    window.openChat.__alpineDmV2 = true;
  }

  function boot() {
    ensureLayer();
    bindListClicks();
    patchOpenChat();
    // swipe from left edge to close
    const layer = document.getElementById(LAYER_ID);
    if (layer && !layer.__swipe) {
      layer.__swipe = true;
      let x0 = 0, y0 = 0, on = false;
      layer.addEventListener('touchstart', e => {
        if (!e.touches[0]) return;
        if (e.touches[0].clientX < 28) {
          on = true; x0 = e.touches[0].clientX; y0 = e.touches[0].clientY;
        } else on = false;
      }, { passive: true });
      layer.addEventListener('touchend', e => {
        if (!on || !e.changedTouches[0]) return;
        const dx = e.changedTouches[0].clientX - x0;
        const dy = Math.abs(e.changedTouches[0].clientY - y0);
        on = false;
        if (dx > 70 && dy < 80) closeDm();
      }, { passive: true });
    }
  }

  window.alpineOpenDm = openDm;
  window.alpineCloseDm = closeDm;

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(boot, 300);
  setTimeout(boot, 1200);
})();
</script>

<script>
/* Proxy wave line indicator — live wave + click toggles real circumvention */
(function () {
  const W = 320;
  const MID = 18;
  const AMP_ON = 8;
  const FREQ = 3; // cycles across width
  const SPEED = 0.0045; // phase speed

  let targetOn = false;
  let amp = 0; // 0..1 current amplitude factor
  let phase = 0;
  let raf = 0;
  let bound = false;

  function buildPath(amplitude, ph) {
    // denser points for smooth curve
    const step = 4;
    let d = '';
    for (let x = 0; x <= W; x += step) {
      const y = MID + Math.sin((x / W) * Math.PI * 2 * FREQ + ph) * AMP_ON * amplitude;
      d += (x === 0 ? 'M' : 'L') + x + ' ' + y.toFixed(2) + ' ';
    }
    return d.trim();
  }

  function paint() {
    const path = document.getElementById('proxyWavePath');
    if (!path) return;
    path.setAttribute('d', buildPath(amp, phase));
  }

  function loop(now) {
    const wrap = document.getElementById('proxyWaveWrap');
    const path = document.getElementById('proxyWavePath');
    if (!path) { raf = 0; return; }

    // smooth amplitude toward target
    const goal = targetOn ? 1 : 0;
    amp += (goal - amp) * 0.08;
    if (Math.abs(goal - amp) < 0.002) amp = goal;

    if (amp > 0.01) {
      phase += SPEED * 16; // ~60fps normalized
      if (phase > Math.PI * 2) phase -= Math.PI * 2;
    }

    paint();
    if (wrap) wrap.classList.toggle('is-active', amp > 0.15);

    // keep looping while visible / transitioning / active
    if (amp > 0.001 || targetOn || Math.abs(goal - amp) > 0.001) {
      raf = requestAnimationFrame(loop);
    } else {
      paint(); // final flat
      raf = 0;
    }
  }

  function ensureLoop() {
    if (!raf) raf = requestAnimationFrame(loop);
  }

  function setWave(on, instant) {
    targetOn = !!on;
    if (instant) {
      amp = targetOn ? 1 : 0;
      paint();
      const wrap = document.getElementById('proxyWaveWrap');
      if (wrap) wrap.classList.toggle('is-active', targetOn);
    }
    ensureLoop();
  }

  window.syncProxyWaveIndicator = function (on) {
    setWave(!!on, false);
  };

  function isConnected() {
    try {
      return !!(typeof proxyEnabled !== 'undefined' && proxyEnabled &&
        typeof proxyConfig !== 'undefined' && proxyConfig && proxyConfig.connected);
    } catch (_) { return false; }
  }

  function isActiveState() {
    try {
      const connected = isConnected();
      const modeOn = typeof circumventionMode !== 'undefined' && circumventionMode !== 'off';
      const act = typeof circumventionActive !== 'undefined' && circumventionActive;
      return !!(connected && (act || modeOn));
    } catch (_) { return false; }
  }

  async function onWaveClick(e) {
    if (e) { e.preventDefault(); e.stopPropagation(); }
    try {
      if (typeof isProxyFeatureEnabled === 'function' && !isProxyFeatureEnabled()) {
        if (typeof proxyFeatureBlockedToast === 'function') proxyFeatureBlockedToast();
        else if (typeof toast === 'function') toast('Включите «Тестирование новых функций»');
        return;
      }
    } catch (_) {}

    try {
      const on = isActiveState();
      if (on) {
        if (typeof deactivateCircumvention === 'function') deactivateCircumvention();
        // visual feedback immediately
        setWave(false, false);
        if (typeof toast === 'function') toast('Обход выключен');
      } else {
        // ensure mode is not off so connection sticks
        try {
          if (typeof circumventionMode !== 'undefined' && circumventionMode === 'off') {
            circumventionMode = 'auto';
            const sel = document.getElementById('circumventionMode');
            if (sel) sel.value = 'auto';
            if (typeof saveData === 'function') saveData();
          }
        } catch (_) {}
        // optimistic wave while connecting
        setWave(true, false);
        if (typeof activateCircumvention === 'function') {
          await activateCircumvention('индикатор');
        }
        if (typeof toast === 'function') toast(isConnected() ? 'Обход включён' : 'Подключение…');
      }
      try { if (typeof updateCircumventionUI === 'function') updateCircumventionUI(); } catch (_) {}
      try { if (typeof updateProxyUI === 'function') updateProxyUI(); } catch (_) {}
      // re-sync to real state after async
      setTimeout(() => setWave(isActiveState(), false), 300);
      setTimeout(() => setWave(isActiveState(), false), 1200);
    } catch (err) {
      console.warn('wave click', err);
      setWave(isActiveState(), false);
    }
  }

  function bindClick() {
    const wrap = document.getElementById('proxyWaveWrap');
    if (!wrap || wrap.__waveBound) return;
    wrap.__waveBound = true;
    wrap.addEventListener('click', onWaveClick);
    wrap.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        onWaveClick(e);
      }
    });
  }

  function boot() {
    bindClick();
    setWave(isActiveState(), true);
    ensureLoop();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(boot, 400);
  setTimeout(boot, 1200);
})();
</script>

