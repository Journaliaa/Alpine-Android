    function getFilteredPosts() {
      try {
        if (!window.hiddenPostIds) {
          window.hiddenPostIds = JSON.parse(localStorage.getItem('nivadagram_hidden_posts') || '[]');
        }
      } catch (e) { window.hiddenPostIds = []; }
      const hidden = new Set((window.hiddenPostIds || []).map(Number));
      let list = [...posts].filter(p => !isBlockedName(p.authorName) && !hidden.has(Number(p.id)));
      const myName = profile.name || 'Мой профиль';
      const myUser = String((profile && profile.username) || '').replace(/^@/, '').toLowerCase();
      // Circle / only_me visibility
      try {
        const circle = (typeof window.getCircleMembers === 'function') ? window.getCircleMembers() : [];
        const circleSet = new Set(circle.map(x => String(x).toLowerCase().replace(/^@/, '')));
        list = list.filter(p => {
          const vis = p.visibility || (p.circleOnly ? 'circle' : 'everyone');
          const author = String(p.authorName || '').toLowerCase();
          const authorU = String(p.authorUsername || p.authorId || '').toLowerCase().replace(/^@/, '');
          const isMine = author === String(myName).toLowerCase() || authorU === myUser;
          if (vis === 'everyone' || !vis) return true;
          if (vis === 'only_me') return isMine;
          if (vis === 'circle' || p.circleOnly) {
            if (isMine) return true;
            return circleSet.has(author) || circleSet.has(authorU);
          }
          return true;
        });
      } catch (e) {}

      if (wallFilter === 'mine') {
        list = list.filter(p => p.authorName === myName);
      } else if (wallFilter === 'following') {
        const names = new Set(peopleCatalog.filter(p => isFollowing(p.id)).map(p => p.name));
        list = list.filter(p => names.has(p.authorName) || following.includes(String(p.authorName)));
      } else {
        if (privacyHideFeed) list = list.filter(p => p.authorName !== myName);
      }
      const q = (wallSearchQuery || '').trim().toLowerCase();
      if (q) {
        list = list.filter(p =>
          (p.text || '').toLowerCase().includes(q) ||
          (p.authorName || '').toLowerCase().includes(q)
        );
      }
      // Simple, predictable sorting controlled in Wall settings.
      list.sort((a, b) => wallSortOrder === 'oldest' ? (a.time || 0) - (b.time || 0) : (b.time || 0) - (a.time || 0));
