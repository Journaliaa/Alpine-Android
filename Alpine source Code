<script>
/* ===== Onboarding + TG motion helpers ===== */
(function () {
  const OB_KEY = 'alpine_onboarding_done_v1';
  let step = 0;

  function done() {
    try { localStorage.setItem(OB_KEY, '1'); } catch (_) {}
    const el = document.getElementById('alpineOnboarding');
    if (el) {
      el.classList.remove('show');
      el.setAttribute('aria-hidden', 'true');
    }
  }

  function showStep(n) {
    step = n;
    document.querySelectorAll('#alpineOnboarding [data-ob-step]').forEach(card => {
      const s = Number(card.getAttribute('data-ob-step'));
      card.style.display = s === n ? 'block' : 'none';
    });
    document.querySelectorAll('#obDots span').forEach((d, i) => d.classList.toggle('on', i === n));
    const btn = document.getElementById('obNext');
    if (btn) btn.textContent = n >= 2 ? 'Get started' : 'Continue';
  }

  function openOnboarding() {
    const el = document.getElementById('alpineOnboarding');
    if (!el) return;
    el.classList.add('show');
    el.setAttribute('aria-hidden', 'false');
    try {
      const lang = localStorage.getItem('appLang') || 'en';
      const sel = document.getElementById('obLang');
      if (sel) sel.value = ['en','ru','uk'].includes(lang) ? lang : 'en';
      if (typeof profile !== 'undefined' && profile) {
        const n = document.getElementById('obName');
        const u = document.getElementById('obUser');
        if (n && profile.name && profile.name !== 'Guest' && profile.name !== 'My profile' && profile.name !== 'Мой профиль') n.value = profile.name;
        if (u && profile.username) u.value = String(profile.username).replace(/^@/, '');
      }
    } catch (_) {}
    showStep(0);
  }

  function applyProfileFromOb() {
    try {
      const name = (document.getElementById('obName')?.value || '').trim();
      const user = (document.getElementById('obUser')?.value || '').trim().replace(/^@/, '').replace(/\s+/g, '_').slice(0, 24);
      const lang = document.getElementById('obLang')?.value || 'en';
      try { localStorage.setItem('appLang', lang); } catch (_) {}
      if (typeof appLang !== 'undefined') window.appLang = lang;
      try {
        if (typeof applyI18n === 'function') applyI18n();
      } catch (_) {}
      if (typeof profile !== 'undefined' && profile) {
        if (name) profile.name = name;
      try { if (typeof regRegion !== 'undefined' && regRegion) { profile.country = regRegion; profile.region = regRegion; } } catch (e) {};
        if (user) profile.username = user;
        try { if (typeof saveData === 'function') saveData(); } catch (_) {}
        try { if (typeof renderProfileSummary === 'function') renderProfileSummary(); } catch (_) {}
      }
      const ls = document.getElementById('languageSetting');
      if (ls) ls.value = lang;
    } catch (_) {}
  }

  function bootOb() {
    // Onboarding merged into auth screen — do not show separate wizard
    try { localStorage.setItem(OB_KEY, '1'); } catch (_) {}
    const el = document.getElementById('alpineOnboarding');
