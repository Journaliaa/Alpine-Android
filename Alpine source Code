<script>
/* Auth menu fix + stepped register (lang/region) */
(function () {
  function showAuthErrorSafe(msg) {
    try {
      if (typeof showAuthError === 'function') showAuthError(msg || '');
      else {
        const el = document.getElementById('authError');
        if (el) { el.textContent = msg || ''; el.style.display = msg ? 'block' : 'none'; }
      }
    } catch (_) {}
  }

  function setMode(mode) {
    try {
      if (typeof setAuthMode === 'function') setAuthMode(mode);
      else {
        const screen = document.getElementById('authScreen');
        if (screen) {
          screen.classList.toggle('mode-register', mode === 'register');
          screen.classList.remove('mode-code');
        }
        document.getElementById('authTabLogin')?.classList.toggle('active', mode === 'login');
        document.getElementById('authTabRegister')?.classList.toggle('active', mode === 'register');
      }
    } catch (e) { console.warn(e); }
    if (mode === 'register') showRegStep(0);
  }

  function setDots(step) {
    document.querySelectorAll('#regStepDots span').forEach((s, i) => s.classList.toggle('on', i === step));
  }

  function showRegStep(n) {
    document.querySelectorAll('#authRegisterForm [data-reg-step]').forEach(el => {
      const s = Number(el.getAttribute('data-reg-step'));
      if (s === n) el.removeAttribute('hidden');
      else el.setAttribute('hidden', '');
    });
    setDots(n);
    const ids = ['regLang', 'regName', 'regUser', 'regEmail', 'regPass'];
    try { document.getElementById(ids[n])?.focus(); } catch (_) {}
  }

  function applyRegLangRegion() {
    const lang = document.getElementById('regLang')?.value || 'en';
    const region = document.getElementById('regRegion')?.value || '';
    try { localStorage.setItem('appLang', lang); } catch (_) {}
    try { window.appLang = lang; } catch (_) {}
    try {
      if (typeof profile !== 'undefined' && profile) {
        profile.country = region;
        profile.region = region;
      }
    } catch (_) {}
    try { if (typeof applyI18n === 'function') applyI18n(); } catch (_) {}
    const authLang = document.getElementById('authLang');
    if (authLang) authLang.value = lang;
  }

  function bind() {
    // Tabs unified menu
    document.getElementById('authTabLogin')?.addEventListener('click', e => {
      e.preventDefault();
      setMode('login');
    });
    document.getElementById('authTabRegister')?.addEventListener('click', e => {
      e.preventDefault();
      setMode('register');
    });
    document.getElementById('authSwitchToLogin')?.addEventListener('click', e => {
      e.preventDefault();
      setMode('login');
    });
    document.getElementById('authSwitchToRegister')?.addEventListener('click', e => {
      e.preventDefault();
      setMode('register');
    });

    document.getElementById('regStepNext0')?.addEventListener('click', () => {
      applyRegLangRegion();
      showAuthErrorSafe('');
      showRegStep(1);
    });
    document.getElementById('regStepNext1')?.addEventListener('click', () => {
      const v = (document.getElementById('regName')?.value || '').trim();
      if (!v) return showAuthErrorSafe('Enter your name');
      showAuthErrorSafe('');
      showRegStep(2);
    });
    document.getElementById('regStepNext2')?.addEventListener('click', () => {
      const v = (document.getElementById('regUser')?.value || '').trim();
      if (!v || v.length < 3) return showAuthErrorSafe('Username: at least 3 characters');
      if (!/^[A-Za-z0-9_]+$/.test(v)) return showAuthErrorSafe('Letters, numbers, underscore only');
      showAuthErrorSafe('');
      showRegStep(3);
    });
    document.getElementById('regStepNext3')?.addEventListener('click', () => {
      const v = (document.getElementById('regEmail')?.value || '').trim();
      if (!v || !v.includes('@')) return showAuthErrorSafe('Enter a valid email');
      showAuthErrorSafe('');
      showRegStep(4);
    });
    document.getElementById('regStepBack1')?.addEventListener('click', () => { showAuthErrorSafe(''); showRegStep(0); });
    document.getElementById('regStepBack2')?.addEventListener('click', () => { showAuthErrorSafe(''); showRegStep(1); });
    document.getElementById('regStepBack3')?.addEventListener('click', () => { showAuthErrorSafe(''); showRegStep(2); });
    document.getElementById('regStepBack4')?.addEventListener('click', () => { showAuthErrorSafe(''); showRegStep(3); });

    // Before register submit, apply lang/region once more
    document.getElementById('authRegisterBtn')?.addEventListener('click', () => {
      applyRegLangRegion();
    }, true);

    // Ensure login button works: both fields visible
    document.getElementById('authLoginBtn')?.addEventListener('click', () => {
      // if original handler is async via safeAsync, just ensure fields filled feedback
      const u = (document.getElementById('loginUser')?.value || '').trim();
      const p = document.getElementById('loginPass')?.value || '';
      if (!u || !p) showAuthErrorSafe('Enter username and password');
    }, true);

    // Default to login menu
    setMode('login');
    showRegStep(0);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
  else bind();
  setTimeout(bind, 500);
})();
</script>


