    function renderLocalDeviceSession(notice) {
      const list = document.getElementById('deviceSessionsList');
      const note = document.getElementById('deviceSessionsNotice');
      if (!list) return;
      list.innerHTML = `<div class="device-session-item"><span class="device-session-icon material-icons-round">devices</span><div class="device-session-meta"><strong>${escapeHtml(currentBrowserLabel())} <span class="device-current-tag">Текущее устройство</span></strong><small>Активно сейчас · ${escapeHtml(currentUser?.email || currentUser?.username || 'локальная сессия')}</small></div><button type="button" class="btn btn-text device-end-session" data-end-session="local-current">Завершить сеанс</button></div>`;
      if (note) note.textContent = notice || 'Серверный список сеансов недоступен. Здесь показан только текущий браузер; другие устройства без API сервера определить нельзя.';
    }
    function renderRemoteDeviceSessions(sessions) {
      const list = document.getElementById('deviceSessionsList');
      const note = document.getElementById('deviceSessionsNotice');
      if (!list) return;
      const valid = Array.isArray(sessions) ? sessions.filter(s => s && (s.id != null || s.sessionId != null)) : [];
      if (!valid.length) {
        list.innerHTML = '<p class="setting-sub">Нет активных сеансов, возвращённых сервером.</p>';
      } else {
        list.innerHTML = valid.map(s => {
          const id = String(s.id ?? s.sessionId);
          const label = String(s.deviceName || s.device || s.browser || s.userAgent || 'Неизвестное устройство');
          const meta = [s.ip ? 'IP ' + s.ip : '', s.lastActiveAt || s.lastSeen ? 'Активность: ' + new Date(s.lastActiveAt || s.lastSeen).toLocaleString() : '', s.createdAt ? 'Вход: ' + new Date(s.createdAt).toLocaleString() : ''].filter(Boolean).join(' · ');
          return `<div class="device-session-item"><span class="device-session-icon material-icons-round">${s.current || s.isCurrent ? 'devices' : 'phonelink'}</span><div class="device-session-meta"><strong>${escapeHtml(label)}${s.current || s.isCurrent ? ' <span class="device-current-tag">Текущее устройство</span>' : ''}</strong><small>${escapeHtml(meta || 'Сведения предоставлены сервером')}</small></div><button type="button" class="btn btn-text device-end-session" data-end-session="${escapeHtml(id)}">Завершить</button></div>`;
        }).join('');
      }
      if (note) note.textContent = 'Список получен от сервера. Завершение удалённых сеансов требует работающего серверного API.';
    }
    async function refreshDeviceSessions() {
      const list = document.getElementById('deviceSessionsList');
      if (list) list.innerHTML = '<p class="setting-sub">Загрузка сеансов…</p>';
      if (!currentUser || currentUser.guest) {
        if (list) list.innerHTML = '<p class="setting-sub">Войдите в аккаунт, чтобы управлять сеансами.</p>';
        const note = document.getElementById('deviceSessionsNotice');
        if (note) note.textContent = 'Гостевой режим не имеет серверного списка аккаунтных сеансов.';
        return;
      }
      try {
        const res = await fetch('/api/auth/sessions', { credentials: 'same-origin', cache: 'no-store', headers: { 'Accept': 'application/json' } });
        if (!res.ok) throw new Error('Sessions API unavailable');
        const data = await res.json();
        if (!data || !Array.isArray(data.sessions)) throw new Error('Invalid sessions response');
        renderRemoteDeviceSessions(data.sessions);
      } catch (_) {
        renderLocalDeviceSession();
      }
    }
    function refreshDeviceQr() {
      const img = document.getElementById('devicePairQr');
      const fallback = document.getElementById('devicePairQrFallback');
      if (!img || !fallback) return;
      if (!/^https?:$/.test(location.protocol) || !location.origin || location.origin === 'null') {
        img.hidden = true;
        fallback.hidden = false;
        fallback.innerHTML = '<span class="material-icons-round">qr_code_2</span><span>QR-код доступен, когда приложение запущено по HTTPS</span>';
        return;
      }
      const appUrl = location.origin + location.pathname;
      img.onerror = () => { img.hidden = true; fallback.hidden = false; fallback.innerHTML = '<span class="material-icons-round">qr_code_2</span><span>Не удалось загрузить QR-код. Откройте адрес приложения на втором устройстве.</span>'; };
      // Only the public app URL is encoded. No password, account identifier, or session token is sent to the QR renderer.
      img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=220x220&margin=8&data=' + encodeURIComponent(appUrl);
      img.alt = 'QR-код адреса приложения';
      img.hidden = false;
      fallback.hidden = true;
    }
