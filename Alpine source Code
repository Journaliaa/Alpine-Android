<script>
/* ===== Nav layout: side (default) vs bottom ===== */
(function () {
  const KEY = 'alpine_nav_layout_v1';

  function getNavLayout() {
    try {
      const v = localStorage.getItem(KEY);
      if (v === 'bottom' || v === 'side') return v;
    } catch (_) {}
    return 'side';
  }

  function applyNavLayout(mode) {
    mode = mode === 'bottom' ? 'bottom' : 'side';
    document.body.classList.remove('nav-mode-side', 'nav-mode-bottom');
    document.documentElement.classList.remove('nav-mode-side', 'nav-mode-bottom');
    const cls = mode === 'bottom' ? 'nav-mode-bottom' : 'nav-mode-side';
    document.body.classList.add(cls);
    document.documentElement.classList.add(cls);
    // Keep has-bottom-nav only as spacing helper when bottom mode
    if (mode === 'bottom') document.body.classList.add('has-bottom-nav');
    else document.body.classList.remove('has-bottom-nav');

    // Fully hide drawer chrome in bottom mode
    try {
      if (mode === 'bottom') {
        const side = document.getElementById('sidebar');
        if (side) {
          side.classList.remove('open', 'show', 'active', 'visible');
          side.setAttribute('aria-hidden', 'true');
        }
        document.getElementById('drawerEdgeHit')?.setAttribute('aria-hidden', 'true');
        document.getElementById('navRail')?.setAttribute('aria-hidden', 'true');
        if (typeof closeDrawer === 'function') closeDrawer();
      }
    } catch (_) {}

    // Hide hamburger buttons
    document.querySelectorAll('#wallMenuBtn, #musicMenuBtn, #communityMenuBtn, #pluginsMenuBtn').forEach(btn => {
      if (mode === 'bottom') {
        btn.setAttribute('data-nav-hidden', '1');
        btn.style.display = 'none';
      } else {
        btn.removeAttribute('data-nav-hidden');
        btn.style.display = '';
      }
    });
    // Any openDrawer triggers on menu icons
    document.querySelectorAll('button[onclick*="openDrawer"], button[title="Menu"]').forEach(btn => {
      if (btn.id === 'bnHome' || btn.closest('#alpineBottomNav')) return;
      if (mode === 'bottom') {
        if (btn.querySelector('.material-icons-round')?.textContent?.trim() === 'menu' || btn.id.endsWith('MenuBtn')) {
          btn.style.display = 'none';
        }
      } else if (btn.style.display === 'none' && (btn.id.endsWith('MenuBtn') || btn.getAttribute('data-nav-hidden'))) {
        btn.style.display = '';
      }
    });

    const sel = document.getElementById('navLayoutSetting');
    if (sel && sel.value !== mode) sel.value = mode;

    try { localStorage.setItem(KEY, mode); } catch (_) {}
  }

  function boot() {
    applyNavLayout(getNavLayout());
    const sel = document.getElementById('navLayoutSetting');
    if (sel) {
      sel.value = getNavLayout();
      sel.addEventListener('change', () => {
        applyNavLayout(sel.value === 'bottom' ? 'bottom' : 'side');
        try { if (typeof toast === 'function') toast(sel.value === 'bottom' ? 'Bottom navigation' : 'Side panel navigation'); } catch (_) {}
      });
    }
    // Re-apply after other UI boots (profile/wall headers may re-show menu)
    setTimeout(() => applyNavLayout(getNavLayout()), 800);
    setTimeout(() => applyNavLayout(getNavLayout()), 2500);
  }

  window.applyNavLayout = applyNavLayout;
  window.getNavLayout = getNavLayout;

  // Guard openDrawer in bottom mode
  function patchOpenDrawer() {
    if (typeof openDrawer !== 'function' || openDrawer.__navGuard) return;
    const orig = openDrawer;
    window.openDrawer = function () {
      if (getNavLayout() === 'bottom') return;
      return orig.apply(this, arguments);
    };
    window.openDrawer.__navGuard = true;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => { boot(); patchOpenDrawer(); });
  } else {
    boot();
    patchOpenDrawer();
  }
  setTimeout(patchOpenDrawer, 1500);
})();
</script>


<script>
/* ===== Fast Telegram-like chats + app snappiness ===== */
(function () {
  document.body.classList.add('chat-fast');

  // Swipe from left edge to go back to chat list (mobile TG gesture)
  (function bindChatSwipeBack() {
    const ac = document.getElementById('activeChat');
    if (!ac || ac.__swipeBack) return;
    ac.__swipeBack = true;
    let x0 = 0, y0 = 0, tracking = false;
    ac.addEventListener('touchstart', e => {
      if (!e.touches[0]) return;
      if (e.touches[0].clientX < 28) {
        tracking = true;
        x0 = e.touches[0].clientX;
        y0 = e.touches[0].clientY;
      } else tracking = false;
    }, { passive: true });
    ac.addEventListener('touchend', e => {
      if (!tracking || !e.changedTouches[0]) return;
      const dx = e.changedTouches[0].clientX - x0;
      const dy = Math.abs(e.changedTouches[0].clientY - y0);
      tracking = false;
      if (dx > 70 && dy < 80) {
        try {
          if (typeof goBackToChatList === 'function') goBackToChatList();
          else {
            document.body.classList.remove('chat-conversation-open');
            document.getElementById('sidebar')?.classList.remove('hidden');
            const panel = document.getElementById('activeChat');
            if (panel) { panel.style.display = 'none'; panel.classList.remove('is-chat-open'); }
          }
        } catch (_) {}
      }
    }, { passive: true });
  })();

  // Event delegation for chat list — faster than per-item handlers when re-rendered
  (function bindChatListDelegation() {
    const list = document.getElementById('chatList') || document.querySelector('.chat-list');
    if (!list || list.__fastClick) return;
    list.__fastClick = true;
    list.addEventListener('click', e => {
      const item = e.target.closest('[data-id], .chat-item[data-chat-id], .chat-item');
      if (!item) return;
      if (e.target.closest('button, .chat-item-menu, .icon-btn')) return;
      const id = item.getAttribute('data-id') || item.getAttribute('data-chat-id') || item.dataset.id;
      if (id != null && id !== '' && typeof openChat === 'function') {
        e.preventDefault();
        openChat(id);
      }
    }, { passive: false });
  })();

  // Debounced saveData for chat actions
  if (typeof saveData === 'function' && !saveData.__debouncedChat) {
    const orig = saveData;
    let t = null;
    window.saveData = function () {
      if (window.__forceSaveNow) {
        window.__forceSaveNow = false;
        return orig.apply(this, arguments);
      }
      clearTimeout(t);
      t = setTimeout(() => orig.apply(this, arguments), 280);
    };
    window.saveData.__debouncedChat = true;
    window.saveDataNow = function () {
      window.__forceSaveNow = true;
      clearTimeout(t);
      return orig.apply(this, arguments);
    };
  }

  // Smooth scroll to bottom helper after send
  window.scrollMessagesToEnd = function () {
    const el = document.getElementById('messages');
    if (!el) return;
    requestAnimationFrame(() => { el.scrollTop = el.scrollHeight; });
  };

  // Patch goBackToChatList to always show list on mobile
  if (typeof goBackToChatList === 'function' && !goBackToChatList.__fast) {
    const origBack = goBackToChatList;
    window.goBackToChatList = function (e) {
      const r = origBack.apply(this, arguments);
      try {
        const side = document.getElementById('sidebar');
        if (side) {
          side.classList.remove('hidden');
          side.style.display = 'flex';
          side.style.transform = 'none';
          side.style.visibility = 'visible';
        }
        document.body.classList.remove('chat-conversation-open');
        document.querySelector('.app')?.classList.remove('wall-mode');
      } catch (_) {}
      return r;
    };
    window.goBackToChatList.__fast = true;
  }

  // Reduce layout thrash: passive touch on message list
  const msgs = document.getElementById('messages');
  if (msgs) msgs.style.webkitOverflowScrolling = 'touch';

  // When bottom nav Messages pressed twice — already on list
  document.getElementById('bnMessages')?.addEventListener('click', () => {
    try {
      if (document.body.classList.contains('chat-conversation-open') && typeof goBackToChatList === 'function') {
        goBackToChatList();
      }
    } catch (_) {}
  });
})();
</script>


<script>
/* ===== FORCE chat load fix v2 ===== */
(function () {
  function forceShowConversation() {
    document.body.classList.add('chat-conversation-open');
    document.body.classList.remove('wall-mode');
    document.documentElement.classList.remove('wall-mode');
    document.querySelector('.app')?.classList.remove('wall-mode');
    document.getElementById('wallPage')?.classList.remove('show');
    const es = document.getElementById('emptyState');
    if (es) es.style.display = 'none';
    const ac = document.getElementById('activeChat');
    if (ac) {
      ac.classList.add('is-chat-open');
      ac.style.setProperty('display', 'flex', 'important');
      ac.style.setProperty('flex-direction', 'column', 'important');
      ac.style.setProperty('height', '100%', 'important');
      ac.style.setProperty('min-height', '50dvh', 'important');
      ac.style.setProperty('visibility', 'visible', 'important');
      ac.style.setProperty('opacity', '1', 'important');
      ac.style.setProperty('width', '100%', 'important');
    }
    const msgs = document.getElementById('messages');
    if (msgs) {
      msgs.style.setProperty('display', 'flex', 'important');
      msgs.style.setProperty('flex-direction', 'column', 'important');
      msgs.style.setProperty('flex', '1 1 auto', 'important');
      msgs.style.setProperty('min-height', '240px', 'important');
      msgs.style.setProperty('overflow-y', 'auto', 'important');
      msgs.style.setProperty('visibility', 'visible', 'important');
      msgs.style.setProperty('opacity', '1', 'important');
      msgs.style.setProperty('content-visibility', 'visible', 'important');
    }
    if (window.matchMedia('(max-width: 900px)').matches) {
      document.getElementById('sidebar')?.classList.add('hidden');
    }
  }

  function escapeText(s) {
    return String(s || '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  }

  function simpleRenderMessages(chat) {
    const el = document.getElementById('messages');
    if (!el || !chat) return;
    if (!Array.isArray(chat.messages)) chat.messages = [];
    if (!chat.messages.length) {
      el.innerHTML = '<div style="text-align:center;padding:48px 16px;color:#8b98a5;margin:auto">No messages yet<br><span style="font-size:13px">Write a message below</span></div>';
      return;
    }
    const parts = [];
    chat.messages.forEach(m => {
      if (!m) return;
      if (m.system || m.service) {
        parts.push('<div style="text-align:center;margin:8px;font-size:12px;color:#8b98a5">' + escapeText(m.text || '') + '</div>');
        return;
      }
      const isOut = !!(m.outgoing || m.out || m.fromMe);
      const text = m.deletedForAll ? '<i>Message deleted</i>' : escapeText(m.text || (m.image ? '📷 Photo' : m.voice ? '🎤 Voice' : m.attachment ? '📎 Attachment' : '') || '·');
      parts.push(
        '<div class="message ' + (isOut ? 'outgoing' : 'incoming') + '" data-id="' + String(m.id || '') + '" style="display:flex;align-self:' + (isOut ? 'flex-end' : 'flex-start') + ';max-width:85%;margin:3px 0">' +
        '<div class="bubble" style="padding:8px 12px;border-radius:14px;background:' + (isOut ? 'var(--md-sys-color-primary,#1d9bf0)' : 'var(--md-sys-color-surface-container,#333)') + ';color:var(--md-sys-color-on-primary, #fff);font-size:15px;line-height:1.35;word-break:break-word">' +
        text +
        (m.time ? '<div style="font-size:11px;opacity:.7;margin-top:4px;text-align:right">' + new Date(m.time).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) + '</div>' : '') +
        '</div></div>'
      );
    });
    el.innerHTML = parts.join('');
    el.scrollTop = el.scrollHeight;
  }

  window.simpleRenderMessages = simpleRenderMessages;
  window.forceShowConversation = forceShowConversation;

  function paintChat(id) {
    const ch = (typeof chats !== 'undefined' ? chats : []).find(c => String(c.id) === String(id));
    if (!ch) return;
    if (!Array.isArray(ch.messages)) ch.messages = [];
    forceShowConversation();
    const hn = document.getElementById('headerName');
    if (hn) hn.textContent = ch.name || 'Chat';
    // Prefer full renderer, always fall back
    let painted = false;
    try {
      if (typeof renderMessages === 'function') {
        renderMessages(ch);
        const el = document.getElementById('messages');
        if (el && el.innerHTML && el.innerHTML.trim().length > 15) painted = true;
      }
    } catch (e) { console.warn('renderMessages', e); }
    if (!painted) simpleRenderMessages(ch);
    const el = document.getElementById('messages');
    if (el) el.scrollTop = el.scrollHeight;
  }

  function wrapOpenChat() {
    if (typeof openChat !== 'function') return false;
    if (openChat.__forceLoadFixV2) return true;
    const orig = openChat;
    window.openChat = function (id) {
      forceShowConversation();
      let result;
      try { result = orig.apply(this, arguments); } catch (err) { console.error(err); }
      // Always paint after
      try { paintChat(id); } catch (e) { console.error(e); }
      requestAnimationFrame(() => { try { paintChat(id); } catch (e) {} });
      setTimeout(() => { try { paintChat(id); } catch (e) {} }, 30);
      setTimeout(() => { try { paintChat(id); } catch (e) {} }, 120);
      return result;
    };
    window.openChat.__forceLoadFixV2 = true;
    // Also wrap sendMessage to repaint
    if (typeof sendMessage === 'function' && !sendMessage.__repaint) {
      const os = sendMessage;
      window.sendMessage = function () {
        const r = os.apply(this, arguments);
        try {
          if (typeof activeChatId !== 'undefined' && activeChatId != null) {
            setTimeout(() => paintChat(activeChatId), 0);
          }
        } catch (e) {}
        return r;
      };
      window.sendMessage.__repaint = true;
    }
    return true;
  }

  function boot() {
    if (!wrapOpenChat()) setTimeout(boot, 150);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(wrapOpenChat, 400);
  setTimeout(wrapOpenChat, 1200);
  setTimeout(wrapOpenChat, 2500);
})();
</script>


<script>
/* ===== Plus · Push · E2E sync pack · chat polish ===== */
(function () {
  const PLUS_KEY = 'alpine_plus_v1';
  const PUSH_KEY = 'alpine_push_enabled_v1';

  function toastSafe(m) { try { if (typeof toast === 'function') toast(m); } catch (_) {} }

  function isPlus() {
    try { return localStorage.getItem(PLUS_KEY) === '1'; } catch (_) { return false; }
  }
  function setPlus(on) {
    try { localStorage.setItem(PLUS_KEY, on ? '1' : '0'); } catch (_) {}
    const sw = document.getElementById('plusSwitch');
    if (sw) sw.classList.toggle('on', !!on);
    const sub = document.getElementById('plusStatusSub');
    if (sub) {
      sub.textContent = on
        ? ('Plus · ' + (typeof getVaultMax === 'function' ? getVaultMax() : 200) + ' vault photos + sync pack')
        : ('Free · 50 vault photos. Plus · 200 photos + sync pack.');
    }
  }

  // --- Web Push / Notifications ---
  async function enablePush() {
    if (!('Notification' in window)) {
      toastSafe('Notifications not supported in this browser');
      return;
    }
    try {
      let perm = Notification.permission;
      if (perm !== 'granted') {
        perm = await Notification.requestPermission();
      }
      if (perm !== 'granted') {
        toastSafe('Permission denied');
        try { localStorage.setItem(PUSH_KEY, '0'); } catch (_) {}
        return;
      }
      try { localStorage.setItem(PUSH_KEY, '1'); } catch (_) {}
      // Optional SW for future real push
      if ('serviceWorker' in navigator) {
        try {
          const reg = await navigator.serviceWorker.getRegistration();
          if (!reg) {
            // lightweight SW via blob
            const swCode = `
              self.addEventListener('notificationclick', function(e) {
                e.notification.close();
                const data = e.notification.data || {};
                e.waitUntil(clients.matchAll({ type: 'window', includeUncontrolled: true }).then(function(list) {
                  if (list && list[0]) { list[0].focus(); list[0].postMessage({ type: 'alpine_notif_click', data: data }); }
                  else if (clients.openWindow) return clients.openWindow('./');
                }));
              });
              self.addEventListener('push', function(e) {
                var payload = { title: 'Alpine', body: 'New activity' };
                try { if (e.data) payload = Object.assign(payload, e.data.json()); } catch (err) {}
                e.waitUntil(self.registration.showNotification(payload.title || 'Alpine', {
                  body: payload.body || '',
                  data: payload.data || {},
                  icon: payload.icon
                }));
              });
            `;
            const blob = new Blob([swCode], { type: 'text/javascript' });
            const url = URL.createObjectURL(blob);
            await navigator.serviceWorker.register(url).catch(() => {});
          }
        } catch (e) { console.warn(e); }
      }
      // Test notification
      try {
        new Notification('Alpine', { body: 'Push enabled — you will get activity alerts on this device.', tag: 'alpine-push-on' });
      } catch (e) {
        try {
          const reg = await navigator.serviceWorker.ready;
          reg.showNotification('Alpine', { body: 'Push enabled on this device.', tag: 'alpine-push-on' });
        } catch (e2) {}
      }
      toastSafe('Push enabled');
    } catch (e) {
      console.warn(e);
      toastSafe('Could not enable push');
    }
  }

  function notifyLocal(title, body, data) {
    try {
      if (localStorage.getItem(PUSH_KEY) !== '1') return;
      if (!('Notification' in window) || Notification.permission !== 'granted') return;
      const n = new Notification(title || 'Alpine', {
        body: body || '',
        tag: (data && (data.chatId || data.postId)) ? String(data.chatId || data.postId) : undefined,
        data: data || {}
      });
      n.onclick = () => {
        try { window.focus(); } catch (_) {}
        try {
          if (data && data.chatId && typeof openChat === 'function') {
            if (typeof openMessagesNav === 'function') openMessagesNav();
            openChat(data.chatId);
          } else if (data && data.postId && typeof openThread === 'function') {
            if (typeof openWallPage === 'function') openWallPage();
            openThread(data.postId);
          }
        } catch (_) {}
        try { n.close(); } catch (_) {}
      };
    } catch (_) {}
  }
  window.alpineNotify = notifyLocal;

  // Hook: when notifications array gets a new item via pushNotif if exists
  function wrapAddNotification() {
    if (typeof addNotification === 'function' && !addNotification.__push) {
      const orig = addNotification;
      window.addNotification = function (item) {
        const r = orig.apply(this, arguments);
        try {
          if (item && item.text) {
            notifyLocal('Alpine', item.text, { postId: item.postId, chatId: item.chatId, type: item.type });
          }
        } catch (_) {}
        return r;
      };
      addNotification.__push = true;
    }
  }

  // --- E2E sync pack (export/import encrypted-ish with password) ---
  async function deriveKey(password, salt) {
    const enc = new TextEncoder();
    const base = await crypto.subtle.importKey('raw', enc.encode(password), 'PBKDF2', false, ['deriveKey']);
    return crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt, iterations: 120000, hash: 'SHA-256' },
      base,
      { name: 'AES-GCM', length: 256 },
      false,
      ['encrypt', 'decrypt']
    );
  }

  async function exportSyncPack() {
    const password = prompt('Password for E2E sync pack (remember it — required to import):');
    if (!password) return;
    try {
      const payload = {
        v: 1,
        exportedAt: Date.now(),
        profile: typeof profile !== 'undefined' ? profile : null,
        chats: typeof chats !== 'undefined' ? chats : [],
        posts: typeof posts !== 'undefined' ? posts : [],
        following: typeof following !== 'undefined' ? following : [],
        notifications: typeof notifications !== 'undefined' ? notifications.slice(0, 100) : [],
        plus: isPlus()
      };
      // vault photos if unlocked in localStorage raw
      try {
        const vk = typeof vaultStorageKey === 'function' ? vaultStorageKey() : null;
        if (vk) payload.vaultRaw = localStorage.getItem(vk);
      } catch (_) {}
      const salt = crypto.getRandomValues(new Uint8Array(16));
      const iv = crypto.getRandomValues(new Uint8Array(12));
      const key = await deriveKey(password, salt);
      const plain = new TextEncoder().encode(JSON.stringify(payload));
      const cipher = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, plain);
      const pack = {
        alpineSync: 1,
        salt: btoa(String.fromCharCode.apply(null, salt)),
        iv: btoa(String.fromCharCode.apply(null, iv)),
        data: btoa(String.fromCharCode.apply(null, new Uint8Array(cipher)))
      };
      const blob = new Blob([JSON.stringify(pack)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'alpine-sync-' + new Date().toISOString().slice(0, 10) + '.json';
      a.click();
      URL.revokeObjectURL(a.href);
      toastSafe('Encrypted sync pack exported');
    } catch (e) {
      console.error(e);
      toastSafe('Export failed');
    }
  }

  function b64ToBytes(b64) {
    const bin = atob(b64);
    const out = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
    return out;
  }

  async function importSyncPackFile(file) {
    const password = prompt('Password for this sync pack:');
    if (!password) return;
    try {
      const text = await file.text();
      const pack = JSON.parse(text);
      if (!pack || !pack.data || !pack.salt || !pack.iv) throw new Error('Invalid pack');
      const salt = b64ToBytes(pack.salt);
      const iv = b64ToBytes(pack.iv);
      const key = await deriveKey(password, salt);
      const plainBuf = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, b64ToBytes(pack.data));
      const payload = JSON.parse(new TextDecoder().decode(plainBuf));
      if (!confirm('Import will merge chats/posts/profile from pack. Continue?')) return;
      if (payload.profile && typeof profile !== 'undefined') {
        Object.assign(profile, payload.profile);
      }
      if (Array.isArray(payload.chats) && typeof chats !== 'undefined') {
        const byId = new Map(chats.map(c => [String(c.id), c]));
        payload.chats.forEach(pc => {
          const id = String(pc.id);
          if (!byId.has(id)) chats.push(pc);
          else {
            const local = byId.get(id);
            const lm = Array.isArray(local.messages) ? local.messages : [];
            const pm = Array.isArray(pc.messages) ? pc.messages : [];
            const ids = new Set(lm.map(m => String(m.id)));
            pm.forEach(m => { if (!ids.has(String(m.id))) lm.push(m); });
            local.messages = lm.sort((a, b) => (a.time || 0) - (b.time || 0));
          }
        });
      }
      if (Array.isArray(payload.posts) && typeof posts !== 'undefined') {
        const ids = new Set(posts.map(p => String(p.id)));
        payload.posts.forEach(p => { if (!ids.has(String(p.id))) posts.push(p); });
      }
      if (payload.vaultRaw) {
        try {
          const vk = typeof vaultStorageKey === 'function' ? vaultStorageKey() : null;
          if (vk) localStorage.setItem(vk, payload.vaultRaw);
        } catch (_) {}
      }
      if (payload.plus) setPlus(true);
      try { if (typeof saveData === 'function') saveData(); } catch (_) {}
      try { if (typeof renderChatList === 'function') renderChatList(); } catch (_) {}
      try { if (typeof renderGlobalWall === 'function') renderGlobalWall(); } catch (_) {}
      toastSafe('Sync pack imported');
    } catch (e) {
      console.error(e);
      toastSafe('Import failed — wrong password or file');
    }
  }

  // --- Chat ticks polish: ensure checks render ---
  function enhanceOutgoingTicks() {
    if (typeof renderMessages !== 'function' || renderMessages.__ticks) return;
    // sendMessage already sets delivered/read — ensure paintChat after
    if (typeof sendMessage === 'function' && !sendMessage.__stable) {
      const orig = sendMessage;
      window.sendMessage = function () {
        const input = document.getElementById('messageInput');
        const before = input ? input.value : '';
        const r = orig.apply(this, arguments);
        // If input still has text and was not cleared, try minimal send
        try {
          if (input && before.trim() && input.value === before && typeof activeChatId !== 'undefined' && activeChatId != null) {
            const chat = (chats || []).find(c => String(c.id) === String(activeChatId));
            if (chat) {
              if (!Array.isArray(chat.messages)) chat.messages = [];
              chat.messages.push({
                id: (window.msgIdCounter = (window.msgIdCounter || 1000) + 1),
                text: before.trim(),
                outgoing: true,
                time: Date.now(),
                reactions: [],
                sending: false,
                delivered: true,
                read: false
              });
              input.value = '';
              try { if (typeof saveData === 'function') saveData(); } catch (_) {}
              try { if (typeof renderMessages === 'function') renderMessages(chat); } catch (_) {}
              try { if (typeof simpleRenderMessages === 'function') {
                const el = document.getElementById('messages');
                if (el && el.children.length === 0) simpleRenderMessages(chat);
              } } catch (_) {}
              try { if (typeof renderChatList === 'function') renderChatList(); } catch (_) {}
            }
          }
        } catch (_) {}
        setTimeout(() => {
          try {
            if (typeof activeChatId !== 'undefined' && activeChatId != null && typeof paintChat === 'function') {
              // paintChat may not exist globally from previous module
            }
            const chat = (chats || []).find(c => String(c.id) === String(activeChatId));
            if (chat && typeof renderMessages === 'function') renderMessages(chat);
          } catch (_) {}
        }, 100);
        return r;
      };
      window.sendMessage.__stable = true;
    }
  }

  function boot() {
    setPlus(isPlus());
    document.getElementById('plusSwitch')?.addEventListener('click', () => {
      const next = !isPlus();
      setPlus(next);
      toastSafe(next ? 'Alpine Plus on (local)' : 'Back to Free');
    });
    document.getElementById('enablePushBtn')?.addEventListener('click', enablePush);
    document.getElementById('syncExportBtn')?.addEventListener('click', exportSyncPack);
    document.getElementById('syncImportBtn')?.addEventListener('click', () => {
      document.getElementById('syncImportFile')?.click();
    });
    document.getElementById('syncImportFile')?.addEventListener('change', e => {
      const f = e.target.files && e.target.files[0];
      if (f) importSyncPackFile(f);
      e.target.value = '';
    });
    wrapAddNotification();
    enhanceOutgoingTicks();
    // SW message deep link
    if (navigator.serviceWorker) {
      navigator.serviceWorker.addEventListener('message', ev => {
        const data = ev.data && ev.data.data;
        if (!data) return;
        try {
          if (data.chatId && typeof openChat === 'function') openChat(data.chatId);
          else if (data.postId && typeof openThread === 'function') openThread(data.postId);
        } catch (_) {}
      });
    }
    setTimeout(() => { wrapAddNotification(); enhanceOutgoingTicks(); }, 1500);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>


