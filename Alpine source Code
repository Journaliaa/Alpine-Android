    [data-theme="dark"] .wall-comment-body strong { color: #71aaeb; }
    .wall-comment-body small { font-size: 11px; color: #818c99; margin-left: 8px; font-weight: 400; }
    .wall-comment-text {
      font-size: 13px; line-height: 1.4; margin-top: 2px;
      white-space: pre-wrap; word-break: break-word; color: #000;
    }
    [data-theme="dark"] .wall-comment-text { color: #e7e8ea; }
