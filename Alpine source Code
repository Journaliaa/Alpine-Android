    async function postAccountSecurity(path, payload) {
      const res = await fetch(path, { method: 'POST', credentials: 'same-origin', cache: 'no-store', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(payload) });
      const data = await res.json().catch(() => ({}));
      if (res.status === 404) return { localFallback: true };
      if (!res.ok) throw new Error(data.message || data.error || 'Сервер отклонил изменение');
      return { data };
    }
    function setAccountSecurityStatus(message) {
      const el = document.getElementById('accountSecurityStatus');
      if (el) el.textContent = message || '';
    }
    async function requestAccountChange(path, payload) {
      try { return await postAccountSecurity(path, payload); }
      catch (e) {
        if (location.protocol === 'file:' || !navigator.onLine) return { localFallback: true, networkIssue: true };
        throw e;
      }
    }
    document.getElementById('changeAccountEmailBtn')?.addEventListener('click', async () => {
      const btn = document.getElementById('changeAccountEmailBtn');
      const currentPassword = document.getElementById('accountEmailCurrentPassword')?.value || '';
      const newEmail = (document.getElementById('accountNewEmail')?.value || '').trim().toLowerCase();
      if (!currentUser || currentUser.guest) { setAccountSecurityStatus('Войдите в обычный аккаунт, чтобы менять email.'); return; }
      if (!currentPassword || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(newEmail)) { setAccountSecurityStatus('Введите текущий пароль и корректный новый email.'); return; }
      if (currentUser.email && currentUser.email.toLowerCase() === newEmail) { setAccountSecurityStatus('Этот email уже используется в аккаунте.'); return; }
      btn.disabled = true;
      try {
        const result = await requestAccountChange('/api/auth/change-email', { currentPassword, newEmail });
        if (result.localFallback) {
          if (currentUser.provider === 'google') throw new Error('Email Google-аккаунта меняется в настройках Google, где можно подтвердить адрес.');
          const accounts = loadAccounts();
          const account = accounts.find(a => a.username === currentUser.username);
          if (!account || !(await verifyAccountPassword(account, currentPassword))) throw new Error('Неверный текущий пароль.');
          if (accounts.some(a => a.username !== account.username && String(a.email || '').toLowerCase() === newEmail)) throw new Error('Этот email уже используется другим локальным аккаунтом.');
          account.email = newEmail;
          if (!saveAccounts(accounts)) throw new Error('Не удалось сохранить email в этом браузере.');
          setAccountSecurityStatus('Email изменён только в локальном аккаунте этого браузера. Подтверждение email и перенос на другие устройства требуют серверного API.');
        } else {
          setAccountSecurityStatus('Сервер подтвердил изменение email. Если сервис требует подтверждения адреса, завершите его по письму.');
        }
        currentUser.email = result.localFallback ? newEmail : (result.data.email || newEmail);
        try { localStorage.setItem(AUTH_SESSION_KEY, JSON.stringify(currentUser)); } catch (_) {}
        document.getElementById('accountEmailCurrentPassword').value = '';
        document.getElementById('accountNewEmail').value = '';
        await refreshDeviceSessions();
      } catch (e) { setAccountSecurityStatus(e.message || 'Не удалось изменить email.'); }
      finally { btn.disabled = false; }
    });
    document.getElementById('changeAccountPasswordBtn')?.addEventListener('click', async () => {
      const btn = document.getElementById('changeAccountPasswordBtn');
      const currentPassword = document.getElementById('accountPasswordCurrent')?.value || '';
      const newPassword = document.getElementById('accountNewPassword')?.value || '';
      const confirmPassword = document.getElementById('accountConfirmPassword')?.value || '';
      if (!currentUser || currentUser.guest) { setAccountSecurityStatus('Войдите в обычный аккаунт, чтобы менять пароль.'); return; }
      if (!currentPassword || newPassword.length < 12) { setAccountSecurityStatus('Введите текущий пароль и новый пароль длиной не менее 12 символов.'); return; }
      if (newPassword !== confirmPassword) { setAccountSecurityStatus('Новые пароли не совпадают.'); return; }
      if (currentPassword === newPassword) { setAccountSecurityStatus('Новый пароль должен отличаться от текущего.'); return; }
      btn.disabled = true;
      try {
        const result = await requestAccountChange('/api/auth/change-password', { currentPassword, newPassword });
        if (result.localFallback) {
          if (currentUser.provider === 'google') throw new Error('Для Google-аккаунта управление паролем выполняется в настройках Google.');
          const accounts = loadAccounts();
          const account = accounts.find(a => a.username === currentUser.username);
          if (!account || !(await verifyAccountPassword(account, currentPassword))) throw new Error('Неверный текущий пароль.');
          account.passwordRecord = await createPasswordRecord(newPassword);
          delete account.passHash;
          if (!saveAccounts(accounts)) throw new Error('Не удалось сохранить пароль в этом браузере.');
          setAccountSecurityStatus('Пароль обновлён только для локального аккаунта в этом браузере. Для защиты всех устройств подключите серверный API.');
        } else {
          setAccountSecurityStatus('Сервер подтвердил изменение пароля. Другие сеансы должны завершаться сервером согласно политике безопасности.');
        }
