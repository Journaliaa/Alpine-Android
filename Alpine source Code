    .chat-folder-chip.active { background: #0077ff; color: #fff; }
    .wall-search-bar {
      display: flex; gap: 8px; margin-bottom: 12px; align-items: center;
    }
    .wall-search-bar input {
      flex: 1; height: 36px; border: 1px solid #d3d9de; border-radius: 4px;
      padding: 0 12px; font: inherit; font-size: 13px; background: #fff; outline: none;
