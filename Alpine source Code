    const NIVA_STICKER_COUNT = 40;
    function ensureStickerImg() {
      if (window.__nivaStickerImg && window.__nivaStickerImg.complete) return window.__nivaStickerImg;
      const img = new Image();
      img.decoding = 'async';
      img.src = (typeof NIVA_STICKER_SPRITE !== 'undefined') ? NIVA_STICKER_SPRITE : '';
      window.__nivaStickerImg = img;
      // apply sprite once to document stylesheet
      if (!document.getElementById('nivaStickerStyle')) {
        const st = document.createElement('style');
        st.id = 'nivaStickerStyle';
        st.textContent = '.sticker-sprite{background-image:url("'+NIVA_STICKER_SPRITE+'");background-repeat:no-repeat;background-size:'+(NIVA_STICKER_COLS*NIVA_STICKER_SIZE)+'px auto;width:'+NIVA_STICKER_SIZE+'px;height:'+NIVA_STICKER_SIZE+'px;display:inline-block;flex-shrink:0}';
        document.head.appendChild(st);
      }
      return img;
    }
    function stickerPos(id) {
      const col = id % NIVA_STICKER_COLS;
      const row = Math.floor(id / NIVA_STICKER_COLS);
      return { x: col * NIVA_STICKER_SIZE, y: row * NIVA_STICKER_SIZE };
    }
    function stickerStyle(id) {
      const p = stickerPos(id);
      return 'background-position:-' + p.x + 'px -' + p.y + 'px';
    }
    function stickerDataUrl(id) {
      try {
        const img = ensureStickerImg();
        if (!img || !img.complete || !img.naturalWidth) return null;
        const canvas = document.createElement('canvas');
        canvas.width = NIVA_STICKER_SIZE;
        canvas.height = NIVA_STICKER_SIZE;
        const ctx = canvas.getContext('2d');
        const p = stickerPos(id);
        ctx.drawImage(img, p.x, p.y, NIVA_STICKER_SIZE, NIVA_STICKER_SIZE, 0, 0, NIVA_STICKER_SIZE, NIVA_STICKER_SIZE);
        return canvas.toDataURL('image/png');
      } catch (e) { return null; }
    }

