  }
  window.alpineQueue = { enqueueOutbound, flushQueue };

  // Hook publish when offline - intercept globalWallPostBtn late
  function patchOfflinePublish() {
    const btn = document.getElementById('globalWallPostBtn');
    if (!btn || btn.__queuePatched) return;
