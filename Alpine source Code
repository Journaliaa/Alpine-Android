    (function setupLogoPip() {
      const pip = document.getElementById('logoPip');
      if (!pip) return;
      let ox = 0, oy = 0, sx = 0, sy = 0, dragging = false, moved = false;
      const savePos = () => {
        try {
          const r = pip.getBoundingClientRect();
          localStorage.setItem('alpine_pip_pos', JSON.stringify({ left: r.left, top: r.top, min: pip.classList.contains('minimized') }));
        } catch (e) {}
      };
      try {
        const raw = localStorage.getItem('alpine_pip_pos');
        if (raw) {
          const p = JSON.parse(raw);
          if (p && typeof p.left === 'number') {
            pip.style.left = Math.max(4, Math.min(window.innerWidth - 50, p.left)) + 'px';
            pip.style.top = Math.max(4, Math.min(window.innerHeight - 50, p.top)) + 'px';
            pip.style.right = 'auto';
            pip.style.bottom = 'auto';
            if (p.min) pip.classList.add('minimized');
          }
        }
      } catch (e) {}
      const onDown = (x, y) => { dragging = true; moved = false; sx = x; sy = y; const r = pip.getBoundingClientRect(); ox = x - r.left; oy = y - r.top; pip.classList.add('show-controls'); };
      const onMove = (x, y) => {
        if (!dragging) return;
        if (Math.abs(x - sx) + Math.abs(y - sy) > 4) moved = true;
        pip.style.left = Math.max(4, Math.min(window.innerWidth - pip.offsetWidth - 4, x - ox)) + 'px';
        pip.style.top = Math.max(4, Math.min(window.innerHeight - pip.offsetHeight - 4, y - oy)) + 'px';
        pip.style.right = 'auto';
        pip.style.bottom = 'auto';
      };
      const onUp = () => {
        if (!dragging) return;
        dragging = false;
        if (!moved) pip.classList.toggle('minimized');
        savePos();
      };
      pip.addEventListener('pointerdown', e => { if (e.target.closest('#logoPipClose')) return; pip.setPointerCapture(e.pointerId); onDown(e.clientX, e.clientY); });
      pip.addEventListener('pointermove', e => onMove(e.clientX, e.clientY));
      pip.addEventListener('pointerup', onUp);
      document.getElementById('logoPipClose')?.addEventListener('click', e => {
        e.stopPropagation();
        pip.style.display = 'none';
        try { localStorage.setItem('alpine_pip_hidden', '1'); } catch (err) {}
      });
      try { if (localStorage.getItem('alpine_pip_hidden') === '1') pip.style.display = 'none'; } catch (e) {}
    })();

