  // ---- Post menu: Quote + Pin ----
  function ensureMenuItems() {
    const sheet = document.getElementById('postMenuSheet');
    if (!sheet || sheet.querySelector('#postMenuQuote')) return;
    const cancel = sheet.querySelector('#postMenuCancel, [id*="Cancel"]');
    const q = document.createElement('button');
