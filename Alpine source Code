    /* ===== Splash ===== */
    .app-splash {
      position: fixed; inset: 0; z-index: 99999;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      background: #1d9bf0;
      color: #fff;
      transition: opacity 0.45s cubic-bezier(0.2, 0, 0, 1), visibility 0.45s;
      -webkit-tap-highlight-color: transparent;
    }
    .app-splash.splash-light {
      background: #ffffff;
      color: #1d9bf0;
    }
    .app-splash.hide {
      opacity: 0; visibility: hidden; pointer-events: none;
    }
    .app-splash-logo {
      width: 88px; height: 88px; border-radius: 22px;
      background: #fff; color: #1d9bf0;
      display: grid; place-items: center;
      font-size: 48px; font-weight: 900; font-family: system-ui, -apple-system, sans-serif;
      box-shadow: 0 12px 40px rgba(0,0,0,0.18);
      animation: splashPop 0.7s cubic-bezier(0.2, 0.9, 0.3, 1) both;
    }
    .app-splash.splash-light .app-splash-logo {
      background: #1d9bf0; color: #fff;
      box-shadow: 0 12px 40px rgba(29,155,240,0.35);
    }
    .app-splash-name {
      margin-top: 22px; font-size: 28px; font-weight: 800;
      letter-spacing: -0.03em;
      animation: splashFade 0.6s ease 0.15s both;
    }
    .app-splash-sub {
      margin-top: 8px; font-size: 14px; font-weight: 500;
      opacity: 0.85;
      animation: splashFade 0.6s ease 0.25s both;
    }
    .app-splash-loader {
      margin-top: 36px; width: 28px; height: 28px;
      border: 3px solid rgba(255,255,255,0.35);
      border-top-color: #fff;
      border-radius: 50%;
      animation: splashSpin 0.8s linear infinite;
    }
    .app-splash.splash-light .app-splash-loader {
      border-color: rgba(29,155,240,0.25);
      border-top-color: #1d9bf0;
    }
    @keyframes splashPop {
      from { opacity: 0; transform: scale(0.6); }
      70% { transform: scale(1.06); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes splashFade {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: none; }
    }
    @keyframes splashSpin {
      to { transform: rotate(360deg); }
    }
    @media (prefers-reduced-motion: reduce) {
      .app-splash-logo, .app-splash-name, .app-splash-sub, .app-splash-loader {
        animation: none !important;
