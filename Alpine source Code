    // ==================== RENDER CHAT LIST ====================
    let showArchivedFolder = false;
    function renderChatList(filter = '') {
      let list = [...chats].filter(c => !isBlockedName(c.name) && c.type !== 'notes' && c.id !== 'notes_self' && c.name !== 'Заметки себе');
      if (showArchivedFolder) {
        list = list.filter(c => c.archived);
      } else {
        list = list.filter(c => !c.archived);
      }
      /* folders removed */


      if (filter) {
        const q = filter.toLowerCase();
        list = list.filter(c =>
          c.name.toLowerCase().includes(q) ||
          getLastMessage(c).toLowerCase().includes(q) ||
          c.messages.some(m => (m.text || '').toLowerCase().includes(q))
        );
      }

      // pinned first, then by last message time
      list.sort((a, b) => {
        if (a.pinned !== b.pinned) return b.pinned - a.pinned;
        const ta = a.messages.length ? a.messages[a.messages.length-1].time : 0;
        const tb = b.messages.length ? b.messages[b.messages.length-1].time : 0;
        return tb - ta;
      });

      const el = document.getElementById('chatList');
      const archivedCount = chats.filter(c => c.archived && !isBlockedName(c.name)).length;
      let archRow = '';
      if (!filter) {
        if (showArchivedFolder) {
          archRow = `<div class="archive-row" id="archiveBackRow" role="button" tabindex="0"><span class="material-icons-round">arrow_back</span><strong>Назад к чатам</strong></div>`;
        } else {
          archRow = `<div class="archive-row" id="archiveOpenRow" role="button" tabindex="0"><span class="material-icons-round">archive</span><strong>Архив</strong><span class="arch-count">${archivedCount}</span></div>`;
        }
      }

      if (!list.length) {
        el.innerHTML = archRow + `<div class="m3-empty" style="padding:36px 20px">
          <div class="m3-empty-icon"><span class="material-icons-round">${showArchivedFolder ? 'inventory_2' : 'chat_bubble_outline'}</span></div>
          <h3>${showArchivedFolder ? 'Архив пуст' : 'Пока нет чатов'}</h3>
          <p>${showArchivedFolder ? 'Свайпните чат влево, чтобы архивировать' : 'Начните переписку — новый чат через поиск людей или кнопку +'}</p>
        </div>`;
      } else {
        el.innerHTML = archRow + list.map(chat => {
        const last = getLastMessage(chat);
        const preview = last.startsWith('Вы: ')
          ? `<span class="you">Вы:</span> ${escapeHtml(last.slice(4))}`
          : escapeHtml(last);
        return `
          <div class="chat-item ${String(chat.id) === String(activeChatId) ? 'active' : ''} ${chat.pinned ? 'pinned' : ''} ${chat.id === 'bookmarks_saved' ? 'bookmarks-chat' : ''} ${chat.type === 'service' || chat.id === 'service_nivada' ? 'service-chat' : ''} ${(chat.unread||0)>0 ? 'unread' : ''}"
               data-id="${chat.id}">
            <div class="avatar ${chat.online ? 'online' : ''}" style="background:${chat.color}">
              ${chat.avatar}
            </div>
            <div class="chat-info">
              <div class="chat-top">
                <span class="chat-name">${chat.type === 'group' || chat.type === 'channel' ? '<span class="material-icons-round group-badge" title="Группа">group</span>' : ''}${escapeHtml(chat.name)}${chat.favorite ? '<span class="material-icons-round favorite-mark" title="Избранное">star</span>' : ''}</span>
                <span class="chat-time">${getLastTime(chat)}</span>
              </div>
              <div class="chat-bottom">
                <span class="chat-preview">${preview || 'Нет сообщений'}</span>
                ${chat.muted ? '<span class="material-icons-round muted-icon">volume_off</span>' : ''}
                ${chat.unread > 0 ? `<span class="badge">${chat.unread}</span>` : ''}
              </div>
            </div>
          </div>`;
      }).join('');
      }

      // Archive navigation — always bind (works even when main list is empty)
      el.querySelector('#archiveOpenRow')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        showArchivedFolder = true;
        renderChatList(document.getElementById('searchInput')?.value || '');
      });
      el.querySelector('#archiveBackRow')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        showArchivedFolder = false;
        renderChatList(document.getElementById('searchInput')?.value || '');
      });

      el.querySelectorAll('.chat-item').forEach(item => {
        item.addEventListener('click', () => openChat(item.dataset.id));
        item.addEventListener('contextmenu', e => { e.preventDefault(); showChatCtx(e, item.dataset.id); });
        bindLongPress(item, (e) => { showChatCtx(e, item.dataset.id); });
        item.addEventListener('touchstart', e => { const t=e.touches[0]; swipeStartX=t.clientX; swipeStartY=t.clientY; }, {passive:true});
        item.addEventListener('touchend', e => {
          const t=e.changedTouches[0], dx=t.clientX-swipeStartX, dy=t.clientY-swipeStartY;
          if (Math.abs(dx)>75 && Math.abs(dy)<45) {
            const c = chats.find(x => String(x.id) === String(item.dataset.id));
            if (!c) return;
            if (dx < 0) {
              c.archived = !c.archived;
              if (!c.archived) { c.isContact = true; c.autoArchived = false; }
              toast(c.archived ? 'Чат отправлен в архив' : 'Чат возвращён из архива');
            } else {
              c.favorite = !c.favorite;
              toast(c.favorite ? 'Добавлено в избранное' : 'Убрано из избранного');
            }
            saveData();
            renderChatList(document.getElementById('searchInput')?.value || '');
          }
        }, {passive:true});
      });
    }

    // ==================== OPEN CHAT ====================
    function saveCurrentDraft() {
      if (activeChatId == null) return;
      const val = document.getElementById('messageInput')?.value || '';
      if (val.trim()) drafts[activeChatId] = val;
      else delete drafts[activeChatId];
    }
    function openChat(id) {
      // Resolve string data-id values back to the canonical stored ID (often a number).
      const chat = chats.find(c => String(c.id) === String(id));
      if (!chat) { toast('Чат не найден или уже удалён'); return; }
      if (!requireChatPin()) return;
      saveCurrentDraft();
      activeChatId = chat.id;
      // Exit wall / bottom-nav home so chat area can show (mobile fix)
      try {
        document.querySelector('.app')?.classList.remove('wall-mode');
        document.body.classList.remove('wall-mode');
        document.documentElement.classList.remove('wall-mode');
        document.getElementById('wallPage')?.classList.remove('show');
        document.getElementById('musicPage')?.classList.remove('show');
        document.getElementById('communityPage')?.classList.remove('show');
      } catch (e) {}
      try { hideAllMainPages(); } catch(e) {}
      const side = document.getElementById('sidebar');
      const __mob = window.matchMedia('(max-width: 900px)').matches;
      if (side) {
        if (__mob) {
          side.classList.add('hidden'); // mobile: slide list away
        } else {
          side.classList.remove('hidden');
          side.style.display = 'flex';
        }
        side.style.transform = '';
      }
      try { setChatConversationOpen(true); } catch (e) {
        const activeChatPanel = document.getElementById('activeChat');
        if (activeChatPanel) {
          activeChatPanel.style.display = 'flex';
          activeChatPanel.classList.add('is-chat-open');
        }
        document.body.classList.add('chat-conversation-open');
      }
      // Ensure active chat visible on mobile immediately
      requestAnimationFrame(() => {
        const ac = document.getElementById('activeChat');
        if (ac) {
          ac.style.display = 'flex';
          ac.classList.add('is-chat-open');
        }
        document.body.classList.add('chat-conversation-open');
      });

      chat.unread = 0;
      try { purgeExpiredMessages(chat); } catch (e) {}
      // defer heavy save — open feels instant
      if (window.__chatSaveTimer) clearTimeout(window.__chatSaveTimer);
      window.__chatSaveTimer = setTimeout(() => { try { saveData(); } catch (e) {} }, 400);
      updateDocTitle();
      try {
        const unread = chats.reduce((s, c) => s + (c.unread || 0), 0) + (typeof unreadNotifCount === 'function' ? unreadNotifCount() : 0);
        if (navigator.setAppBadge) {
          if (unread > 0) navigator.setAppBadge(unread);
          else if (navigator.clearAppBadge) navigator.clearAppBadge();
        }
      } catch (e) {}
      const ttlHint = document.getElementById('chatTtlHint');
      if (ttlHint) {
        const ttl = chat.ttl || defaultTtl || 0;
        if (ttl > 0) {
          const label = ttl < 60000 ? (ttl/1000)+' сек' : ttl < 3600000 ? (ttl/60000)+' мин' : (ttl/3600000)+' ч';
          ttlHint.style.display = 'block';
          ttlHint.textContent = '⏱ Исчезающие сообщения: ' + label;
        } else ttlHint.style.display = 'none';
      }

      document.getElementById('emptyState').style.display = 'none';
      document.getElementById('wallPage')?.classList.remove('show');
      document.getElementById('musicPage')?.classList.remove('show');
      document.getElementById('communityPage')?.classList.remove('show');
      document.getElementById('pluginsPage')?.classList.remove('show');
      document.querySelector('.app')?.classList.remove('wall-mode');
      {
        const __isMob = window.matchMedia('(max-width: 900px)').matches;
        if (__isMob) document.getElementById('sidebar')?.classList.add('hidden');
        else document.getElementById('sidebar')?.classList.remove('hidden');
      }
      try { setChatConversationOpen(true); } catch (e) { const ac = document.getElementById('activeChat'); if (ac) ac.style.display = 'flex'; }
      const fab = document.getElementById('fabNewChat'); if (fab) fab.classList.add('hidden-fab');
      document.querySelectorAll('#navRail .icon-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('railChatsBtn')?.classList.add('active');

      const hn = document.getElementById('headerName'); if (hn) hn.textContent = chat.name;
      try { updateHeaderStatus(chat); } catch(e) {}

      const av = document.getElementById('headerAvatar');
      if (av) {
        try {
          if (typeof setAvatarEl === 'function') {
            setAvatarEl(av, chat.avatar || (typeof initials === 'function' ? initials(chat.name) : ''), chat.color || '#888', chat.photo || '');
          } else {
            av.textContent = chat.avatar || '';
            av.style.background = chat.color || '#888';
          }
        } catch (e) {
          av.textContent = chat.avatar || '';
          av.style.background = chat.color || '#888';
        }
        av.style.cursor = (chat.type === 'private' || chat.peerId) ? 'pointer' : '';
        av.title = (chat.type === 'private' || chat.peerId) ? 'Открыть профиль' : '';
      }

      cancelReply();
      try { closeChatSearch(); } catch (e) {}

      // Ensure messages array exists (broken chats otherwise fail to load)
      if (!Array.isArray(chat.messages)) chat.messages = [];

      // Force conversation panel visible BEFORE rendering messages
      try {
        document.getElementById('emptyState') && (document.getElementById('emptyState').style.display = 'none');
        const ac = document.getElementById('activeChat');
        if (ac) {
          ac.style.display = 'flex';
          ac.style.flexDirection = 'column';
          ac.style.height = '100%';
          ac.style.minHeight = '0';
          ac.classList.add('is-chat-open');
        }
        document.body.classList.add('chat-conversation-open');
        const msgs = document.getElementById('messages');
        if (msgs) {
          msgs.style.display = 'block';
          msgs.style.flex = '1';
          msgs.style.minHeight = '0';
          msgs.style.overflowY = 'auto';
        }
      } catch (e) {}

      try {
        renderMessages(chat);
      } catch (err) {
        console.error('renderMessages', err);
        const el = document.getElementById('messages');
        if (el) {
          el.innerHTML = '<div style="padding:24px;text-align:center;color:#888">Could not load messages. <button type="button" id="retryRenderMsgs" class="btn btn-text">Retry</button></div>';
          document.getElementById('retryRenderMsgs')?.addEventListener('click', () => {
            try { renderMessages(chat); } catch (e2) { console.error(e2); }
          });
        }
      }
      try { updatePinnedBar(chat); } catch (e) {}
      try {
        const q = document.getElementById('searchInput')?.value || '';
        renderChatList(q);
      } catch (e) {}

      const draftKey = chat.id;
      const draft = (typeof drafts !== 'undefined' && drafts) ? (drafts[draftKey] || drafts[id] || drafts[String(chat.id)] || '') : '';
      const ta = document.getElementById('messageInput');
      if (ta) {
        ta.value = draft;
        try { autoResize(); } catch(e) {}
        const sb = document.getElementById('sendBtn'); if (sb) sb.disabled = !draft.trim();
        const __isMob2 = window.matchMedia('(max-width: 900px)').matches;
        if (__isMob2) document.getElementById('sidebar')?.classList.add('hidden');
        else document.getElementById('sidebar')?.classList.remove('hidden');
        try { ta.focus({ preventScroll: true }); } catch(e) { try { ta.focus(); } catch (_) {} }
      }

      // Final paint: scroll to end
      requestAnimationFrame(() => {
        const el = document.getElementById('messages');
        if (el) el.scrollTop = el.scrollHeight;
      });
    }

    function updateHeaderStatus(chat) {
      const el = document.getElementById('headerStatus');
      if (!el || !chat) return;
      if (chat.type === 'group' || chat.type === 'channel') {
        const n = (chat.members && chat.members.length) || 0;
        el.textContent = n ? `${n} участников` : 'Группа';
        el.className = 'chat-header-status';
        return;
      }
      if (chat.type === 'service' || chat.type === 'bookmarks') {
        el.textContent = 'служебный чат';
        el.className = 'chat-header-status';
        return;
      }
      if (chat.type === 'notes') {
        el.textContent = 'только вы';
        el.className = 'chat-header-status';
        return;
      }
      // ghost mode or privacy: never show "online"
      const showOnline = !ghostMode && privacyOnline && chat.online;
      if (showOnline) {
        el.textContent = 'в сети';
        el.className = 'chat-header-status online';
      } else if (!privacyLastSeen) {
        el.textContent = '';
        el.className = 'chat-header-status';
      } else {
        const diff = Date.now() - (chat.lastSeen || Date.now());
        if (diff < 3600000) el.textContent = 'был(а) недавно';
        else if (diff < 86400000) el.textContent = 'был(а) сегодня';
        else el.textContent = 'был(а) ' + formatTime(chat.lastSeen);
        el.className = 'chat-header-status';
      }
    }

    // ==================== RENDER MESSAGES ====================
    function renderMessages(chat) {
      try { purgeExpiredMessages(chat); } catch (e) {}
      // deletedForAll rendered as italic in bubble builder

      const el = document.getElementById('messages');
      if (!el) return;
      if (!chat) return;
      if (!Array.isArray(chat.messages)) chat.messages = [];
      // Drop null/undefined message entries that break forEach
      chat.messages = chat.messages.filter(Boolean);
      if (!chat.messages.length) {
        el.innerHTML = `<div class="m3-empty" style="padding:48px 24px;min-height:40vh">
          <div class="m3-empty-icon"><span class="material-icons-round">waving_hand</span></div>
          <h3>Начните переписку</h3>
          <p>Напишите первое сообщение — оно появится здесь</p>
        </div>`;
        return;
      }

      let html = '';
      let lastDate = '';
      // Performance: render last 100 messages first (Telegram-like window)
      const MSG_WINDOW = chat._renderAll ? 999999 : 100;
      const allMsgs = chat.messages;
      const startIdx = allMsgs.length > MSG_WINDOW ? allMsgs.length - MSG_WINDOW : 0;
      if (startIdx > 0) {
        html += `<div class="message system" id="loadOlderMsgs" data-older="${startIdx}" style="cursor:pointer"><div class="bubble">↑ Load older messages (${startIdx})</div></div>`;
      }
      const slice = startIdx > 0 ? allMsgs.slice(startIdx) : allMsgs;
      const esc = (typeof escapeHtml === 'function') ? escapeHtml : (t => String(t ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch])));
      slice.forEach(m => {
        if (!m) return;
        if (m.system || m.service) {
          html += `<div class="message system" data-id="${m.id || ''}"><div class="bubble">${m.deletedForAll ? "Message deleted" : esc(m.text || "")}</div></div>`;
          return;
        }

        const d = new Date(m.time || Date.now());
        const dateKey = isNaN(d.getTime()) ? 'Invalid' : d.toDateString();
        if (dateKey !== lastDate) {
          lastDate = dateKey;
          const now = new Date();
          let label = isNaN(d.getTime()) ? '' : d.toLocaleDateString(undefined, { day: 'numeric', month: 'long' });
          if (!isNaN(d.getTime())) {
            if (d.toDateString() === now.toDateString()) label = 'Today';
            else if (d.toDateString() === new Date(now - 86400000).toDateString()) label = 'Yesterday';
          }
          if (label) html += `<div class="date-divider"><span class="message-date-pill">${label}</span></div>`;
        }

        const replyHtml = m.replyTo ? `
          <div class="reply-preview">
            <div class="reply-author">${esc(m.replyTo.author || '')}</div>
            <div class="reply-text">${esc(m.replyTo.text || '')}</div>
          </div>` : '';
        const fwdHtml = m.forwardPost ? `
          <div class="reply-preview">
            <div class="reply-author">Post · ${esc(m.forwardPost.authorName || '')}</div>
            <div class="reply-text">${esc(m.forwardPost.text || '')}</div>
          </div>` : '';
        let voiceHtml = '';
        try {
          if (m.voice) {
            voiceHtml = `
          <div class="voice-msg">
            <button type="button" class="icon-btn" data-play-voice="${m.id}" style="background:transparent"><span class="material-icons-round">play_arrow</span></button>
            <div class="wave">${typeof waveBars === 'function' ? waveBars(16) : ''}</div>
            <small>${esc(m.voiceDur || '0:00')}</small>
            <audio data-voice-src="${m.id}" src="${m.voice}" preload="metadata" style="display:none"></audio>
          </div>`;
          }
        } catch (_) { voiceHtml = ''; }

        const rx = Array.isArray(m.reactions) ? m.reactions : [];
        const reactionsHtml = rx.length ? `
          <div class="reactions">
            ${rx.map(r => r ? `<span class="reaction ${r.mine ? 'mine' : ''}" data-emoji="${esc(r.emoji || '')}">${r.emoji || ''}</span>` : '').join('')}
          </div>` : '';

        let bodyHtml = `<div class="bubble-text">${(typeof linkifyMessageText==='function'?linkifyMessageText(m.text||''):esc(m.text||''))}</div>`;
        let bubbleExtraClass = '';
        if (m.stickerId != null || m.sticker || m.stickerCss) {
          if (m.sticker) {
            bodyHtml = `<img class="msg-sticker" src="${m.sticker}" alt="sticker">`;
          } else {
            try {
              const p = (typeof stickerPos === 'function') ? stickerPos(m.stickerId || 0) : { x: 0, y: 0 };
              bodyHtml = `<span class="sticker-sprite" style="width:120px;height:120px;background-size:600px auto;background-position:-${(p.x||0)* (120/64)}px -${(p.y||0)*(120/64)}px"></span>`;
            } catch (_) {
              bodyHtml = `<div class="bubble-text">🎨 sticker</div>`;
            }
          }
          bubbleExtraClass = ' bubble-sticker';
        }
        if (m.attachment && typeof m.attachment === 'object') {
          try {
            if (m.attachment.kind === 'image' && m.attachment.data) bodyHtml = `<img class="attachment-preview msg-media" src="${m.attachment.data}" alt="${esc(m.attachment.name || '')}"><div class="bubble-text">${esc(m.attachment.name || '')}</div>`;
            else if (m.attachment.kind === 'audio' && m.attachment.data) bodyHtml = `<audio controls src="${m.attachment.data}" style="max-width:230px"></audio><div class="bubble-text">${esc(m.attachment.name || 'Аудиосообщение')}</div>`;
            else if (m.attachment.kind === 'video_note' && m.attachment.data) {
              const dur = m.attachment.duration && typeof formatVnDuration === 'function' ? formatVnDuration(m.attachment.duration) : '';
              bodyHtml = `<div class="video-note-wrap" data-vn-id="${m.id}">
              <video class="video-note" src="${m.attachment.data}" playsinline preload="metadata"></video>
              <div class="vn-play"><span class="material-icons-round">play_circle</span></div>
              ${dur ? `<div class="vn-time">${dur}</div>` : ''}
            </div>`;
            }
            else if (m.attachment.name) bodyHtml = `<div class="file-chip"><span class="material-icons-round">description</span><span>${esc(m.attachment.name)}</span></div>${bodyHtml}`;
          } catch (_) {}
        }
        if (m.poll && m.poll.question && Array.isArray(m.poll.options)) {
          try {
            const votes = Array.isArray(m.poll.votes) ? m.poll.votes : [];
            bodyHtml = `<div class="poll-card"><div class="poll-title">📊 ${esc(m.poll.question)}</div>${m.poll.options.map((o,i)=>`<button class="poll-option" data-poll="${m.id}" data-option="${i}">${esc(o)} <small>${votes[i] || 0}</small></button>`).join('')}<small>${m.poll.options.reduce((a,o,i)=>a+(votes[i]||0),0)} голосов · нажмите для голосования</small></div>`;
          } catch (_) {}
        }
        const timeLabel = (typeof formatFullTime === 'function') ? formatFullTime(m.time) : (m.time ? new Date(m.time).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) : '');
        html += `
          <div class="message ${m.outgoing ? 'outgoing' : 'incoming'}${m.bookmarked ? ' bookmarked' : ''}${m.sending ? ' sending' : ''}" data-id="${m.id || ''}">
            <div class="bubble${bubbleExtraClass}${(m.service || (chat.type==='service' && !m.outgoing)) ? ' service-bubble' : ''}">
              ${replyHtml}${fwdHtml}${voiceHtml}
              ${bodyHtml}
              ${m.edited ? '<span class="message-edited">изменено</span>' : ''}
              <div class="bubble-meta">
                <span>${timeLabel}</span>
                ${m.outgoing ? `<span class="check material-icons-round ${m.read ? 'read' : ''}">done_all</span>` : ''}
              </div>
              ${reactionsHtml}
            </div>
          </div>`;
      });

      el.innerHTML = html;
      try { el.scrollTop = el.scrollHeight; } catch (_) {}

      const older = el.querySelector('#loadOlderMsgs');
      if (older) {
        older.onclick = () => {
          const keep = el.scrollHeight;
          // temporarily render all
          const full = chat.messages;
          const bak = chat.messages;
          try {
            const prev = window.__msgWindow;
            window.__msgWindow = 999999;
            // force full render once
            const _slice = chat.messages;
            chat._renderAll = true;
            renderMessages(chat);
            chat._renderAll = false;
            el.scrollTop = Math.max(0, el.scrollHeight - keep);
          } catch (e) { console.warn(e); }
        };
      }

      // context menu + long-press (mobile)
      el.querySelectorAll('.message:not(.system)').forEach(msg => {
        const mid = msg.dataset.id;
        if (mid == null || mid === '') return;
        const bubble = msg.querySelector('.bubble');
        msg.addEventListener('contextmenu', e => {
          e.preventDefault();
          try { if (typeof showMsgCtx === 'function') showMsgCtx(e, +mid); } catch (_) {}
        });
        if (bubble) {
          try {
            if (typeof bindLongPress === 'function') {
              bindLongPress(bubble, (e) => {
                try { if (typeof showMsgCtx === 'function') showMsgCtx(e, +mid); } catch (_) {}
              });
            }
          } catch (_) {}
          bubble.addEventListener('click', e => {
            if (e.detail === 2) try { if (typeof setReply === 'function') setReply(+mid); } catch (_) {}
          });
        }
      });

      el.querySelectorAll('[data-poll]').forEach(btn => btn.addEventListener('click', () => {
        try {
          const message = chat.messages.find(m => String(m.id) === String(btn.dataset.poll));
          if (!message?.poll) return;
          if (!Array.isArray(message.poll.votes)) message.poll.votes = [];
          const oi = Number(btn.dataset.option);
          message.poll.votes[oi] = (message.poll.votes[oi] || 0) + 1;
          renderMessages(chat);
          if (typeof saveData === 'function') saveData();
        } catch (_) {}
      }));

      // reaction clicks
      el.querySelectorAll('.reaction').forEach(r => {
        r.addEventListener('click', e => {
          e.stopPropagation();
          try {
            const mid = r.closest('.message')?.dataset?.id;
            if (mid != null && typeof toggleReaction === 'function') toggleReaction(+mid, r.dataset.emoji);
          } catch (_) {}
        });
      });

      // video notes play/pause
      el.querySelectorAll('.video-note-wrap').forEach(wrap => {
        const video = wrap.querySelector('video');
        if (!video) return;
        wrap.addEventListener('click', e => {
          e.stopPropagation();
          // pause other video notes
          el.querySelectorAll('.video-note-wrap video').forEach(v => {
            if (v !== video) { v.pause(); v.currentTime = 0; v.closest('.video-note-wrap')?.classList.remove('playing'); }
          });
          if (video.paused) {
            video.play();
            wrap.classList.add('playing');
          } else {
            video.pause();
            wrap.classList.remove('playing');
          }
        });
        video.addEventListener('ended', () => {
          wrap.classList.remove('playing');
          video.currentTime = 0;
        });
      });
    }

    function formatVnDuration(sec) {
      const s = Math.max(0, Math.round(sec || 0));
      return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
    }

    // ==================== SEND ====================
    function sendMessage() {
      const input = document.getElementById('messageInput');
      const text = (input?.value || '').trim();
      if (!text || activeChatId == null) return;

      const chat = chats.find(c => String(c.id) === String(activeChatId));
      if (chat && typeof isChatBlocked === 'function' && isChatBlocked(chat)) {
        toast('Пользователь заблокирован — сообщения недоступны');
        return;
      }
      if (!chat) {
        activeChatId = null;
        document.getElementById('activeChat')?.style && (document.getElementById('activeChat').style.display = 'none');
        document.getElementById('emptyState')?.style && (document.getElementById('emptyState').style.display = 'flex');
        toast('Чат недоступен. Выберите его снова.');
        return;
      }
      if (!Array.isArray(chat.messages)) chat.messages = [];
      if (chat.type === 'service' || chat.id === 'service_nivada') {
        const msg = {
          id: ++msgIdCounter,
          text,
          outgoing: true,
          time: Date.now(),
          reactions: [],
          read: true
        };
        chat.messages.push(msg);
        cancelReply();
        if (input) input.value = '';
        delete drafts[activeChatId];
        try { autoResize(); } catch (e) {}
        const sb = document.getElementById('sendBtn'); if (sb) sb.disabled = true;
        renderMessages(chat);
        renderChatList(document.getElementById('searchInput')?.value || '');
        saveData();
        handleServiceUserMessage(chat, text);
        return;
      }
      const msg = {
        id: ++msgIdCounter,
        text,
        outgoing: true,
        time: Date.now(),
        reactions: [],
        read: false,
      };
      if (replyTo) {
        msg.replyTo = { author: replyTo.outgoing ? 'Вы' : chat.name, text: (replyTo.text || '').slice(0, 80) };
      }
      const ttl = chat.ttl || defaultTtl || 0;
      if (ttl > 0) msg.expiresAt = Date.now() + ttl;


      msg.sending = true;
      chat.messages.push(msg);
      try {
        if (chat.type === 'private') {
          const outCount = (chat.messages || []).filter(m => m && m.outgoing && !m.system).length;
          // User is actively writing — treat as contact after a real conversation
          if (outCount >= 2) markChatAsContact(chat);
        }
      } catch (e) {}
      // optimistic UI — show immediately
      cancelReply();
      const mi = document.getElementById('messageInput');
      if (mi) mi.value = '';
      delete drafts[activeChatId];
      try { autoResize(); } catch (e) {}
      const sb = document.getElementById('sendBtn'); if (sb) sb.disabled = true;
      renderMessages(chat);
      try {
        const el = document.getElementById('messages');
        if (el) el.scrollTop = el.scrollHeight;
      } catch (e) {}
      updatePinnedBar(chat);
      renderChatList(document.getElementById('searchInput')?.value || '');

      // cloud sync (multi-device)
      try {
        const peer = chat.peerId || null;
        if (peer && currentUser && !currentUser.guest) {
          const cloudId = msg.time + ':' + currentUser.username + ':' + (msg.text || '').slice(0, 24);
          msg.cloudId = cloudId;
          pushCloudMessage(peer, {
            cloudId,
            text: msg.text,
            time: msg.time,
            from: currentUser.username
          });
        }
        cloudPublishProfile();
      } catch (e) {}
      msg.sending = false;
      saveData();
      updateDocTitle();
      // no system notification for own outgoing messages


      // read receipt only if not ghost and privacy allows
      setTimeout(() => {
        if (!ghostMode && privacyRead) {
          msg.read = true;
        } else {
          msg.read = false;
          msg.delivered = true;
        }
        if (String(activeChatId) === String(chat.id)) renderMessages(chat);
      }, 250 + Math.random() * 350);

      if (!chat.peerId && Math.random() > 0.35 && chat.type === 'private') {
        simulateReply(chat);
      }
    }

    function simulateReply(chat) {
      const typing = document.getElementById('typingIndicator');
      setTimeout(() => {
        if (String(activeChatId) === String(chat.id)) {
          typing?.classList.add('show');
          const msgs = document.getElementById('messages');
          if (msgs) msgs.scrollTop = msgs.scrollHeight;
        }
      }, 200 + Math.random() * 400);

      setTimeout(() => {
        try { typing?.classList.remove('show'); } catch (_) {}
        const replies = [
          'Понял 👍', 'Ок, хорошо!', 'Сейчас посмотрю', 'Да, согласен',
          'Хаха 😄', 'Интересно...', 'А что думаешь?', 'Супер!',
          'Может позже?', 'Договорились', 'Отличная идея!', 'Не уверен...',
          'Давай!', 'Спасибо ❤️', 'Ого!', 'Круто 🔥'
        ];
        const reply = {
          id: ++msgIdCounter,
          text: replies[Math.floor(Math.random() * replies.length)],
          outgoing: false,
          time: Date.now(),
          reactions: [],
        };
        if (!Array.isArray(chat.messages)) chat.messages = [];
        chat.messages.push(reply);
        chat.lastSeen = Date.now();
        chat.online = true;
        // Archive unknown private chats when they message you
        try {
          if (chat.type === 'private' && !isKnownContactChat(chat)) {
            maybeAutoArchiveChat(chat);
          }
        } catch (e) {}

        if (String(activeChatId) !== String(chat.id)) {
          chat.unread++;
          if (!chat.muted) {
            playSound();
            notifyBrowser(chat.name, reply.text, { chatId: chat.id, tag: 'chat-' + chat.id, force: document.hidden });
            pushNotification('message', (chat.name || 'Чат') + ': ' + (reply.text || '').slice(0, 80), { chatId: chat.id });
          }
        } else {
          renderMessages(chat);
          updateHeaderStatus(chat);
          playSound();
          // still badge if backgrounded
          if (document.hidden && !chat.muted) {
            notifyBrowser(chat.name, reply.text, { chatId: chat.id, tag: 'chat-' + chat.id, force: true });
          }
        }
        renderChatList(document.getElementById('searchInput')?.value || '');
        saveData();
        updateDocTitle();
      }, 1500 + Math.random() * 2500);
    }

    // ==================== REPLY ====================
    function setReply(msgId) {
      const chat = chats.find(c => String(c.id) === String(activeChatId));
      if (!chat || !Array.isArray(chat.messages)) return;
      const msg = chat.messages.find(m => String(m.id) === String(msgId));
      if (!msg) return;
      replyTo = msg;
      const ra = document.getElementById('replyAuthor');
      const rt = document.getElementById('replyText');
      const rb = document.getElementById('replyBar');
      if (ra) ra.textContent = msg.outgoing ? 'Вы' : (chat.name || '');
      if (rt) rt.textContent = msg.text || (msg.attachment ? (msg.attachment.name || 'Attachment') : '') || '';
      if (rb) rb.classList.add('show');
      try { document.getElementById('messageInput')?.focus(); } catch (_) {}
    }

    function cancelReply() {
      replyTo = null;
      try { document.getElementById('replyBar')?.classList.remove('show'); } catch (_) {}
    }

    // ==================== REACTIONS ====================
    function toggleReaction(msgId, emoji) {
      if (ghostMode) { toast('Ghost mode: read-only'); return; }
      const chat = chats.find(c => String(c.id) === String(activeChatId));
      if (!chat || !Array.isArray(chat.messages)) return;
      const msg = chat.messages.find(m => String(m.id) === String(msgId));
      if (!msg) return;
      if (!Array.isArray(msg.reactions)) msg.reactions = [];

      const existing = msg.reactions.find(r => r.emoji === emoji && r.mine);
      if (existing) {
        msg.reactions = msg.reactions.filter(r => r !== existing);
      } else {
        // remove my other reaction if any, then add
        msg.reactions = msg.reactions.filter(r => !r.mine);
        msg.reactions.push({ emoji, mine: true });
      }
      renderMessages(chat);
      saveData();
    }

    // ==================== CONTEXT MENUS ====================
    function bindLongPress(el, onLongPress, ms) {
      if (!el || el.dataset.lpBound) return;
      el.dataset.lpBound = '1';
      ms = ms || 480;
      let timer = null;
      let startX = 0, startY = 0;
      const clear = () => {
        if (timer) { clearTimeout(timer); timer = null; }
        el.classList.remove('longpress-active');
      };
      const start = (x, y, e) => {
        clear();
        startX = x; startY = y;
        el.classList.add('longpress-active');
        timer = setTimeout(() => {
          timer = null;
          el.classList.remove('longpress-active');
          // synthesize coords for menu positioning
          const fake = {
            clientX: x,
            clientY: y,
            preventDefault() {},
            stopPropagation() {}
          };
          try { if (navigator.vibrate) navigator.vibrate(18); } catch (err) {}
          onLongPress(fake);
        }, ms);
      };
      el.addEventListener('touchstart', e => {
        if (e.touches.length !== 1) return;
        const t = e.touches[0];
        start(t.clientX, t.clientY, e);
      }, { passive: true });
      el.addEventListener('touchmove', e => {
        if (!timer) return;
        const t = e.touches[0];
        if (Math.abs(t.clientX - startX) > 12 || Math.abs(t.clientY - startY) > 12) clear();
      }, { passive: true });
      el.addEventListener('touchend', clear, { passive: true });
      el.addEventListener('touchcancel', clear, { passive: true });
      el.addEventListener('mousedown', e => {
        if (e.button !== 0) return;
        start(e.clientX, e.clientY, e);
      });
      el.addEventListener('mouseup', clear);
      el.addEventListener('mouseleave', clear);
      el.addEventListener('contextmenu', e => { e.preventDefault(); });
    }

