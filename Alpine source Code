    function getBookmarkedPosts() {
      try {
        // Prefer live posts flagged bookmarked; fall back to durable snapshots
        const live = (posts || []).filter(p => p && p.bookmarked);
        const liveIds = new Set(live.map(p => String(p.id)));
        const snaps = (savedPostSnapshots || []).filter(p => p && !liveIds.has(String(p.id)));
        // also mark live ones into snapshots map for consistency
        const all = live.concat(snaps);
        const seen = new Set();
        const out = [];
        for (const p of all) {
          const k = String(p.id);
          if (seen.has(k)) continue;
          seen.add(k);
          out.push(p);
        }
        return out.sort((a,b) => (b.time||0)-(a.time||0));
      } catch (e) { return []; }
    }
    function syncSavedPostSnapshot(post, on) {
      try {
        if (!Array.isArray(savedPostSnapshots)) savedPostSnapshots = [];
        const id = String(post && post.id);
        savedPostSnapshots = savedPostSnapshots.filter(x => String(x.id) !== id);
        if (on && post) {
          // store a plain copy so Saved still works if post leaves the feed filter
          savedPostSnapshots.unshift({
            id: post.id,
            text: post.text || '',
            image: post.image || '',
            images: post.images ? post.images.slice(0, 4) : undefined,
            authorName: post.authorName || '',
            authorUsername: post.authorUsername || post.authorId || '',
            authorId: post.authorId || '',
            authorColor: post.authorColor || '',
            authorPhoto: post.authorPhoto || '',
            time: post.time || Date.now(),
            bookmarked: true,
            bookmarks: post.bookmarks || 1,
            likes: post.likes || 0,
            liked: !!post.liked,
            comments: Array.isArray(post.comments) ? post.comments.slice(0, 20) : [],
            reposts: post.reposts || 0
          });
          if (savedPostSnapshots.length > 200) savedPostSnapshots = savedPostSnapshots.slice(0, 200);
        }
      } catch (e) { console.warn('syncSavedPostSnapshot', e); }
    }
