    .md3-time { display: flex; justify-content: space-between; font-size: 11px; color: var(--md-sys-color-on-surface-variant); }
    .view-profile-panel .info-name { cursor: default; }
    .wall-post-meta strong { cursor: pointer; }
    .playlist-card {
      display: flex; align-items: center; gap: 12px; padding: 12px;
      border-radius: 16px; background: var(--md-sys-color-surface-container-low);
