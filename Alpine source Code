    document.title = 'Messages · Alpine';
  }

  function boot() {
    nukeRemovedUI();
    // Override messages nav
    window.openMessagesNav = openMessagesFixed;
    document.getElementById('bnMessages')?.addEventListener('click', function (e) {
      e.preventDefault();
      openMessagesFixed();
    });
