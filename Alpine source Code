    }
    .community-page-header h2 { font-size: 18px; font-weight: 600; flex: 1; }
    .community-stub {
      flex: 1; display: flex; flex-direction: column; align-items: center;
      justify-content: center; padding: 24px 20px; text-align: center; gap: 16px;
      overflow-y: auto;
    }
    .community-meme {
      max-width: min(360px, 90vw); width: 100%; border-radius: 20px;
