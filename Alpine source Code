    function acceptCall() {
      return; // calls disabled

      if (!activeCall || activeCall.status !== 'incoming') return;
      activeCall.status = 'active';
      activeCall.startedAt = Date.now();
      activeCall.videoOn = activeCall.type === 'video';
      setCallMode('active');
      updateCallTiles();
      startCallTimer();
      startSpeakingSim();
      playDiscordTone('join');
      acquireCallMedia(activeCall.videoOn);
      startCallQualitySim();
      toast('Подключено · HD');
    }
    function endCall() {
      return; // calls disabled

      if (callRingTimeout) { clearTimeout(callRingTimeout); callRingTimeout = null; }
      if (callTimerInterval) { clearInterval(callTimerInterval); callTimerInterval = null; }
      if (window.__callQInt) { clearInterval(window.__callQInt); window.__callQInt = null; }
      stopSpeakingSim();
      if (callLocalStream) {
        callLocalStream.getTracks().forEach(t => t.stop());
        callLocalStream = null;
      }
      if (callScreenStream) {
        callScreenStream.getTracks().forEach(t => t.stop());
        callScreenStream = null;
      }
      const wasActive = activeCall && activeCall.status === 'active';
      const name = activeCall?.name;
      activeCall = null;
      document.getElementById('callOverlay').classList.remove('show');
      document.getElementById('callMiniBar').classList.remove('show');
      document.getElementById('callTimer').textContent = '00:00';
      const prev = document.getElementById('callVideoPreview');
      if (prev) { prev.classList.remove('show'); prev.innerHTML = '<div class="local-placeholder">Вы</div>'; }
      const selfVideo = document.getElementById('callSelfVideo');
      if (selfVideo) { selfVideo.srcObject = null; selfVideo.style.display = 'none'; }
      const selfAv = document.getElementById('callTileSelfAv');
      if (selfAv) selfAv.style.display = '';
      document.getElementById('callScreenBtn')?.classList.remove('active-green');
      playDiscordTone('leave');
      if (wasActive) toast('Отключились от «' + name + '»');
