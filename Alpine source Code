<script>
/* M3 chat + empty-state polish behavior */
(function () {
  function ensureScrollFab() {
    const chat = document.getElementById('activeChat');
    if (!chat) return null;
    let fab = document.getElementById('chatScrollFab');
    if (!fab) {
      fab = document.createElement('button');
      fab.type = 'button';
      fab.id = 'chatScrollFab';
      fab.className = 'chat-scroll-fab';
      fab.title = 'Вниз';
      fab.innerHTML = '<span class="material-icons-round">keyboard_arrow_down</span>';
      chat.appendChild(fab);
      fab.addEventListener('click', () => {
        const el = document.getElementById('messages');
        if (el) el.scrollTo({ top: el.scrollHeight, behavior: 'smooth' });
      });
    }
    return fab;
  }

  function bindMessagesScroll() {
    const el = document.getElementById('messages');
    if (!el || el.__scrollFabBound) return;
    el.__scrollFabBound = true;
    const onScroll = () => {
      const fab = ensureScrollFab();
      if (!fab) return;
      const dist = el.scrollHeight - el.scrollTop - el.clientHeight;
      fab.classList.toggle('show', dist > 140);
    };
    el.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // Auto-grow textarea
  function bindInputGrow() {
    const ta = document.getElementById('messageInput');
    if (!ta || ta.__growBound) return;
    ta.__growBound = true;
    const fit = () => {
      ta.style.height = 'auto';
      ta.style.height = Math.min(120, Math.max(24, ta.scrollHeight)) + 'px';
    };
    ta.addEventListener('input', fit);
    fit();
  }

  // Empty state actions
  function bindEmptyActions() {
    document.getElementById('emptyOpenWallBtn')?.addEventListener('click', () => {
      try { if (typeof openWallPage === 'function') openWallPage(); } catch (_) {}
    });
    document.getElementById('emptyOpenChatsBtn')?.addEventListener('click', () => {
      try {
        document.getElementById('emptyState')?.classList.remove('is-empty-visible');
        const es = document.getElementById('emptyState');
        if (es) es.style.display = 'none';
        if (typeof openDrawer === 'function') openDrawer();
      } catch (_) {}
    });
  }

  // Enhance chat avatars with photo if available
  function paintChatListAvatars() {
    try {
      document.querySelectorAll('#chatList .chat-item').forEach(item => {
        const id = item.dataset.id;
        const chat = (typeof chats !== 'undefined' ? chats : []).find(c => String(c.id) === String(id));
        if (!chat || !chat.photo) return;
        const av = item.querySelector('.avatar');
        if (!av || av.querySelector('img')) return;
        av.textContent = '';
        av.classList.add('has-photo');
        av.style.backgroundImage = 'url("' + chat.photo + '")';
        av.style.backgroundSize = 'cover';
        av.style.backgroundPosition = 'center';
      });
    } catch (_) {}
  }

  // Hook renderChatList / renderMessages
  function hookRenders() {
    if (typeof window.renderChatList === 'function' && !window.renderChatList.__m3Empty) {
      const orig = window.renderChatList;
      // also try local binding
    }
    if (typeof renderChatList === 'function' && !renderChatList.__m3Empty) {
      const orig = renderChatList;
      const wrapped = function () {
        const r = orig.apply(this, arguments);
        paintChatListAvatars();
        return r;
      };
      wrapped.__m3Empty = true;
      try { renderChatList = wrapped; window.renderChatList = wrapped; } catch (_) {}
    }
    if (typeof renderMessages === 'function' && !renderMessages.__m3Empty) {
      const orig = renderMessages;
      const wrapped = function (chat) {
        const r = orig.apply(this, arguments);
        bindMessagesScroll();
        const el = document.getElementById('messages');
        if (el) {
          // keep near bottom if was near bottom
          const dist = el.scrollHeight - el.scrollTop - el.clientHeight;
          if (dist < 120) el.scrollTop = el.scrollHeight;
        }
        const fab = ensureScrollFab();
        if (fab) fab.classList.remove('show');
        return r;
      };
      wrapped.__m3Empty = true;
      try { renderMessages = wrapped; window.renderMessages = wrapped; } catch (_) {}
    }
  }

  // Enter to send (Shift+Enter newline)
  function bindEnterSend() {
    const ta = document.getElementById('messageInput');
    if (!ta || ta.__enterSendBound) return;
    ta.__enterSendBound = true;
    ta.addEventListener('keydown', e => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        try {
          const btn = document.getElementById('sendBtn');
          if (btn && !btn.disabled && typeof sendMessage === 'function') sendMessage();
          else if (btn && !btn.disabled) btn.click();
        } catch (_) {}
      }
    });
  }

  function boot() {
    bindEmptyActions();
    bindInputGrow();
    bindEnterSend();
    bindMessagesScroll();
    hookRenders();
    paintChatListAvatars();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(boot, 500);
  setTimeout(boot, 1500);
})();
</script>


<script>
/* Chat peer profile + block enforcement */
(function () {
  function afterOpenChat() {
    try {
      const chat = (chats || []).find(c => String(c.id) === String(activeChatId));
      if (typeof updateChatBlockedUI === 'function') updateChatBlockedUI(chat);
    } catch (_) {}
  }

  // Wrap openChat
  function hookOpenChat() {
    if (typeof openChat !== 'function' || openChat.__blockHook) return;
    const orig = openChat;
    const wrapped = function () {
      const r = orig.apply(this, arguments);
      setTimeout(afterOpenChat, 30);
      setTimeout(afterOpenChat, 120);
      return r;
    };
    wrapped.__blockHook = true;
    try { openChat = wrapped; window.openChat = wrapped; } catch (_) {}
  }

  // Blocked user cannot view our profile (when opening our profile from their identity is not local);
  // When we view a blocked user's profile, allow view but show banner + block/unblock.
  function enhanceViewProfile() {
    if (typeof openViewProfile !== 'function' || openViewProfile.__blockHook) return;
    const orig = openViewProfile;
    const wrapped = function (name) {
      const r = orig.apply(this, arguments);
      setTimeout(() => {
        try {
          const n = String(name || '').trim();
          const blocked = typeof isBlockedName === 'function' && isBlockedName(n);
          const panel = document.getElementById('viewProfilePanel');
          if (!panel) return;
          let bar = document.getElementById('viewProfileBlockBar');
          if (!bar) {
            bar = document.createElement('div');
            bar.id = 'viewProfileBlockBar';
            bar.style.cssText = 'padding:12px 16px;display:flex;gap:8px;flex-wrap:wrap;justify-content:center';
            const body = panel.querySelector('.panel-body') || panel;
            body.insertBefore(bar, body.firstChild);
          }
          bar.innerHTML = '';
          const chat = (chats || []).find(c => String(c.name) === n || String(c.peerId) === n);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = blocked ? 'btn btn-text' : 'btn btn-filled';
          btn.style.color = blocked ? '' : '';
          if (!blocked) btn.style.background = 'var(--md-sys-color-error)';
          btn.textContent = blocked ? 'Разблокировать' : 'Заблокировать';
          btn.onclick = () => {
            if (chat) {
              if (blocked) unblockChatPeer(chat);
              else {
                if (!confirm('Заблокировать «' + n + '»?\\nНе сможет писать вам и смотреть ваш профиль.')) return;
                blockChatPeer(chat);
              }
            } else {
              if (blocked) {
                blacklist = (blacklist || []).filter(b => String(b).toLowerCase() !== n.toLowerCase());
                saveData();
                toast('Разблокирован');
              } else {
                if (!confirm('Заблокировать «' + n + '»?')) return;
                if (!isBlockedName(n)) blacklist.push(n);
                saveData();
                toast('Заблокирован');
              }
              try { renderBlacklist(); } catch (_) {}
              try { renderChatList(); } catch (_) {}
            }
            enhanceViewProfileRefresh(n);
          };
          bar.appendChild(btn);
          if (blocked) {
            const note = document.createElement('div');
            note.style.cssText = 'width:100%;text-align:center;font-size:12px;color:var(--md-sys-color-error);margin-top:4px';
            note.textContent = 'В чёрном списке · не может писать и видеть ваш профиль';
            bar.appendChild(note);
          }
        } catch (e) { console.warn(e); }
      }, 80);
      return r;
    };
    wrapped.__blockHook = true;
    try { openViewProfile = wrapped; window.openViewProfile = wrapped; } catch (_) {}
  }
  function enhanceViewProfileRefresh(n) {
    try { openViewProfile(n); } catch (_) {}
  }

  // File attach blocked
  function hookAttach() {
    const input = document.getElementById('fileInput');
    if (!input || input.__blockHook) return;
    input.__blockHook = true;
    input.addEventListener('change', function (e) {
      try {
        const chat = (chats || []).find(c => String(c.id) === String(activeChatId));
        if (chat && isChatBlocked(chat)) {
          e.stopImmediatePropagation();
          e.target.value = '';
          toast('Пользователь заблокирован');
        }
      } catch (_) {}
    }, true);
  }

  function boot() {
    hookOpenChat();
    enhanceViewProfile();
    hookAttach();
    afterOpenChat();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(boot, 600);
  setTimeout(boot, 1600);
})();
</script>


<script>
/* E2E double-encryption notice in chats */
(function () {
  const KEY = 'alpine_e2e_banner_hidden_v1';

  function isHidden() {
    try { return localStorage.getItem(KEY) === '1'; } catch (_) { return false; }
  }
  function hideForever() {
    try { localStorage.setItem(KEY, '1'); } catch (_) {}
    const el = document.getElementById('e2eBanner');
    if (el) el.classList.remove('show');
  }
  function updateE2EBanner() {
    const el = document.getElementById('e2eBanner');
