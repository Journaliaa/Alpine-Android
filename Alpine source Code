<script>
/* ===== Alpine Bottom Nav + Circles ===== */
(function () {
  function toastSafe(m) { try { if (typeof toast === 'function') toast(m); } catch (_) {} }

  function getCircleMembers() {
    try { return JSON.parse(localStorage.getItem('alpine_circle_v1') || '[]'); } catch (_) { return []; }
  }
  function setCircleMembers(list) {
    try { localStorage.setItem('alpine_circle_v1', JSON.stringify(list || [])); } catch (_) {}
  }
  window.getCircleMembers = getCircleMembers;

  function setBottomNavActive(id) {
    document.querySelectorAll('#alpineBottomNav button').forEach(b => {
      b.classList.toggle('active', b.getAttribute('data-nav') === id);
    });
  }

  function openMessagesNav() {
    try { closeDrawer(); } catch (_) {}
    try {
      document.getElementById('wallPage')?.classList.remove('show');
      document.getElementById('musicPage')?.classList.remove('show');
      document.getElementById('communityPage')?.classList.remove('show');
      document.getElementById('pluginsPage')?.classList.remove('show');
      document.querySelector('.app')?.classList.remove('wall-mode');
      document.body.classList.remove('wall-mode', 'chat-conversation-open');
      document.documentElement.classList.remove('wall-mode');
    } catch (_) {}
    try { if (typeof closeWallPage === 'function') closeWallPage(); } catch (_) {}

    // Show chat LIST, not empty black panel
    const side = document.getElementById('sidebar');
    if (side) {
      side.classList.remove('hidden');
      side.setAttribute('style', 'display:flex!important;visibility:visible!important;opacity:1!important;transform:none!important;pointer-events:auto!important;position:relative!important;width:100%!important;max-width:100%!important;min-height:60dvh!important;z-index:10!important;');
    }
    const ac = document.getElementById('activeChat');
    if (ac) {
      ac.classList.remove('is-chat-open');
      ac.style.display = 'none';
    }
    const es = document.getElementById('emptyState');
    if (es) {
      es.style.display = 'none';
      es.classList.remove('is-empty-visible');
    }
    try {
      if (typeof activeChatId !== 'undefined') activeChatId = null;
    } catch (_) {}
    try {
      if (typeof renderChatList === 'function') {
        renderChatList(document.getElementById('searchInput')?.value || '');
      }
    } catch (e) { console.warn(e); }
    setBottomNavActive('messages');
    document.title = 'Messages · Alpine';
  }

  function openHomeNav() {
    try {
      if (typeof openWallPage === 'function') openWallPage();
      else {
        document.getElementById('wallPage')?.classList.add('show');
        document.querySelector('.app')?.classList.add('wall-mode');
      }
    } catch (_) {}
    setBottomNavActive('home');
  }

  function openSavedNav() {
    try {
      if (typeof openSavedPanel === 'function') openSavedPanel('posts');
      else if (typeof openBookmarksPanel === 'function') openBookmarksPanel();
    } catch (_) {}
    setBottomNavActive('saved');
  }

  function openProfileNav() {
    try {
      if (typeof openProfile === 'function') openProfile();
      else document.getElementById('profilePanel')?.classList.add('show');
    } catch (_) {}
    setBottomNavActive('profile');
  }

  window.openMessagesNav = openMessagesNav;

  // Sync visibility into createPost via publish click
  function bindVisibility() {
    const sel = document.getElementById('postVisibilitySelect');
    if (sel) {
      sel.addEventListener('change', () => {
        window._postVisibility = sel.value || 'everyone';
        const icon = sel.previousElementSibling;
        // update icon in row
        const row = sel.closest('.post-visibility-row');
        const ic = row && row.querySelector('.material-icons-round');
        if (ic) {
          ic.textContent = sel.value === 'circle' ? 'group' : sel.value === 'only_me' ? 'lock' : 'public';
        }
      });
      window._postVisibility = sel.value || 'everyone';
    }
    // intercept post button to pass visibility in mediaExtra if needed
    const btn = document.getElementById('globalWallPostBtn');
    if (btn && !btn.__visHook) {
      btn.__visHook = true;
      btn.addEventListener('click', () => {
        const v = document.getElementById('postVisibilitySelect')?.value || 'everyone';
        window._postVisibility = v;
      }, true);
    }
  }

  // Patch createPost to read select at call time
  function patchCreatePostVis() {
    if (typeof createPost !== 'function' || createPost.__visPatched) return;
    const orig = createPost;
    window.createPost = function (text, imageData, quoteOf, mediaExtra) {
      mediaExtra = mediaExtra || {};
      if (!mediaExtra.visibility) {
        mediaExtra.visibility = (document.getElementById('postVisibilitySelect')?.value)
          || window._postVisibility || 'everyone';
      }
      const post = orig.call(this, text, imageData, quoteOf, mediaExtra);
      return post;
    };
    window.createPost.__visPatched = true;
  }

  // Badge on posts
  function enhanceCircleBadges(root) {
    (root || document).querySelectorAll('.wall-post[data-post-id]').forEach(el => {
      if (el.querySelector('.circle-badge')) return;
      const id = el.getAttribute('data-post-id');
      const p = (typeof posts !== 'undefined' ? posts : []).find(x => String(x.id) === String(id));
      if (!p) return;
      const vis = p.visibility || (p.circleOnly ? 'circle' : 'everyone');
      if (vis === 'everyone') return;
      const badge = document.createElement('div');
      badge.className = 'circle-badge';
      badge.innerHTML = vis === 'only_me'
        ? '<span class="material-icons-round" style="font-size:14px">lock</span> Only me'
        : '<span class="material-icons-round" style="font-size:14px">group</span> Close friends';
      const header = el.querySelector('.wall-post-header');
      if (header) header.after(badge);
      else el.insertBefore(badge, el.firstChild);
    });
  }

  function patchBindPostActions() {
    if (typeof bindPostActions !== 'function' || bindPostActions.__circleBadge) return;
    const orig = bindPostActions;
    window.bindPostActions = function (root) {
      const r = orig.apply(this, arguments);
      try { enhanceCircleBadges(root); } catch (_) {}
      return r;
    };
    window.bindPostActions.__circleBadge = true;
  }

  function renderCircleList() {
    const list = document.getElementById('circleMembersList');
    if (!list) return;
    const members = getCircleMembers();
    if (!members.length) {
      list.innerHTML = '<p class="setting-sub">No one yet. Add people who can see Close friends posts.</p>';
      return;
    }
    list.innerHTML = members.map((name, i) => `
      <div class="circle-member">
        <span class="material-icons-round">person</span>
        <strong>${String(name).replace(/</g,'&lt;')}</strong>
        <button type="button" class="btn btn-text" data-circle-remove="${i}">Remove</button>
      </div>
    `).join('');
    list.querySelectorAll('[data-circle-remove]').forEach(btn => {
      btn.onclick = () => {
        const i = Number(btn.getAttribute('data-circle-remove'));
        const m = getCircleMembers();
        m.splice(i, 1);
        setCircleMembers(m);
        renderCircleList();
        try { if (typeof renderGlobalWall === 'function') renderGlobalWall(); } catch (_) {}
      };
    });
  }

  function openCirclesSheet() {
    document.getElementById('circlesSheet')?.classList.add('show');
    renderCircleList();
  }
  function closeCirclesSheet() {
    document.getElementById('circlesSheet')?.classList.remove('show');
  }

  function boot() {
    document.body.classList.add('has-bottom-nav');
    // Ensure Settings not in bottom nav
