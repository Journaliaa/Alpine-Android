      background: var(--md-sys-color-surface-container);
      overflow: hidden;
    }
    .community-meme img {
      display: block; width: 100%; height: auto; max-height: 320px; object-fit: cover;
    }
    .community-meme-caption {
      padding: 12px 14px; font-size: 14px; font-weight: 600;
