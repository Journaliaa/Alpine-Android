    document.querySelectorAll('.post-visibility-row, #alpineBottomNav [data-nav="settings"]').forEach(el => el.remove());
  }

  function openMessagesFixed() {
    try { if (typeof closeDrawer === 'function') closeDrawer(); } catch (_) {}
