            sw.classList.add('on');
            sw.setAttribute('aria-checked', 'true');
          }
        } else {
          const ok = await verify2FAInteractive();
          if (!ok) return;
          localStorage.removeItem('alpine_2fa_enabled');
          localStorage.removeItem('alpine_2fa_hash');
          localStorage.removeItem('alpine_2fa_backups');
          window.twoFactorEnabled = false;
          sw.classList.remove('on');
          sw.setAttribute('aria-checked', 'false');
