    // ===== Real HTTP relays (browser cannot do SOCKS; we use public HTTPS relays) =====
    const PROXY_RELAYS = {
      allorigins: { id: 'allorigins', wrap: (url) => 'https://api.allorigins.win/raw?url=' + encodeURIComponent(url) },
      corsproxy: { id: 'corsproxy', wrap: (url) => 'https://corsproxy.io/?' + encodeURIComponent(url) },
      codetabs: { id: 'codetabs', wrap: (url) => 'https://api.codetabs.com/v1/proxy?quest=' + encodeURIComponent(url) },
      thingproxy: { id: 'thingproxy', wrap: (url) => 'https://thingproxy.freeboard.io/fetch/' + url },
      // запасной: jsonp-like через allorigins get
      alloriginsGet: { id: 'alloriginsGet', wrap: (url) => 'https://api.allorigins.win/get?url=' + encodeURIComponent(url) }
    };
    function getActiveRelay() {
      const id = (proxyConfig && proxyConfig.relay) || activeRelayId || 'allorigins';
      return PROXY_RELAYS[id] || PROXY_RELAYS.allorigins;
    }
    async function proxiedFetch(url, options) {
      options = options || {};
      if (!proxyEnabled || !proxyConfig.connected) {
        return fetch(url, Object.assign({}, options, { cache: options.cache || 'no-store' }));
      }
      const relay = getActiveRelay();
      const r = await fetch(relay.wrap(url), Object.assign({}, options, { cache: 'no-store' }));
      if (!r.ok) throw new Error('relay HTTP ' + r.status);
      return r;
    }
    async function fetchJsonViaRelay(url, relayId) {
      const relay = PROXY_RELAYS[relayId] || getActiveRelay();
      const t0 = performance.now();
      const r = await fetch(relay.wrap(url), { cache: 'no-store' });
      const ms = Math.round(performance.now() - t0);
      if (!r.ok) throw new Error(relay.id + ' status ' + r.status);
      const text = await r.text();
      let data;
      try { data = JSON.parse(text); } catch (e) { throw new Error(relay.id + ' bad JSON'); }
      // allorigins /get wraps as { contents: "..." }
      if (data && typeof data.contents === 'string') {
        try { data = JSON.parse(data.contents); } catch (e2) { data = { raw: data.contents }; }
      }
      return { data: data, ms: ms, relayId: relay.id };
    }
    async function probeExitIp(relayId) {
      const endpoints = ['https://ipwho.is/', 'https://api.ipify.org?format=json', 'https://ipapi.co/json/'];
      let lastErr = null;
      for (let i = 0; i < endpoints.length; i++) {
        const ep = endpoints[i];
        try {
          const res = await fetchJsonViaRelay(ep, relayId);
          const data = res.data;
          let ip = data.ip || data.query || '';
          let country = data.country_name || (typeof data.country === 'string' && data.country.length > 2 ? data.country : '') || '';
          let code = (data.country_code || data.countryCode || '').toString();
          if (!code && typeof data.country === 'string' && data.country.length === 2) code = data.country;
          let city = data.city || '';
          if (!ip) throw new Error('no ip');
          if (!code && ip) {
            try {
              const extra = await fetchJsonViaRelay('https://ipwho.is/' + ip, relayId);
              country = extra.data.country || country;
              code = (extra.data.country_code || '').toString() || code;
              city = extra.data.city || city;
            } catch (e2) {}
          }
          return {
            ip: ip,
            country: country || '—',
            country_code: (code || '').toUpperCase(),
            city: city,
            flag: code ? countryCodeToFlag(code) : '🌐',
            ping: res.ms,
            relayId: res.relayId
          };
        } catch (e) {
          lastErr = e;
        }
      }
      throw lastErr || new Error('probe failed');
    }

