  // ---- Media grid on profile media tab ----
  function patchProfileMediaGrid() {
    if (typeof renderProfileWall !== 'function' || renderProfileWall.__grid) return;
    const orig = renderProfileWall;
    window.renderProfileWall = function () {
      const tab = (typeof profileTab !== 'undefined') ? profileTab : 'threads';
      if (tab === 'media') {
        const feed = document.getElementById('profileWallFeed');
        if (!feed) return orig.apply(this, arguments);
        const mine = (typeof filterPostsByProfileTab === 'function')
          ? filterPostsByProfileTab(postsArr(), 'media', profile && profile.name, profile && profile.username)
          : postsArr().filter(p => p.image || (p.images && p.images.length) || p.video);
        // pinned first for threads handled below
        if (!mine.length) {
          feed.innerHTML = '<div class="wall-empty">No media yet</div>';
          return;
        }
        feed.innerHTML = '<div class="profile-media-grid">' + mine.map(p => {
          const src = (p.images && p.images[0]) || p.image || '';
          if (p.video && !src) {
            return `<button type="button" data-open-thread="${p.id}"><video src="${p.video}" muted playsinline></video></button>`;
          }
          return `<button type="button" data-open-thread="${p.id}"><img src="${src}" alt=""></button>`;
        }).join('') + '</div>';
        feed.querySelectorAll('[data-open-thread]').forEach(btn => {
          btn.onclick = () => openThread(btn.getAttribute('data-open-thread'));
        });
        return;
      }
      // default path with pinned post on threads
      const r = orig.apply(this, arguments);
      try {
        if (tab === 'threads' || !tab) {
          const feed = document.getElementById('profileWallFeed');
          const pinId = (typeof pinnedPostId !== 'undefined') ? pinnedPostId : window.pinnedPostId;
          if (feed && pinId && typeof renderPostHtml === 'function') {
            const pin = postsArr().find(x => String(x.id) === String(pinId));
            if (pin && !feed.querySelector('.pinned-post-wrap')) {
              const wrap = document.createElement('div');
              wrap.className = 'pinned-post-wrap';
              wrap.innerHTML = `<div class="pinned-label"><span class="material-icons-round">push_pin</span> Pinned</div>` + renderPostHtml(pin);
              feed.insertBefore(wrap, feed.firstChild);
              try { bindPostActions(wrap); } catch (_) {}
              enhancePostText(wrap);
              bindCarousels(wrap);
            }
          }
        }
      } catch (_) {}
      return r;
    };
    window.renderProfileWall.__grid = true;
  }

  // ---- Drafts autosave ----
  function bindDrafts() {
    const ta = document.getElementById('globalWallInput');
    if (!ta || ta.__draftBound) return;
    ta.__draftBound = true;
    try {
      const saved = localStorage.getItem('alpine_composer_draft');
      if (saved && !ta.value) ta.value = saved;
    } catch (_) {}
    ta.addEventListener('input', () => {
      clearTimeout(draftTimer);
      draftTimer = setTimeout(() => {
        try { localStorage.setItem('alpine_composer_draft', ta.value || ''); } catch (_) {}
        updateCharCount(ta);
        suggestMentions(ta);
      }, 200);
      updateCharCount(ta);
      suggestMentions(ta);
    });
    // clear draft on successful post
    document.getElementById('globalWallPostBtn')?.addEventListener('click', () => {
      setTimeout(() => {
        if (!(ta.value || '').trim()) {
          try { localStorage.removeItem('alpine_composer_draft'); } catch (_) {}
        }
      }, 500);
    });
    updateCharCount(ta);
  }

  function updateCharCount(ta) {
    const el = document.getElementById('globalWallCharCount');
    if (!el || !ta) return;
    const left = CHAR_LIMIT - (ta.value || '').length;
    el.textContent = String(left);
    el.classList.toggle('warn', left <= 50 && left >= 0);
    el.classList.toggle('over', left < 0);
    const btn = document.getElementById('globalWallPostBtn');
    if (btn) {
      const hasMedia = (typeof globalWallImagesDraft !== 'undefined' && globalWallImagesDraft.length) ||
        (typeof globalWallVideoDraft !== 'undefined' && globalWallVideoDraft);
      btn.disabled = left < 0 || (!(ta.value || '').trim() && !hasMedia && !window._quoteDraft);
    }
  }

  // ---- @ and # suggestions ----
  function suggestMentions(ta) {
    const box = document.getElementById('composerSuggest');
    if (!box || !ta) return;
    const val = ta.value || '';
    const pos = ta.selectionStart || val.length;
    const left = val.slice(0, pos);
    const mAt = left.match(/@([\w.]{0,24})$/);
    const mHash = left.match(/#([\w]{0,32})$/);
    box.innerHTML = '';
    box.classList.remove('show');
    let items = [];
    if (mAt) {
      const q = mAt[1].toLowerCase();
      const names = new Set();
      postsArr().forEach(p => { if (p.authorName) names.add(p.authorName); if (p.authorUsername) names.add(String(p.authorUsername).replace(/^@/, '')); });
      try { (typeof following !== 'undefined' ? following : []).forEach(x => names.add(x.name || x)); } catch (_) {}
      items = Array.from(names).filter(n => !q || String(n).toLowerCase().includes(q)).slice(0, 6).map(n => ({ type: 'at', value: String(n).replace(/\s+/g, '') }));
    } else if (mHash) {
      const q = mHash[1].toLowerCase();
      const tags = new Set();
      postsArr().forEach(p => {
        const t = p.text || '';
        (t.match(/#\w+/g) || []).forEach(h => tags.add(h.slice(1)));
      });
      items = Array.from(tags).filter(t => !q || t.toLowerCase().includes(q)).slice(0, 6).map(t => ({ type: 'hash', value: t }));
    }
    if (!items.length) return;
    items.forEach(it => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = (it.type === 'at' ? '@' : '#') + it.value;
      b.onclick = () => {
        const pre = left.replace(it.type === 'at' ? /@[\w.]*$/ : /#[\w]*$/, (it.type === 'at' ? '@' : '#') + it.value + ' ');
        ta.value = pre + val.slice(pos);
        box.classList.remove('show');
        ta.focus();
        updateCharCount(ta);
        try { localStorage.setItem('alpine_composer_draft', ta.value); } catch (_) {}
      };
      box.appendChild(b);
    });
    // position under composer
    const composer = document.getElementById('globalWallComposer') || ta.parentElement;
    if (composer) {
      const r = composer.getBoundingClientRect();
      box.style.position = 'fixed';
      box.style.left = Math.max(8, r.left) + 'px';
      box.style.width = Math.min(r.width, window.innerWidth - 16) + 'px';
      box.style.top = (r.bottom - 4) + 'px';
    }
    box.classList.add('show');
  }

  // ---- Pull to refresh ----
  function bindPtr() {
    const feed = document.getElementById('globalWallFeed');
    const ptr = document.getElementById('wallPtr');
    if (!feed || !ptr || feed.__ptr) return;
    feed.__ptr = true;
    let startY = 0, pulling = false;
    feed.addEventListener('touchstart', e => {
      if (feed.scrollTop <= 0 && e.touches[0]) {
        startY = e.touches[0].clientY;
        pulling = true;
      }
    }, { passive: true });
    feed.addEventListener('touchmove', e => {
      if (!pulling || !e.touches[0]) return;
      const dy = e.touches[0].clientY - startY;
      if (dy > 60) ptr.classList.add('active');
      else ptr.classList.remove('active');
    }, { passive: true });
    feed.addEventListener('touchend', () => {
      if (!pulling) return;
      pulling = false;
      if (ptr.classList.contains('active')) {
        ptr.textContent = 'Refreshing…';
        setTimeout(() => {
          try { if (typeof renderGlobalWall === 'function') renderGlobalWall(); } catch (_) {}
          ptr.classList.remove('active');
          ptr.textContent = 'Refreshing…';
          toastSafe('Updated');
        }, 400);
      }
    });
  }

  // ---- Skeletons ----
  function showFeedSkeleton() {
    const feed = document.getElementById('globalWallPosts');
    if (!feed) return;
    feed.innerHTML = `<div class="feed-skeleton">${[0,1,2].map(() =>
      `<div class="sk-row"><div class="sk-av"></div><div class="sk-lines"><div class="sk-line"></div><div class="sk-line short"></div><div class="sk-line"></div></div></div>`
    ).join('')}</div>`;
  }

  // ---- Swipe back thread / profile ----
  function bindSwipeBack() {
    const ov = document.getElementById('threadOverlay');
    if (ov && !ov.__swipe) {
      ov.__swipe = true;
      let x0 = 0, y0 = 0;
      ov.addEventListener('touchstart', e => {
        if (e.touches[0] && e.touches[0].clientX < 24) {
          x0 = e.touches[0].clientX; y0 = e.touches[0].clientY;
        } else x0 = 0;
      }, { passive: true });
      ov.addEventListener('touchend', e => {
        if (!x0 || !e.changedTouches[0]) return;
        const dx = e.changedTouches[0].clientX - x0;
        const dy = Math.abs(e.changedTouches[0].clientY - y0);
        if (dx > 80 && dy < 60) closeThread();
        x0 = 0;
      });
    }
    // profile panels
    ['profilePanel', 'viewProfilePanel'].forEach(id => {
      const panel = document.getElementById(id);
      if (!panel || panel.__swipe) return;
      panel.__swipe = true;
      let x0 = 0, y0 = 0;
      panel.addEventListener('touchstart', e => {
        if (e.touches[0] && e.touches[0].clientX < 28) {
          x0 = e.touches[0].clientX; y0 = e.touches[0].clientY;
        } else x0 = 0;
      }, { passive: true });
      panel.addEventListener('touchend', e => {
        if (!x0 || !e.changedTouches[0]) return;
        const dx = e.changedTouches[0].clientX - x0;
        const dy = Math.abs(e.changedTouches[0].clientY - y0);
        if (dx > 80 && dy < 60) {
          try {
            if (id === 'profilePanel') document.getElementById('closeProfileBtn')?.click();
            else document.getElementById('closeViewProfileBtn')?.click();
          } catch (_) {}
        }
        x0 = 0;
      });
    });
  }

  // ---- Click post → thread (not on buttons) ----
  function bindOpenThreadClicks() {
    document.addEventListener('click', e => {
      if (e.target.closest('button, a, .wall-action-btn, .wall-post-more, [data-post-menu], [data-like-post], [data-open-author], input, textarea')) return;
      const post = e.target.closest('.wall-post[data-post-id]');
