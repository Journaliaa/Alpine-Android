    async function captureWallCamera() {
      const video = document.getElementById('wallCameraVideo');
      const canvas = document.getElementById('wallCameraCanvas');
      if (!video || !canvas || !wallCameraActive) return;
      const w = video.videoWidth || 720;
      const h = video.videoHeight || 720;
      if (!w || !h) { toast('Camera not ready'); return; }
      // square crop center
      const side = Math.min(w, h);
      const sx = Math.floor((w - side) / 2);
      const sy = Math.floor((h - side) / 2);
      const out = Math.min(side, 1080);
      canvas.width = out;
      canvas.height = out;
      const ctx = canvas.getContext('2d');
      // mirror selfie capture so result matches preview
      if (wallCameraFacing === 'user') {
        ctx.translate(out, 0);
        ctx.scale(-1, 1);
      }
      ctx.drawImage(video, sx, sy, side, side, 0, 0, out, out);
      let dataUrl;
      try {
        dataUrl = canvas.toDataURL('image/jpeg', 0.85);
      } catch (e) {
        toast('Could not capture photo');
        return;
      }
      await stopWallCamera();
      // inject into drafts
      try {
        if (wallMediaTarget === 'profile') {
          if (typeof wallImageDraft !== 'undefined') {
            wallImageDraft = dataUrl;
          } else {
            window.wallImageDraft = dataUrl;
          }
          const prev = document.getElementById('profileWallImgPreview');
          if (prev) {
            prev.src = dataUrl;
            prev.classList.add('show');
            prev.style.display = '';
          }
          toast('Photo ready');
        } else {
          // global wall collage draft
          if (typeof globalWallImagesDraft === 'undefined') {
            window.globalWallImagesDraft = [];
          }
          if (!Array.isArray(globalWallImagesDraft)) globalWallImagesDraft = [];
          if (globalWallImagesDraft.length >= 5) {
            toast('Максимум 5 фото в коллаже');
            return;
          }
          globalWallImagesDraft.push(dataUrl);
          try {
            if (typeof renderGlobalWallMediaDraft === 'function') renderGlobalWallMediaDraft();
          } catch (_) {}
          const prev = document.getElementById('globalWallImgPreview');
          if (prev && globalWallImagesDraft.length === 1) {
            prev.src = dataUrl;
            prev.style.display = 'block';
          }
          toast('Photo added');
        }
      } catch (e) {
        console.warn(e);
        toast('Could not attach photo');
      }
    }

