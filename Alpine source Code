  // ---------- Virtualized feed ----------
  const VIRT = { rowEstimate: 220, buffer: 6, enabled: true };

  function virtualizeFeed(container, items, renderOne) {
    if (!container) return;
    if (!VIRT.enabled || items.length < 40) {
      container.innerHTML = items.map(renderOne).join('');
      try { if (typeof bindPostActions === 'function') bindPostActions(container); } catch (_) {}
      return;
    }
    const scrollParent = container.closest('.wall-feed') || container.parentElement || container;
    let mounted = { start: 0, end: 0 };

    function renderWindow() {
      const scrollTop = scrollParent.scrollTop || 0;
      const viewH = scrollParent.clientHeight || 600;
      const start = Math.max(0, Math.floor(scrollTop / VIRT.rowEstimate) - VIRT.buffer);
      const end = Math.min(items.length, Math.ceil((scrollTop + viewH) / VIRT.rowEstimate) + VIRT.buffer);
      if (start === mounted.start && end === mounted.end && container.querySelector('.wall-post')) return;
      mounted = { start, end };
      const topH = start * VIRT.rowEstimate;
      const bottomH = Math.max(0, (items.length - end) * VIRT.rowEstimate);
      const slice = items.slice(start, end);
      container.innerHTML =
        `<div class="virt-spacer-top" style="height:${topH}px"></div>` +
        slice.map(renderOne).join('') +
        `<div class="virt-spacer-bottom" style="height:${bottomH}px"></div>`;
      try { if (typeof bindPostActions === 'function') bindPostActions(container); } catch (_) {}
    }

    container.classList.add('virt-host');
    container.style.minHeight = (items.length * VIRT.rowEstimate) + 'px';
    if (!scrollParent.__virtBound) {
      scrollParent.__virtBound = true;
      let ticking = false;
      scrollParent.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { ticking = false; try { scrollParent.__virtRender && scrollParent.__virtRender(); } catch (_) {} });
      }, { passive: true });
    }
    scrollParent.__virtRender = renderWindow;
    scrollParent.__virtItems = items;
