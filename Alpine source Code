<script>
/* ===== Alpine Threads/X/IG UX module ===== */
(function () {
  const CHAR_LIMIT = 500;
  let activeThreadId = null;
  let draftTimer = null;

  function toastSafe(m) { try { if (typeof toast === 'function') toast(m); } catch (_) {} }
  function postsArr() { return (typeof posts !== 'undefined' && Array.isArray(posts)) ? posts : []; }

  // ---- Carousel media ----
  function renderCarouselHtml(imgs) {
    if (!imgs || !imgs.length) return '';
    if (imgs.length === 1) {
      return `<img class="wall-post-image" src="${imgs[0]}" alt="">`;
    }
    const slides = imgs.map(src => `<img src="${src}" alt="">`).join('');
    const dots = imgs.map((_, i) => `<span class="${i === 0 ? 'on' : ''}"></span>`).join('');
    return `<div class="post-carousel" data-carousel>
      <div class="post-carousel-track">${slides}</div>
      <div class="post-carousel-count">1/${imgs.length}</div>
      <div class="post-carousel-dots">${dots}</div>
    </div>`;
  }

  function bindCarousels(root) {
    (root || document).querySelectorAll('[data-carousel]').forEach(car => {
      if (car.__bound) return;
      car.__bound = true;
      const track = car.querySelector('.post-carousel-track');
      const dots = car.querySelectorAll('.post-carousel-dots span');
      const count = car.querySelector('.post-carousel-count');
      const n = track ? track.children.length : 0;
      let idx = 0;
      let startX = 0, dx = 0, dragging = false;
      function go(i) {
        idx = Math.max(0, Math.min(n - 1, i));
        if (track) track.style.transform = `translateX(${-idx * 100}%)`;
        dots.forEach((d, j) => d.classList.toggle('on', j === idx));
        if (count) count.textContent = (idx + 1) + '/' + n;
      }
      car.addEventListener('touchstart', e => {
        if (!e.touches[0]) return;
        dragging = true; startX = e.touches[0].clientX; dx = 0;
      }, { passive: true });
      car.addEventListener('touchmove', e => {
        if (!dragging || !e.touches[0]) return;
        dx = e.touches[0].clientX - startX;
      }, { passive: true });
      car.addEventListener('touchend', () => {
        if (!dragging) return;
        dragging = false;
        if (dx < -40) go(idx + 1);
        else if (dx > 40) go(idx - 1);
        else go(idx);
        dx = 0;
      });
    });
  }

  // ---- Patch renderPostMediaHtml for carousel ----
  function patchMediaHtml() {
    if (typeof renderPostMediaHtml !== 'function' || renderPostMediaHtml.__carousel) return;
    const orig = renderPostMediaHtml;
    window.renderPostMediaHtml = function (p) {
      if (p && p.video) return orig(p);
      const imgs = (Array.isArray(p.images) && p.images.length) ? p.images.slice(0, 5) : (p.image ? [p.image] : []);
      if (imgs.length > 1) return renderCarouselHtml(imgs);
      return orig(p);
    };
    window.renderPostMediaHtml.__carousel = true;
  }

  // ---- Show more on long text ----
  function enhancePostText(root) {
    (root || document).querySelectorAll('.wall-post-text').forEach(el => {
      if (el.__moreBound) return;
      el.__moreBound = true;
      const text = el.textContent || '';
      if (text.length < 220 && (el.scrollHeight <= el.clientHeight + 4)) return;
      // measure
      requestAnimationFrame(() => {
        if (el.scrollHeight > 120 || text.length > 220) {
          el.classList.add('collapsed');
          if (!el.nextElementSibling || !el.nextElementSibling.classList.contains('wall-show-more')) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'wall-show-more';
            btn.textContent = 'Show more';
            btn.onclick = (e) => {
              e.stopPropagation();
              el.classList.remove('collapsed');
              btn.remove();
            };
            el.after(btn);
          }
        }
      });
    });
  }

  // ---- Thread view ----
  function openThread(postId) {
    const p = postsArr().find(x => String(x.id) === String(postId));
    if (!p) return;
    activeThreadId = p.id;
    const ov = document.getElementById('threadOverlay');
    const body = document.getElementById('threadBody');
    if (!ov || !body) return;
    const replies = (p.comments || []).slice().sort((a, b) => (a.time || 0) - (b.time || 0));
    let html = '';
    try {
      if (typeof renderPostHtml === 'function') {
        html += `<div class="thread-main">${renderPostHtml(p)}</div>`;
      }
    } catch (_) {}
    html += `<div class="thread-replies"><div class="thread-replies-title">Replies</div>`;
    if (!replies.length) {
      html += `<p class="thread-empty">Пока нет ответов — напишите первый</p>`;
    } else {
      const meName = (typeof profile !== 'undefined' && profile.name) || '';
      const byId = {};
      replies.forEach(c => { byId[c.id] = c; });
      const childrenOf = (pid) => replies
        .filter(c => c.replyTo != null && String(c.replyTo) === String(pid))
        .sort((a, b) => (a.time || 0) - (b.time || 0));
      const renderCmt = (cmt, depth) => {
        const av = cmt.authorPhoto
          ? `background:url(${cmt.authorPhoto}) center/cover no-repeat`
          : `background:${cmt.authorColor || '#DA291C'}`;
        const initials = (cmt.authorName || '?').slice(0, 1);
        const likes = cmt.likes || 0;
        const liked = !!cmt.liked;
        const canDel = (cmt.authorName === meName) || (p.authorName === meName);
        const parent = cmt.replyTo ? byId[cmt.replyTo] : null;
        const replyToLine = parent
          ? `<div class="thread-reply-to">↪ в ответ <b>${escapeHtmlSafe(parent.authorName || '')}</b></div>`
          : '';
        const pad = Math.min(depth, 6) * 18;
        let h = `<div class="wall-post wall-thread-comment${depth ? ' is-nested' : ''}" data-comment-id="${cmt.id}" data-parent-post="${p.id}" style="${depth ? 'margin-left:' + pad + 'px' : ''}">
          <div class="wall-post-header">
            <div class="wall-post-avatar" style="${av}">${cmt.authorPhoto ? '' : initials}</div>
            <div class="wall-post-meta">
              <strong>${escapeHtmlSafe(cmt.authorName || 'User')}</strong>
              <small>${cmt.time ? new Date(cmt.time).toLocaleString() : ''}</small>
            </div>
          </div>
          ${replyToLine}
          <div class="wall-post-text">${escapeHtmlSafe(cmt.text || '')}</div>
          <div class="wall-post-actions">
            <button type="button" class="wall-action-btn ${liked ? 'liked' : ''}" data-thread-like-cmt="${cmt.id}" data-post-id="${p.id}" title="Like">
              <span class="material-icons-round">${liked ? 'favorite' : 'favorite_border'}</span>
              <span class="tw-count">${likes || ''}</span>
            </button>
            <button type="button" class="wall-action-btn" data-thread-reply-cmt="${cmt.id}" data-post-id="${p.id}" data-reply-name="${escapeHtmlSafe(cmt.authorName || '')}" title="Reply">
              <span class="material-icons-round">chat_bubble_outline</span>
            </button>
            ${canDel ? `<button type="button" class="wall-action-btn" data-thread-del-cmt="${cmt.id}" data-post-id="${p.id}" title="Delete">
              <span class="material-icons-round">delete_outline</span>
            </button>` : ''}
          </div>
        </div>`;
        childrenOf(cmt.id).forEach(ch => { h += renderCmt(ch, depth + 1); });
        return h;
      };
      const tops = replies.filter(c => !c.replyTo || !byId[c.replyTo])
        .sort((a, b) => (a.time || 0) - (b.time || 0));
      tops.forEach(c => { html += renderCmt(c, 0); });
    }
    html += `</div>`;
    body.innerHTML = html;
    try { if (typeof bindPostActions === 'function') bindPostActions(body); } catch (_) {}
    enhancePostText(body);
    bindCarousels(body);
    bindThreadCommentActions(body, p.id);
    body.querySelectorAll('.thread-main .wall-post').forEach(el => { el.onclick = null; });
    ov.classList.add('show');
    ov.setAttribute('aria-hidden', 'false');
    body.scrollTop = 0;
  }

  function closeThread() {
    const ov = document.getElementById('threadOverlay');
    if (ov) {
      ov.classList.remove('show');
      ov.setAttribute('aria-hidden', 'true');
    }
    activeThreadId = null;
  }

  
  function bindThreadCommentActions(root, postId) {
    if (!root) return;
    root.querySelectorAll('[data-thread-like-cmt]').forEach(btn => {
      btn.onclick = (e) => {
        e.preventDefault(); e.stopPropagation();
        if (typeof ghostMode !== 'undefined' && ghostMode) { toastSafe('Ghost mode: read-only'); return; }
        const cid = btn.getAttribute('data-thread-like-cmt');
        const p = postsArr().find(x => String(x.id) === String(postId));
        if (!p || !p.comments) return;
        const cmt = p.comments.find(x => String(x.id) === String(cid));
        if (!cmt) return;
        cmt.liked = !cmt.liked;
        cmt.likes = Math.max(0, (cmt.likes || 0) + (cmt.liked ? 1 : -1));
        try { if (typeof saveData === 'function') saveData(); } catch (_) {}
        openThread(postId);
      };
    });
    root.querySelectorAll('[data-thread-reply-cmt]').forEach(btn => {
      btn.onclick = (e) => {
        e.preventDefault(); e.stopPropagation();
        const cid = btn.getAttribute('data-thread-reply-cmt');
        const p = postsArr().find(x => String(x.id) === String(postId));
        const cmt = p && (p.comments || []).find(x => String(x.id) === String(cid));
        const ta = document.getElementById('threadReplyInput');
        const hint = document.getElementById('threadReplyHint');
        if (ta) {
          const handle = cmt ? ('@' + String(cmt.authorName || '').replace(/\s+/g, '')) : '';
          ta.value = handle ? (handle + ' ') : '';
          ta.focus();
          window._threadReplyTo = cid;
          if (hint) {
            hint.style.display = 'flex';
            hint.innerHTML = 'Ответ для <b>' + (cmt ? escapeHtmlSafe(cmt.authorName || '') : '') + '</b> <button type="button" id="threadReplyHintCancel" class="btn btn-text" style="min-height:28px;padding:0 8px">Отмена</button>';
            hint.querySelector('#threadReplyHintCancel')?.addEventListener('click', () => {
              window._threadReplyTo = null;
              hint.style.display = 'none';
              hint.innerHTML = '';
              if (ta) ta.value = '';
            });
          }
        }
      };
    });
    root.querySelectorAll('[data-thread-del-cmt]').forEach(btn => {
      btn.onclick = (e) => {
        e.preventDefault(); e.stopPropagation();
        if (typeof ghostMode !== 'undefined' && ghostMode) { toastSafe('Ghost mode: read-only'); return; }
        const cid = btn.getAttribute('data-thread-del-cmt');
        const p = postsArr().find(x => String(x.id) === String(postId));
        if (!p || !p.comments) return;
        if (!confirm('Delete this reply?')) return;
        p.comments = p.comments.filter(x => String(x.id) !== String(cid));
        try { if (typeof saveData === 'function') saveData(); } catch (_) {}
        openThread(postId);
        try { if (typeof renderGlobalWall === 'function') renderGlobalWall(); } catch (_) {}
        toastSafe('Reply deleted');
      };
    });
  }

  function escapeHtmlSafe(s) {
    if (typeof escapeHtml === 'function') return escapeHtml(s);
    return String(s || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  }

  function submitThreadReply() {
    if (typeof ghostMode !== 'undefined' && ghostMode) { toastSafe('Ghost mode: read-only'); return; }
    const p = postsArr().find(x => String(x.id) === String(activeThreadId));
    if (!p) return;
    const ta = document.getElementById('threadReplyInput');
    const text = (ta && ta.value || '').trim();
    if (!text) return;
    if (!p.comments) p.comments = [];
    p.comments.push({
      id: 'c_' + Date.now(),
      text: text.slice(0, CHAR_LIMIT),
      authorName: (typeof profile !== 'undefined' && profile.name) || 'You',
      authorUsername: (profile && profile.username) || '',
      authorColor: (profile && profile.color) || '#DA291C',
      authorPhoto: (profile && profile.photo) || '',
      time: Date.now(),
      replyTo: window._threadReplyTo || null,
      likes: 0,
      liked: false
    });
    window._threadReplyTo = null;
    try {
      const hint = document.getElementById('threadReplyHint');
      if (hint) { hint.style.display = 'none'; hint.innerHTML = ''; }
    } catch (_) {}
    try { if (typeof saveData === 'function') saveData(); } catch (_) {}
    if (ta) ta.value = '';
    openThread(p.id);
    try { if (typeof renderGlobalWall === 'function') renderGlobalWall(); } catch (_) {}
    toastSafe('Reply posted');
  }

  // ---- Quote post ----
  function quotePost(postId) {
    const p = postsArr().find(x => String(x.id) === String(postId));
    if (!p) return;
    window._quoteDraft = {
      id: p.id,
      authorName: p.authorName,
      authorUsername: p.authorUsername || p.authorId,
      text: p.text || '',
      image: p.image || (p.images && p.images[0]) || ''
    };
    // focus composer
    const ta = document.getElementById('globalWallInput');
    if (ta) {
      ta.focus();
      ta.placeholder = 'Add a comment to quote';
    }
    toastSafe('Quote attached — write and Post');
    try {
      document.getElementById('postMenuSheet')?.style && (document.getElementById('postMenuSheet').style.display = 'none');
    } catch (_) {}
  }

  // Patch post button to include quoteOf
  function patchPublishWithQuote() {
    const btn = document.getElementById('globalWallPostBtn');
    if (!btn || btn.__quotePatch) return;
    btn.__quotePatch = true;
    btn.addEventListener('click', () => {
      // runs in bubble; createPost called by main handler — inject quote via temporary
      if (window._quoteDraft && typeof createPost === 'function') {
        // main handler may already create post; hook createPost instead
      }
    }, true);
    if (typeof createPost === 'function' && !createPost.__quote) {
      const orig = createPost;
      window.createPost = function (text, imageData, quoteOf, mediaExtra) {
        const q = quoteOf || window._quoteDraft || null;
        const post = orig.call(this, text, imageData, q, mediaExtra);
        if (post && window._quoteDraft) {
          post.quoteOf = window._quoteDraft;
          window._quoteDraft = null;
          const ta = document.getElementById('globalWallInput');
          if (ta) ta.placeholder = "What's happening?";
          try { if (typeof saveData === 'function') saveData(); } catch (_) {}
        }
        return post;
      };
      window.createPost.__quote = true;
    }
